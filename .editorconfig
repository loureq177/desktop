root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{qml,js}]
indent_size = 4

[*.{sh,zsh,bash}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

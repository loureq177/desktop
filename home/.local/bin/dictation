#!/usr/bin/env bash
set -euo pipefail

RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PID_FILE="$RUN_DIR/dictation.pid"
STATE_FILE="$RUN_DIR/dictation"
LOCK_FILE="$RUN_DIR/dictation.lock"
AUDIO_RAW="$RUN_DIR/dictation_raw.wav"
AUDIO_CLEAN="$RUN_DIR/dictation_clean.wav"
UNMUTED="$RUN_DIR/dictation_unmuted"
MODEL="${XDG_DATA_HOME:-$HOME/.local/share}/parakeet/parakeet-tdt-0.6b-v3-onnx"
# The model stays loaded in it between recordings; next to the script, through stow's links.
SERVER="$(cd "$(dirname "$0")" && pwd)/../lib/dotfiles/dictation-model.py"

# onnx-asr's own Python (uv's tool environment), from its shebang.
asr_python() {
    sed -n '1s/^#!//p' "$(command -v onnx-asr)"
}

exec 200>"$LOCK_FILE"
flock -n 200 || exit 0

stop() {
    trap 'rm -f "$STATE_FILE"' EXIT
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        rm -f "$PID_FILE"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            kill -INT "$pid" 2>/dev/null || true
            for _ in $(seq 1 200); do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.01
            done
        fi
    fi
    if [[ -f "$UNMUTED" ]]; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 200>&- || true
        rm -f "$UNMUTED"
    fi

    if [[ ! -f "$AUDIO_RAW" ]] || [[ $(stat -c%s "$AUDIO_RAW" 2>/dev/null || echo 0) -lt 8000 ]]; then
        rm -f "$AUDIO_RAW" "$AUDIO_CLEAN"
        exit 0
    fi

    echo transcribing >"$STATE_FILE"

    sox "$AUDIO_RAW" -b 16 -e signed-integer "$AUDIO_CLEAN" highpass 80 norm -3.0 200>&- 2>/dev/null || cp "$AUDIO_RAW" "$AUDIO_CLEAN" 200>&-

    # The loaded model; the CLI loads its own (2 s more) when that one does not answer.
    # Nothing of a failed run is typed: it may have printed something else than the text.
    local rc=0
    TEXT=$("$(asr_python)" -I "$SERVER" ask "$AUDIO_CLEAN" 200>&- 2>/dev/null) ||
        TEXT=$(onnx-asr nemo-parakeet-tdt-0.6b-v3 -p "$MODEL" -q int8 "$AUDIO_CLEAN" 200>&- 2>/dev/null) || rc=$?
    if ((rc != 0)); then
        TEXT=""
        notify-send --app-name "Dictation" -i "dialog-warning" "Dictation" \
            "Transcription failed (onnx-asr exit $rc)." 200>&- 2>/dev/null || true
    fi
    TEXT="$(printf '%s' "$TEXT" | tr '\n\r' ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

    if [[ -n "$TEXT" ]]; then
        printf "%s " "$TEXT" | wl-copy 200>&- || true
        sleep 0.05
        wtype -M shift -k Insert -m shift 200>&- 2>/dev/null || true
    fi

    rm -f "$AUDIO_RAW" "$AUDIO_CLEAN"
}

start() {
    if [[ ! -s "$MODEL/encoder-model.int8.onnx" ]] || ! command -v onnx-asr >/dev/null; then
        notify-send --app-name "Dictation" -i "dialog-warning" "Dictation" \
            "onnx-asr or the speech model is missing (install.sh installs them)." 200>&- 2>/dev/null || true
        exit 1
    fi
    # A muted microphone is on while recording, muted again after.
    if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 200>&- && : >"$UNMUTED"
    fi
    rm -f "$PID_FILE" "$AUDIO_RAW" "$AUDIO_CLEAN"
    echo recording >"$STATE_FILE"
    pw-record --rate 16000 --channels 1 "$AUDIO_RAW" 200>&- >/dev/null 2>&1 &
    echo $! >"$PID_FILE"
    # The model loads while you speak; one loaded already stays.
    setsid -f "$(asr_python)" -I "$SERVER" serve 200>&- </dev/null >/dev/null 2>&1 || true
}

if [[ "${1:-}" == "stop" || -f "$PID_FILE" ]]; then
    stop
else
    start
fi

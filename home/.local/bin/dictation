#!/usr/bin/env bash
set -euo pipefail

RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
PID_FILE="$RUN_DIR/dictation.pid"
STATE_FILE="$RUN_DIR/dictation"
LOCK_FILE="$RUN_DIR/dictation.lock"
AUDIO_RAW="$RUN_DIR/dictation_raw.wav"
AUDIO_CLEAN="$RUN_DIR/dictation_clean.wav"
MODEL="${XDG_DATA_HOME:-$HOME/.local/share}/whisper/ggml-base.bin"

exec 200>"$LOCK_FILE"
flock -n 200 || exit 0

_hypr_layout="$(hyprctl getoption input:kb_layout 200>&- 2>/dev/null | awk -F'[ ,]' '/str:/ { for (i=1;i<=NF;i++) if ($i=="str:") { print $(i+1); exit } }' || true)"
LANG_CODE="$_hypr_layout"
[[ "$LANG_CODE" == "us" ]] && LANG_CODE="en"
[[ "$LANG_CODE" =~ ^[A-Za-z]{2}(-[A-Za-z]+)?$ ]] || LANG_CODE="pl"
LANG_CODE="${LANG_CODE:-pl}"

stop() {
    trap 'rm -f "$STATE_FILE"' EXIT
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        rm -f "$PID_FILE"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            kill -INT "$pid" 2>/dev/null || true
            for _ in $(seq 1 40); do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.05
            done
        fi
    fi

    if [[ ! -f "$AUDIO_RAW" ]] || [[ $(stat -c%s "$AUDIO_RAW" 2>/dev/null || echo 0) -lt 8000 ]]; then
        rm -f "$AUDIO_RAW" "$AUDIO_CLEAN"
        exit 0
    fi

    echo transcribing >"$STATE_FILE"

    sox "$AUDIO_RAW" "$AUDIO_CLEAN" highpass 80 norm -3.0 200>&- 2>/dev/null || cp "$AUDIO_RAW" "$AUDIO_CLEAN" 200>&-

    TEXT=$(whisper-cli -m "$MODEL" -t 6 -f "$AUDIO_CLEAN" --no-timestamps --no-prints -l "$LANG_CODE" 200>&- 2>/dev/null || true)
    TEXT="$(printf '%s' "$TEXT" | tr '\n\r' ' ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

    if [[ "$TEXT" =~ ^\[.*\]$ || "$TEXT" =~ ^\(.*\)$ ]]; then
        TEXT=""
    fi

    if [[ -n "$TEXT" ]]; then
        printf "%s " "$TEXT" | wl-copy 200>&- || true
        sleep 0.05
        wtype -M shift -k Insert -m shift 200>&- 2>/dev/null || true
    fi

    rm -f "$AUDIO_RAW" "$AUDIO_CLEAN"
}

start() {
    if [[ ! -s "$MODEL" ]]; then
        notify-send --app-name "Dictation" -i "dialog-warning" "Dictation" \
            "Speech model not found: $MODEL (install.sh downloads it)." 200>&- 2>/dev/null || true
        exit 1
    fi
    rm -f "$PID_FILE" "$AUDIO_RAW" "$AUDIO_CLEAN"
    echo recording >"$STATE_FILE"
    pw-record --rate 16000 --channels 1 "$AUDIO_RAW" 200>&- >/dev/null 2>&1 &
    echo $! >"$PID_FILE"
}

if [[ "${1:-}" == "stop" || -f "$PID_FILE" ]]; then
    stop
else
    start
fi

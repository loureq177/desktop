#!/usr/bin/env bash
# Volume control via wpctl with the quickshell OSD. GNOME-like sound feedback.
# Usage: volume output raise|lower|mute-toggle|mute|unmute
#        volume input mute-toggle|mute|unmute
set -euo pipefail

TARGET="${1:-output}"
ACTION="${2:-}"
if [[ -z "$ACTION" ]]; then
    echo "Usage: volume output raise|lower|mute-toggle|mute|unmute" >&2
    echo "       volume input mute-toggle|mute|unmute" >&2
    exit 2
fi

sound() {
    canberra-gtk-play -i "$1" >/dev/null 2>&1 &
}

_report() { # $1: SINK|SOURCE — push the current state to the OSD
    local line frac pct
    line="$(timeout 5 wpctl get-volume "@DEFAULT_${1}@" 2>/dev/null || true)"
    # wpctl prints a fraction ("Volume: 0.65"); the OSD wants percent.
    # Guard: empty/garbage line (PipeWire down, no default) must not
    # coerce to 0% silently — report nothing instead of a wrong 0.
    if [[ ! "$line" =~ Volume:[[:space:]]+([0-9]*\.?[0-9]+) ]]; then
        return 0
    fi
    frac="${BASH_REMATCH[1]}"
    # Round, do not truncate: printf "%d" on a binary float drops a percent
    # (0.29 * 100 is 28.999...), so the OSD lagged one step behind wpctl.
    pct="$(awk -v f="$frac" 'BEGIN { printf "%d", int(f * 100 + 0.5) }' || true)"
    [[ "$pct" =~ ^[0-9]+$ ]] || return 0
    if grep -qF '[MUTED]' <<<"$line"; then
        qs ipc call osd volume "$pct" true || true
    else
        qs ipc call osd volume "$pct" false || true
    fi
}

case "$TARGET" in
output)
    case "$ACTION" in
    raise) timeout 5 wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ || true ;;
    lower) timeout 5 wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- || true ;;
    mute-toggle) timeout 5 wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle || true ;;
    mute) timeout 5 wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 || true ;;
    unmute) timeout 5 wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 || true ;;
    *) echo "volume: unknown action '$ACTION'" >&2; exit 2 ;;
    esac
    _report SINK
    # Keep the QuickSettings slider in sync: it polls every 3s, so push a
    # refresh instead of letting it lag behind hardware keys.
    qs ipc call quicksettings refresh >/dev/null 2>&1 &
    # Muted speakers cannot play feedback; silence is the confirmation.
    if [[ "$ACTION" == mute* ]] && timeout 5 wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -qF '[MUTED]'; then
        exit 0
    fi
    sound audio-volume-change
    ;;
input)
    case "$ACTION" in
    mute-toggle) timeout 5 wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle || true ;;
    mute) timeout 5 wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 || true ;;
    unmute) timeout 5 wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 || true ;;
    *) echo "volume: unknown action '$ACTION'" >&2; exit 2 ;;
    esac
    if timeout 5 wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -qF '[MUTED]'; then
        qs ipc call osd mic true || true
    else
        qs ipc call osd mic false || true
    fi
    sound audio-volume-change
    ;;
*)
    echo "volume: unknown target '$TARGET' (want output|input)" >&2
    exit 2
    ;;
esac

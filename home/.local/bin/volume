#!/usr/bin/env bash
set -euo pipefail

TARGET="${1:-output}"
ACTION="${2:-}"
if [[ -z "$ACTION" ]]; then
    echo "Usage: volume output raise|lower|mute-toggle|mute|unmute" >&2
    echo "       volume input mute-toggle|mute|unmute" >&2
    exit 2
fi

SINK=@DEFAULT_AUDIO_SINK@
SOURCE=@DEFAULT_AUDIO_SOURCE@

sound() { canberra-gtk-play -i "$1" >/dev/null 2>&1 & }

set_mute() {
    case "$2" in
    mute-toggle) wpctl set-mute "$1" toggle ;;
    mute) wpctl set-mute "$1" 1 ;;
    unmute) wpctl set-mute "$1" 0 ;;
    *) echo "volume: unknown action '$2'" >&2; exit 2 ;;
    esac
}

case "$TARGET" in
output)
    case "$ACTION" in
    raise) wpctl set-volume -l 1.0 "$SINK" 5%+ ;;
    lower) wpctl set-volume "$SINK" 5%- ;;
    *) set_mute "$SINK" "$ACTION" ;;
    esac
    line="$(wpctl get-volume "$SINK")"
    muted=false
    [[ "$line" == *'[MUTED]'* ]] && muted=true
    pct="$(awk '{ printf "%d", $2 * 100 + 0.5 }' <<<"$line")"
    qs ipc call osd volume "$pct" "$muted" || true
    qs ipc call quicksettings refresh >/dev/null 2>&1 &
    [[ "$ACTION" == mute* && "$muted" == true ]] || sound audio-volume-change
    ;;
input)
    set_mute "$SOURCE" "$ACTION"
    muted=false
    wpctl get-volume "$SOURCE" | grep -qF '[MUTED]' && muted=true
    qs ipc call osd mic "$muted" || true
    sound audio-volume-change
    ;;
*)
    echo "volume: unknown target '$TARGET' (want output|input)" >&2
    exit 2
    ;;
esac

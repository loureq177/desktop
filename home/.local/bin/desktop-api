#!/usr/bin/env python3
"""Every option, event and type Hyprland and Quickshell declare, one a line and sorted.

Read from what their packages install; sysupdate compares two runs to say what is new.
"""

import glob
import re

HYPRLAND = "/usr/share/hypr/stubs/hl.meta.lua"
QUICKSHELL = "/usr/lib/qt6/qml/Quickshell/**/*.qmltypes"

# The same options again, by another route.
REPEATS = ("HL.ConfigValueTypes", "HL.ConfigOpt")
ALIASES = {"HL.EventName": "event", "HL.ConfigKey": "option"}


def hyprland(path):
    alias = scope = None
    with open(path, encoding="utf-8") as f:
        for line in f:
            if m := re.match(r"---@alias (\S+)", line):
                alias, scope = ALIASES.get(m[1]), None
            elif m := re.match(r"---@class (\S+)", line):
                alias, scope = None, m[1]
            elif alias and (m := re.match(r'---\| "(.+)"', line)):
                yield f"hyprland {alias} {m[1]}"
            elif scope and not scope.startswith(REPEATS) and (m := re.match(r"---@field (\w+)", line)):
                yield f"hyprland {scope}.{m[1]}"


# A component's own name, and its members: what starts with `on` is the C++ side's slots.
def quickshell(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    for component in re.split(r"(?m)^    Component \{", text)[1:]:
        exports = re.search(r'exports: \["[^"]*/(\w+) ', component)
        if exports is None:
            continue
        name = exports[1]
        yield f"quickshell {name}"
        for kind, member in re.findall(r'(Property|Signal|Method|Enum) \{\s*name: "(\w+)"', component):
            if kind != "Method" or not re.match(r"on[A-Z]", member):
                yield f"quickshell {name}.{member}"


def main():
    found = set()
    try:
        found.update(hyprland(HYPRLAND))
    except FileNotFoundError:
        pass
    for path in glob.glob(QUICKSHELL, recursive=True):
        found.update(quickshell(path))
    print("\n".join(sorted(found)))


if __name__ == "__main__":
    main()

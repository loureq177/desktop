#!/usr/bin/env python3
# The browser, the web apps and the special workspaces: ~/.config/apps/apps.toml, rendered for
# Hyprland (apps.lua), the shell (apps.json) and xdg-open (hyprland-mimeapps.list).
#
#   apply-apps              render apps.toml (the standard set when there is none)
#   apply-apps --pick       ask for the browser and the apps, then render
#   apply-apps --defaults   write the standard set without asking, then render
#   apply-apps --packages   what the choices need, as "pacman|aur|flatpak NAME" lines
#   --no-reload             leave the running Hyprland alone

import json
import os
import re
import shlex
import subprocess
import sys
import tomllib
from pathlib import Path
from urllib.parse import urlsplit

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
APPS_DIR = CONFIG_DIR / "apps"
CHOICES = APPS_DIR / "apps.toml"
# Next to this script in the repo, linked or not (install.sh runs it before stow).
CATALOG = Path(__file__).resolve().parents[2] / ".config/apps/catalog.toml"
BIN = Path.home() / ".local/bin"

HEADER = "Auto-generated by apply-apps. DO NOT EDIT DIRECTLY.\nModify ~/.config/apps/apps.toml, or run 'apply-apps --pick'."


def load_catalog():
    with open(CATALOG, "rb") as f:
        return tomllib.load(f)


# One special as apps.toml keeps it: all it needs, so it outlives catalog changes.
def special(category, app, key):
    s = {
        "name": category["id"],
        "key": key,
        "title": category["title"],
        "app": app["name"],
    }
    for field in ("url", "term", "exec", "class", "title", "icon", "app_icon", "desktop", "player"):
        if field in app:
            s["window_title" if field == "title" else field] = app[field]
    s.setdefault("icon", category.get("icon", ""))
    for field in ("desc", "background", "bar"):
        if field in category:
            s[field] = category[field]
    for source in ("pacman", "aur", "flatpak"):
        if source in app:
            s[source] = app[source]
    return s


def standard(catalog):
    return [special(c, c["apps"][0], c["key"]) for c in catalog["category"] if c.get("standard")]


def by_id(catalog, browser_id):
    return next((b for b in catalog["browsers"] if b["id"] == browser_id), catalog["browsers"][0])


def load_choices(catalog):
    if CHOICES.exists():
        with open(CHOICES, "rb") as f:
            return tomllib.load(f)
    return {"browser": catalog["browsers"][0]["id"], "special": standard(catalog)}


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    return json.dumps(v, ensure_ascii=False)


def save(choices):
    lines = [
        "# Your browser and special workspaces (SUPER + SHIFT + key). 'apply-apps' renders",
        "# them after a change; 'apply-apps --pick' asks again. The offer: catalog.toml.",
        "",
        f"browser = {toml_value(choices['browser'])}",
    ]
    for item in choices.get("special", []):
        lines += ["", "[[special]]"] + [f"{k} = {toml_value(v)}" for k, v in item.items()]
    APPS_DIR.mkdir(parents=True, exist_ok=True)
    CHOICES.write_text("\n".join(lines) + "\n")
    print(f"  \033[32m✓\033[0m Saved: {CHOICES}")


# --- asking ------------------------------------------------------------------

BLUE, GREEN, RED, DIM, BOLD, RESET = "\033[34m", "\033[32m", "\033[31m", "\033[2m", "\033[1m", "\033[0m"


class Aborted(Exception):
    pass


# A question on the terminal: keys one at a time, its lines redrawn in place.
class Screen:
    def __enter__(self):
        import termios
        import tty

        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        # TCSANOW: keys typed while the last question closed still count.
        tty.setcbreak(self.fd, termios.TCSANOW)
        self.height = 0
        sys.stdout.write("\033[?25l")
        return self

    def __exit__(self, *exc):
        import termios

        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()

    def draw(self, lines):
        width = os.get_terminal_size().columns
        # Cut to the width: a wrapped line would throw the redraw off.
        lines = [fit(line, width - 1) for line in lines]
        up = f"\033[{self.height}F" if self.height else "\r"
        sys.stdout.write(up + "\033[J" + "\n".join(lines) + "\n")
        sys.stdout.flush()
        self.height = len(lines)

    def key(self):
        import select

        ch = os.read(self.fd, 1)
        if ch in (b"", b"\x03", b"\x04"):
            raise Aborted
        if ch == b"\x1b":
            if not select.select([self.fd], [], [], 0.05)[0]:
                return "esc"
            seq = os.read(self.fd, 2)
            return {b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left"}.get(seq, "")
        if ch in (b"\r", b"\n"):
            return "enter"
        if ch == b"\x7f":
            return "backspace"
        return ch.decode(errors="ignore")


def fit(line, width):
    out, seen = "", 0
    for part in re.split(r"(\033\[[0-9;?]*[A-Za-z])", line):
        if part.startswith("\033"):
            out += part
        else:
            out += part[: max(width - seen, 0)]
            seen += len(part)
    return out + RESET


# Every field on screen at once: ↑↓ or tab move, enter goes on, past the last it
# takes them. `check` returns the answers, or an error to show. None for esc.
def form(title, fields, check):
    values, cursor, error = [""] * len(fields), 0, ""
    with Screen() as screen:
        while True:
            lines = [f"{BOLD}{title}{RESET}", ""]
            for i, (label, example) in enumerate(fields):
                here = i == cursor
                shown = f"{values[i]}{BLUE}▏{RESET}" if here else values[i]
                if not values[i]:
                    shown += f"{DIM}{example}{RESET}"
                lines.append(f" {BLUE + '❯' + RESET if here else ' '} {label:<16}{shown}")
            lines += ["", f"{RED}{error}{RESET}" if error else f"{DIM}↑↓ tab move · enter next · esc cancel{RESET}"]
            screen.draw(lines)
            key = screen.key()
            error = ""
            if key == "esc":
                return None
            if key == "up":
                cursor = (cursor - 1) % len(fields)
            elif key in ("down", "\t"):
                cursor = (cursor + 1) % len(fields)
            elif key == "backspace":
                values[cursor] = values[cursor][:-1]
            elif key == "enter":
                if cursor < len(fields) - 1:
                    cursor += 1
                else:
                    answers = check(values)
                    if isinstance(answers, dict):
                        return answers
                    error = answers
            elif len(key) == 1 and key.isprintable():
                values[cursor] += key


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


# What an app of your own runs: a dotted word is a site, the rest a command.
def target_of(answer):
    if not answer:
        return None
    if " " in answer or answer[0] in "/~" or not ("://" in answer or "." in answer):
        return {"exec": answer}
    url = answer if "://" in answer else "https://" + answer
    return {"url": url} if urlsplit(url).hostname else None


# A row is a title, what ←→ walks through and a key; only the browser cannot be off.
def rows_of(catalog, current):
    first_time = not CHOICES.exists()
    had = {s["name"]: s for s in current.get("special", [])}
    browsers = catalog["browsers"]
    rows = [{
        "title": "Browser",
        "browser": True,
        "options": [b["name"] for b in browsers],
        "at": next((i for i, b in enumerate(browsers) if b["id"] == current.get("browser")), 0),
    }, {"gap": True}]
    for c in catalog["category"]:
        names = [a["name"] for a in c["apps"]]
        s = had.get(c["id"])
        at = names.index(s["app"]) + 1 if s and s["app"] in names else 0
        if first_time and c.get("standard"):
            at = 1
        rows.append({"title": c["title"], "category": c, "options": ["off"] + names, "at": at, "key": s["key"] if s else c["key"]})
    # Also what the catalog no longer has under that name.
    for s in current.get("special", []):
        known = any(c["id"] == s["name"] and any(a["name"] == s["app"] for a in c["apps"]) for c in catalog["category"])
        if not known:
            rows.append({"title": s["app"], "own": s, "options": ["off", s.get("url") or s.get("exec") or s.get("term", "")], "at": 1, "key": s["key"]})
    rows.append({"gap": True})
    rows.append({"title": "+ Add an app", "add": True})
    return rows


def can_be_off(row):
    return "category" in row or "own" in row


def on(row):
    return can_be_off(row) and row["at"] > 0


# A letter that is free, else none: pressing one is then all it takes.
def turn_on(row, rows, reserved):
    row["at"] = max(row["at"], 1)
    taken = {r["key"] for r in rows if on(r) and r is not row}
    if row["key"] in taken or row["key"] in reserved:
        row["key"] = ""


def scrolled(items, cursor, room):
    top = max(0, min(cursor - room // 2, len(items) - room))
    return top, items[top : top + room]


def neighbour(shown, cursor, by):
    i = (cursor + by) % len(shown)
    while "gap" in shown[i]:
        i = (i + by) % len(shown)
    return shown[i]


# What is on, nothing to step through: everything can be changed from here. Returns what
# enter did and the row it was on.
def ask(catalog, rows, row):
    reserved = catalog["reserved"]
    error = ""
    with Screen() as screen:
        while True:
            shown = [r for r in rows if not can_be_off(r) or on(r)]
            if row not in shown:
                row = next(r for r in shown if "add" in r)
            cursor = shown.index(row)
            lines = [f"{BOLD}Browser and apps{RESET}", f"{DIM}Each app opens on a special workspace with SUPER + SHIFT + its letter{RESET}", ""]
            top, part = scrolled(shown, cursor, max(os.get_terminal_size().lines - 7, 3))
            for i, r in enumerate(part, top):
                if "gap" in r:
                    lines.append("")
                    continue
                here = i == cursor
                mark = f"{BLUE}❯{RESET}" if here else " "
                title = f"{BLUE}{r['title']}{RESET}" if here else r["title"]
                if "add" in r:
                    lines.append(f" {mark} {title}")
                    continue
                pad = " " * (18 - len(r["title"]))
                key = "   "
                if on(r):
                    key = f"{GREEN}{r['key']}{RESET}  " if r["key"] else f"{RED}_{RESET}  "
                value = r["options"][r["at"]]
                many = len(r["options"]) > (1 if "browser" in r else 2)
                lines.append(f" {mark} {title}{pad}{key}" + (f"{DIM}‹{RESET} {value} {DIM}›{RESET}" if many else value))
            lines += ["", f"{RED}{error}{RESET}" if error else f"{DIM}↑↓ move · ←→ change · a letter sets the key · ⌫ remove · enter save · esc cancel{RESET}"]
            screen.draw(lines)
            key, error = screen.key(), ""
            if key == "up":
                row = neighbour(shown, cursor, -1)
            elif key == "down":
                row = neighbour(shown, cursor, 1)
            elif key == "esc":
                raise Aborted
            elif key in ("left", "right") and "options" in row:
                by = -1 if key == "left" else 1
                # The first option of a row that can be off is "off": ⌫ does that.
                first = 1 if can_be_off(row) else 0
                row["at"] = (row["at"] - first + by) % (len(row["options"]) - first) + first
            elif key == "backspace" and can_be_off(row):
                row["at"] = 0
                row = neighbour(shown, cursor, 1)
            elif key == "enter" and "add" in row:
                return "add", row
            elif key == "enter":
                missing = next((r for r in rows if on(r) and not r["key"]), None)
                if missing is None:
                    return "save", row
                row, error = missing, f"{missing['title']} needs a letter: press one"
            elif len(key) == 1 and key.isalpha() and key.isascii() and can_be_off(row):
                letter = key.upper()
                if letter in reserved:
                    error = f"{letter} moves windows (SUPER + SHIFT + {' '.join(reserved)})"
                    continue
                for other in rows:
                    if other is not row and on(other) and other["key"] == letter:
                        other["key"] = row["key"]
                row["key"] = letter


# What is off, then a new one of your own. None for esc.
def choose_addition(rows):
    items = [r for r in rows if can_be_off(r) and not on(r)] + [{"title": "Your own app", "new": True}]
    cursor = 0
    width = max(len(item["title"]) for item in items) + 2
    with Screen() as screen:
        while True:
            lines = [f"{BOLD}Add an app{RESET}", ""]
            top, part = scrolled(items, cursor, max(os.get_terminal_size().lines - 5, 3))
            for i, item in enumerate(part, top):
                here = i == cursor
                title = f"{BLUE}{item['title']:<{width}}{RESET}" if here else f"{item['title']:<{width}}"
                note = ", ".join(item["options"][1:]) if "options" in item else "a site or a command"
                lines.append(f" {BLUE + '❯' + RESET if here else ' '} {title}{DIM}{note}{RESET}")
            lines += ["", f"{DIM}↑↓ move · enter add · esc back{RESET}"]
            screen.draw(lines)
            key = screen.key()
            if key == "up":
                cursor = (cursor - 1) % len(items)
            elif key == "down":
                cursor = (cursor + 1) % len(items)
            elif key == "esc":
                return None
            elif key == "enter":
                return items[cursor]


def pick(catalog, current):
    rows = rows_of(catalog, current)
    row = rows[0]

    def check(values):
        name, target = values[0].strip(), target_of(values[1].strip())
        if not slug(name):
            return "Give it a name"
        return {"name": name, "target": target} if target else "Give it a URL or a command"

    while True:
        sys.stdout.write("\033[H\033[2J")
        action, row = ask(catalog, rows, row)
        if action == "save":
            break
        sys.stdout.write("\033[H\033[2J")
        item = choose_addition(rows)
        if item is None:
            continue
        if "new" not in item:
            turn_on(item, rows, catalog["reserved"])
            row = item
            continue
        sys.stdout.write("\033[H\033[2J")
        answers = form("Your own app", [("Name", "Claude"), ("URL or command", "claude.ai, claude-desktop")], check)
        if answers:
            taken = {c["id"] for c in catalog["category"]} | {r["own"]["name"] for r in rows if "own" in r}
            ws = slug(answers["name"])
            while ws in taken:
                ws += "-2"
            own = {"name": ws, "key": "", "title": answers["name"], "app": answers["name"], **answers["target"], "icon": ""}
            row = {"title": answers["name"], "own": own, "options": ["off", next(iter(answers["target"].values()))], "at": 1, "key": ""}
            rows.insert(len(rows) - 2, row)
    sys.stdout.write("\033[H\033[2J")
    specials = []
    for row in rows:
        if on(row) and "category" in row:
            c = row["category"]
            specials.append(special(c, c["apps"][row["at"] - 1], row["key"]))
        elif on(row):
            specials.append(dict(row["own"], key=row["key"]))
    # An app of your own under a category's name, with that category turned on too.
    seen = set()
    for s in specials:
        while s["name"] in seen:
            s["name"] += "-2"
        seen.add(s["name"])
    return {"browser": catalog["browsers"][rows[0]["at"]]["id"], "special": specials}


# --- rendering ---------------------------------------------------------------


def regex_literal(text):
    return re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", text)


def lua_table(d, indent):
    pad = "\t" * indent
    items = []
    for k, v in d.items():
        # Workspace names may have dashes, which a bare Lua key may not.
        key = k if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k) else f"[{json.dumps(k)}]"
        if isinstance(v, dict):
            value = lua_table(v, indent + 1)
        elif isinstance(v, list):
            value = "{ " + ", ".join(json.dumps(x, ensure_ascii=False) for x in v) + " }"
        else:
            value = ("true" if v else "false") if isinstance(v, bool) else json.dumps(v, ensure_ascii=False)
        items.append(f"{pad}{key} = {value},")
    return "{\n" + "\n".join(items) + "\n" + "\t" * (indent - 1) + "}"


# The desktop entry of a command of your own, when installed: its icon, its window, and
# the launcher then lists the special in its place.
def desktop_entry(command):
    try:
        words = shlex.split(command)
    except ValueError:
        return {}
    words[0] = words[0].rsplit("/", 1)[-1]
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    for folder in (data / "applications", Path("/usr/share/applications")):
        for path in sorted(folder.glob("*.desktop")):
            fields = {}
            for line in path.read_text(errors="ignore").splitlines()[1:]:
                if line.startswith("["):
                    break
                fields.update([line.split("=", 1)] if "=" in line else [])
            try:
                run = shlex.split(fields.get("Exec", ""))
            except ValueError:
                continue
            if run and [run[0].rsplit("/", 1)[-1]] + run[1 : len(words)] == words:
                found = {"desktop": path.stem}
                found.update({"app_icon": fields["Icon"]} if "Icon" in fields else {})
                found.update({"class": re.escape(fields["StartupWMClass"])} if "StartupWMClass" in fields else {})
                return found
    return {}


# What Hyprland runs and matches for one special (hyprland/specials.lua).
def hypr_special(s, browser):
    h = {"id": s["name"], "key": s["key"], "desc": s["title"]}
    if "url" in s:
        url = shlex.quote(s["url"])
        if browser["engine"] == "firefox":
            env = "" if browser["exec"] == "firefox" else f"env FIREFOX={shlex.quote(browser['exec'])} "
            h["exe"] = f"{env}{BIN}/firefox-webapp {s['name']} {url}"
            h["class"] = "webapps"
            h["title"] = ".*" + regex_literal(s.get("window_title", s["app"])) + ".*"
            h["firefox"] = True
        else:
            # Chromium names an --app window after the URL's host: chrome-x.com__-Default.
            host = urlsplit(s["url"]).hostname or ""
            h["exe"] = f"{BIN}/chromium-webapp {shlex.quote(browser['exec'])} {url}"
            h["class"] = ".*-" + regex_literal(host) + "_.*"
            h["host"] = "-" + host + "_"
    elif "term" in s:
        h["exe"] = f"ghostty +new-window -e {s['term']}"
    else:
        h["exe"] = s["exec"]
        if "class" in s:
            h["class"] = s["class"]
    if s.get("background"):
        h["background"] = True
    return h


# What the shell shows of one special (Specials.qml).
def shell_special(s):
    out = {
        "name": s["name"],
        "app": s["app"],
        "title": s["title"],
        "desc": s.get("desc", "Web app" if "url" in s else s["title"]),
        "icon": s.get("icon", ""),
        "appIcon": s.get("app_icon", "web-browser"),
        "keywords": " ".join(dict.fromkeys([s["name"], s["title"].lower(), s["app"].lower()])),
    }
    if "desktop" in s:
        out["desktop"] = s["desktop"]
    if "player" in s:
        out["player"] = s["player"]
    if s.get("bar") is False:
        out["inBar"] = False
    return out


def render(catalog, choices):
    browser = by_id(catalog, choices["browser"])
    specials = [{**desktop_entry(s["exec"]), **s} if "exec" in s else s for s in choices.get("special", [])]

    hypr = {
        "browser": {"exec": browser["exec"]},
        "specials": {s["name"]: hypr_special(s, browser) for s in specials},
        "background": [s["name"] for s in specials if s.get("background")],
    }
    lua = "".join(f"-- {line}\n" for line in HEADER.splitlines()) + "\nreturn " + lua_table(hypr, 1) + "\n"

    shell = {"browser": browser["id"], "specials": [shell_special(s) for s in specials]}

    desktop = browser["desktop"]
    handled = ["text/html", "x-scheme-handler/http", "x-scheme-handler/https", "x-scheme-handler/about", "x-scheme-handler/unknown", "application/pdf"]
    # Read before mimeapps.list by xdg-open and GIO while XDG_CURRENT_DESKTOP is Hyprland.
    mime = "".join(f"# {line}\n" for line in HEADER.splitlines()) + "[Default Applications]\n" + "".join(f"{m}={desktop}\n" for m in handled)

    for path, content in (
        (APPS_DIR / "apps.lua", lua),
        (APPS_DIR / "apps.json", json.dumps(shell, indent=4, ensure_ascii=False) + "\n"),
        (CONFIG_DIR / "hyprland-mimeapps.list", mime),
    ):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        print(f"  \033[32m✓\033[0m Generated: {path}")


def needed(catalog, choices):
    items = [by_id(catalog, choices["browser"])] + choices.get("special", [])
    for source in ("pacman", "aur", "flatpak"):
        names = [name for item in items for name in item.get(source, [])]
        for name in dict.fromkeys(names):
            yield source, name


def packages(catalog, choices):
    for source, name in needed(catalog, choices):
        print(source, name)


# --pick by itself installs nothing: says what is still to install, and how.
def report_missing(catalog, choices):
    run = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True)
    missing = [name for source, name in needed(catalog, choices) if source != "flatpak" and name not in run.stdout.split()]
    if missing:
        print(f"  {DIM}Not installed yet:{RESET} paru -S --needed {' '.join(missing)}")


def main():
    args = set(sys.argv[1:])
    unknown = args - {"--pick", "--defaults", "--packages", "--no-reload", "-h", "--help"}
    if unknown or args & {"-h", "--help"}:
        # The comment at the top of this file.
        lines = Path(__file__).read_text().splitlines()[1:]
        print("\n".join(line[2:] for line in lines[: lines.index("")]))
        sys.exit(2 if unknown else 0)

    catalog = load_catalog()
    if "--defaults" in args:
        save({"browser": catalog["browsers"][0]["id"], "special": standard(catalog)})
    choices = load_choices(catalog)

    if "--packages" in args:
        packages(catalog, choices)
        return
    if "--pick" in args:
        if not sys.stdin.isatty():
            sys.exit("apply-apps: --pick asks on a terminal; --defaults takes the standard set")
        try:
            choices = pick(catalog, choices)
        except (Aborted, KeyboardInterrupt):
            sys.exit("\napply-apps: nothing changed")
        save(choices)

    render(catalog, choices)
    if "--pick" in args and "--no-reload" not in args:
        report_missing(catalog, choices)

    if "--no-reload" not in args and subprocess.run(["pgrep", "-x", "Hyprland"], capture_output=True).returncode == 0:
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        print("  \033[32m✓\033[0m Hyprland reloaded")


if __name__ == "__main__":
    main()

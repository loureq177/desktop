#!/usr/bin/env python3
# The browser and the special workspaces: ~/.config/apps/apps.toml, rendered for
# Hyprland (apps.lua), the shell (apps.json) and xdg-open (hyprland-mimeapps.list).
#
#   apply-apps              render apps.toml (the standard set when there is none)
#   apply-apps --pick       ask for the browser and the specials, then render
#   apply-apps --defaults   write the standard set without asking, then render
#   apply-apps --packages   what the choices need, as "pacman|aur|flatpak NAME" lines
#   --no-reload             leave the running Hyprland alone

import json
import os
import re
import shlex
import subprocess
import sys
import tomllib
from pathlib import Path
from urllib.parse import urlsplit

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
APPS_DIR = CONFIG_DIR / "apps"
CHOICES = APPS_DIR / "apps.toml"
# Next to this script in the repo, linked or not (install.sh runs it before stow).
CATALOG = Path(__file__).resolve().parents[2] / ".config/apps/catalog.toml"
BIN = Path.home() / ".local/bin"

HEADER = "Auto-generated by apply-apps. DO NOT EDIT DIRECTLY.\nModify ~/.config/apps/apps.toml, or run 'apply-apps --pick'."


def load_catalog():
    with open(CATALOG, "rb") as f:
        return tomllib.load(f)


# One special as apps.toml keeps it: all it needs, so it outlives catalog changes.
def special(category, app, key):
    s = {
        "name": category["id"],
        "key": key,
        "title": category["title"],
        "app": app["name"],
    }
    for field in ("url", "term", "exec", "class", "title", "icon", "app_icon", "desktop", "player"):
        if field in app:
            s["window_title" if field == "title" else field] = app[field]
    s.setdefault("icon", category.get("icon", ""))
    for field in ("desc", "background", "bar"):
        if field in category:
            s[field] = category[field]
    for source in ("pacman", "aur", "flatpak"):
        if source in app:
            s[source] = app[source]
    return s


def standard(catalog):
    return [special(c, c["apps"][0], c["key"]) for c in catalog["category"] if c.get("standard")]


def load_choices(catalog):
    if CHOICES.exists():
        with open(CHOICES, "rb") as f:
            return tomllib.load(f)
    return {"browser": catalog["browsers"][0]["id"], "special": standard(catalog)}


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    return json.dumps(v, ensure_ascii=False)


def save(choices):
    lines = [
        "# Your browser and special workspaces (SUPER + SHIFT + key). 'apply-apps' renders",
        "# them after a change; 'apply-apps --pick' asks again. The offer: catalog.toml.",
        "",
        f"browser = {toml_value(choices['browser'])}",
    ]
    for s in choices["special"]:
        lines += ["", "[[special]]"] + [f"{k} = {toml_value(v)}" for k, v in s.items()]
    APPS_DIR.mkdir(parents=True, exist_ok=True)
    CHOICES.write_text("\n".join(lines) + "\n")
    print(f"  \033[32m✓\033[0m Saved: {CHOICES}")


# --- asking ------------------------------------------------------------------

BLUE, GREEN, RED, DIM, BOLD, RESET = "\033[34m", "\033[32m", "\033[31m", "\033[2m", "\033[1m", "\033[0m"


class Aborted(Exception):
    pass


# A question on the terminal: keys one at a time, its lines redrawn in place.
class Screen:
    def __enter__(self):
        import termios
        import tty

        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        # TCSANOW: keys typed while the last question closed still count.
        tty.setcbreak(self.fd, termios.TCSANOW)
        self.height = 0
        sys.stdout.write("\033[?25l")
        return self

    def __exit__(self, *exc):
        import termios

        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()

    def draw(self, lines):
        width = os.get_terminal_size().columns
        # Cut to the width: a wrapped line would throw the redraw off.
        lines = [fit(line, width - 1) for line in lines]
        up = f"\033[{self.height}F" if self.height else "\r"
        sys.stdout.write(up + "\033[J" + "\n".join(lines) + "\n")
        sys.stdout.flush()
        self.height = len(lines)

    def key(self):
        import select

        ch = os.read(self.fd, 1)
        if ch in (b"", b"\x03", b"\x04"):
            raise Aborted
        if ch == b"\x1b":
            if not select.select([self.fd], [], [], 0.05)[0]:
                return "esc"
            seq = os.read(self.fd, 2)
            return {b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left"}.get(seq, "")
        if ch in (b"\r", b"\n"):
            return "enter"
        if ch == b"\x7f":
            return "backspace"
        return ch.decode(errors="ignore")


def fit(line, width):
    out, seen = "", 0
    for part in re.split(r"(\033\[[0-9;?]*[A-Za-z])", line):
        if part.startswith("\033"):
            out += part
        else:
            out += part[: max(width - seen, 0)]
            seen += len(part)
    return out + RESET


def done(screen, title, answer):
    screen.draw([f"{GREEN}✔{RESET} {title}  {DIM}{answer}{RESET}"])


# One of `options` ((label, note) pairs) or, with `multi`, any of them: ↑↓ or j/k
# move, a digit jumps, space ticks, enter takes it.
def choose(title, hint, options, default=0, multi=False, ticked=()):
    cursor, ticked = default, set(ticked)
    width = max(len(label) for label, _ in options) + 2
    keys = "↑↓ move · space tick · enter confirm" if multi else "↑↓ move · enter select"
    with Screen() as screen:
        while True:
            lines = [f"{BOLD}{title}{RESET}", f"{DIM}{hint}{RESET}", ""]
            for i, (label, note) in enumerate(options):
                here = i == cursor
                box = (f"{GREEN}[✔]{RESET} " if i in ticked else "[ ] ") if multi else ""
                mark = f"{BLUE}❯{RESET}" if here else " "
                text = f"{BLUE}{label:<{width}}{RESET}" if here else f"{label:<{width}}"
                lines.append(f" {mark} {box}{i + 1:>{len(str(len(options)))}}. {text}{DIM}{note}{RESET}")
            lines += ["", f"{DIM}{keys} · ctrl+c quit{RESET}"]
            screen.draw(lines)
            key = screen.key()
            if key in ("up", "k"):
                cursor = (cursor - 1) % len(options)
            elif key in ("down", "j"):
                cursor = (cursor + 1) % len(options)
            elif key.isdigit() and 1 <= int(key) <= len(options):
                cursor = int(key) - 1
                if not multi:
                    key = "enter"
            if multi and key == " ":
                ticked ^= {cursor}
            if key == "enter":
                if multi:
                    done(screen, title, ", ".join(options[i][0] for i in sorted(ticked)) or "none")
                    return sorted(ticked)
                done(screen, title, options[cursor][0])
                return cursor


# The specials: space ticks one, ←→ (or h/l) changes its app. Rows are
# [label, apps, app index, note]; returns the ticked rows' indexes.
def choose_specials(rows, ticked):
    cursor, ticked = 0, set(ticked)
    width = max(len(row[0]) for row in rows) + 2
    digits = len(str(len(rows)))
    with Screen() as screen:
        while True:
            lines = [f"{BOLD}Special workspaces{RESET}", f"{DIM}one app each, opened with SUPER + SHIFT + a key{RESET}", ""]
            for i, (label, apps, app, note) in enumerate(rows):
                here = i == cursor
                box = f"{GREEN}[✔]{RESET}" if i in ticked else "[ ]"
                mark = f"{BLUE}❯{RESET}" if here else " "
                name = f"{BLUE}{label:<{width}}{RESET}" if here else f"{label:<{width}}"
                if len(apps) > 1:
                    choice = f"‹ {apps[app]} ›  {DIM}{app + 1}/{len(apps)}{RESET}"
                else:
                    choice = f"{DIM}{note or apps[0]}{RESET}"
                lines.append(f" {mark} {box} {i + 1:>{digits}}. {name}{choice}")
            lines += ["", f"{DIM}↑↓ move · space tick · ←→ app · enter confirm · ctrl+c quit{RESET}"]
            screen.draw(lines)
            key = screen.key()
            row = rows[cursor]
            if key in ("up", "k"):
                cursor = (cursor - 1) % len(rows)
            elif key in ("down", "j"):
                cursor = (cursor + 1) % len(rows)
            elif key in ("left", "right", "h", "l") and len(row[1]) > 1:
                row[2] = (row[2] + (1 if key in ("right", "l") else -1)) % len(row[1])
                ticked.add(cursor)
            elif key == " ":
                ticked ^= {cursor}
            elif key == "enter":
                done(screen, "Special workspaces", ", ".join(rows[i][0] if rows[i][3] else rows[i][1][rows[i][2]] for i in sorted(ticked)) or "none")
                return sorted(ticked)


def text(title, check):
    while True:
        try:
            answer = input(f"{BOLD}{title}{RESET} ").strip()
        except EOFError:
            raise Aborted
        value = check(answer)
        if value:
            return value
        print(f"{RED}  That is not it, once more.{RESET}")


# Every special's key, on one screen: the letter pressed goes to the special under
# the cursor, swapped with the one that had it. None may stay without one: a
# special is there to be opened at once.
def ask_keys(specials, reserved):
    def next_empty(start):
        return next((i for i in range(start, len(specials)) if not specials[i]["key"]), None)

    cursor, error = next_empty(0) or 0, ""
    with Screen() as screen:
        while True:
            count = {}
            for s in specials:
                count[s["key"]] = count.get(s["key"], 0) + 1
            lines = [f"{BOLD}Keys{RESET}", f"{DIM}SUPER + SHIFT + the letter opens the special{RESET}", ""]
            for i, s in enumerate(specials):
                bad = not s["key"] or count[s["key"]] > 1
                key = f"{RED}{s['key'] or '_'}{RESET}" if bad else f"{GREEN}{s['key']}{RESET}"
                mark = f"{BLUE}❯{RESET}" if i == cursor else " "
                lines.append(f" {mark} {key}  {s['title']:<17}{DIM}{s['app']}{RESET}")
            lines += ["", f"{RED}{error}{RESET}" if error else f"{DIM}↑↓ move · a letter sets the key · enter confirm{RESET}"]
            screen.draw(lines)
            key, error = screen.key(), ""
            if key in ("up", "down"):
                cursor = (cursor + (1 if key == "down" else -1)) % len(specials)
            elif key == "backspace":
                specials[cursor]["key"] = ""
            elif len(key) == 1 and key.isalpha() and key.isascii():
                letter = key.upper()
                if letter in reserved:
                    error = f"{letter} moves windows (SUPER + SHIFT + {' '.join(reserved)})"
                else:
                    for s in specials:
                        if s["key"] == letter:
                            s["key"] = specials[cursor]["key"]
                    specials[cursor]["key"] = letter
                    after = next_empty(0)
                    cursor = cursor if after is None else after
            elif key == "enter":
                if all(s["key"] and count[s["key"]] == 1 for s in specials):
                    done(screen, "Keys", "  ".join(f"{s['key']} {s['app']}" for s in specials))
                    return
                error = "Each special needs a letter of its own"


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def url_of(answer):
    url = answer if "://" in answer or not answer else "https://" + answer
    return url if urlsplit(url).hostname else ""


def pick(catalog, current):
    reserved = catalog["reserved"]
    categories = catalog["category"]
    browsers = catalog["browsers"]
    had = {s["name"]: s for s in current["special"]}

    ids = [b["id"] for b in browsers]
    print()
    i = choose(
        "Browser",
        "SUPER + B, the links you open, and what the web apps run in",
        [(b["name"], "") for b in browsers],
        ids.index(current["browser"]) if current["browser"] in ids else 0,
    )
    browser = ids[i]

    # Categories, then the web apps of your own already there, then a new one.
    own = [s for s in current["special"] if s["name"] not in {c["id"] for c in categories}]
    rows = []
    for c in categories:
        names = [a["name"] for a in c["apps"]]
        old = had.get(c["id"], {}).get("app")
        rows.append([c["title"], names, names.index(old) if old in names else 0, ""])
    rows += [[s["app"], [s["app"]], 0, s["url"]] for s in own] + [["Your own web app", [""], 0, "a name and a URL"]]
    ticked = [i for i, c in enumerate(categories) if c["id"] in had] if had else [i for i, c in enumerate(categories) if c.get("standard")]
    ticked += [len(categories) + i for i in range(len(own))]
    picked = choose_specials(rows, ticked)

    specials = []
    for n in picked:
        if n < len(categories):
            c = categories[n]
            old = had.get(c["id"], {})
            specials.append(special(c, c["apps"][rows[n][2]], old.get("key", c["key"])))
        elif n < len(categories) + len(own):
            specials.append(dict(own[n - len(categories)]))
        else:
            while True:
                name = text("Name (e.g. X):", lambda a: a if slug(a) else "")
                url = text("URL (e.g. x.com):", url_of)
                ws = slug(name)
                while ws in {c["id"] for c in categories} or ws in {s["name"] for s in specials}:
                    ws += "-web"
                specials.append({"name": ws, "key": "", "title": name, "app": name, "url": url, "icon": ""})
                if choose("Another web app of your own?", "", [("No", ""), ("Yes", "")]) == 0:
                    break

    # A default key someone earlier in the list has is left for you to press.
    seen = set()
    for s in specials:
        if s["key"] in seen or s["key"] in reserved:
            s["key"] = ""
        seen.add(s["key"])
    if specials:
        ask_keys(specials, reserved)
    return {"browser": browser, "special": specials}


# --- rendering ---------------------------------------------------------------


def regex_literal(text):
    return re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", text)


def lua_table(d, indent):
    pad = "\t" * indent
    items = []
    for k, v in d.items():
        # Workspace names may have dashes, which a bare Lua key may not.
        key = k if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k) else f"[{json.dumps(k)}]"
        if isinstance(v, dict):
            value = lua_table(v, indent + 1)
        elif isinstance(v, list):
            value = "{ " + ", ".join(json.dumps(x, ensure_ascii=False) for x in v) + " }"
        else:
            value = ("true" if v else "false") if isinstance(v, bool) else json.dumps(v, ensure_ascii=False)
        items.append(f"{pad}{key} = {value},")
    return "{\n" + "\n".join(items) + "\n" + "\t" * (indent - 1) + "}"


# What Hyprland runs and matches for one special (hyprland/specials.lua).
def hypr_special(s, browser):
    h = {"id": s["name"], "key": s["key"], "desc": s["title"]}
    if "url" in s:
        url = shlex.quote(s["url"])
        if browser["engine"] == "firefox":
            env = "" if browser["exec"] == "firefox" else f"env FIREFOX={shlex.quote(browser['exec'])} "
            h["exe"] = f"{env}{BIN}/firefox-webapp {s['name']} {url}"
            h["class"] = "webapps"
            h["title"] = ".*" + regex_literal(s.get("window_title", s["app"])) + ".*"
            h["firefox"] = True
        else:
            # Chromium names an --app window after the URL's host: chrome-x.com__-Default.
            host = urlsplit(s["url"]).hostname or ""
            h["exe"] = f"{BIN}/chromium-webapp {shlex.quote(browser['exec'])} {url}"
            h["class"] = ".*-" + regex_literal(host) + "_.*"
            h["host"] = "-" + host + "_"
    elif "term" in s:
        h["exe"] = f"ghostty +new-window -e {s['term']}"
    else:
        h["exe"] = s["exec"]
        if "class" in s:
            h["class"] = s["class"]
    if s.get("background"):
        h["background"] = True
    return h


# What the shell shows of one special (Specials.qml).
def shell_special(s):
    out = {
        "name": s["name"],
        "app": s["app"],
        "title": s["title"],
        "desc": s.get("desc", "Web app" if "url" in s else s["title"]),
        "icon": s.get("icon", ""),
        "appIcon": s.get("app_icon", "web-browser"),
        "keywords": " ".join(dict.fromkeys([s["name"], s["title"].lower(), s["app"].lower()])),
    }
    if "desktop" in s:
        out["desktop"] = s["desktop"]
    if "player" in s:
        out["player"] = s["player"]
    if s.get("bar") is False:
        out["inBar"] = False
    return out


def render(catalog, choices):
    browsers = {b["id"]: b for b in catalog["browsers"]}
    browser = browsers.get(choices["browser"], catalog["browsers"][0])
    specials = choices.get("special", [])

    hypr = {
        "browser": {"exec": browser["exec"]},
        "specials": {s["name"]: hypr_special(s, browser) for s in specials},
        "background": [s["name"] for s in specials if s.get("background")],
    }
    lua = "".join(f"-- {line}\n" for line in HEADER.splitlines()) + "\nreturn " + lua_table(hypr, 1) + "\n"

    shell = {"browser": browser["id"], "specials": [shell_special(s) for s in specials]}

    desktop = browser["desktop"]
    handled = ["text/html", "x-scheme-handler/http", "x-scheme-handler/https", "x-scheme-handler/about", "x-scheme-handler/unknown", "application/pdf"]
    # Read before mimeapps.list by xdg-open and GIO while XDG_CURRENT_DESKTOP is Hyprland.
    mime = "".join(f"# {line}\n" for line in HEADER.splitlines()) + "[Default Applications]\n" + "".join(f"{m}={desktop}\n" for m in handled)

    for path, content in (
        (APPS_DIR / "apps.lua", lua),
        (APPS_DIR / "apps.json", json.dumps(shell, indent=4, ensure_ascii=False) + "\n"),
        (CONFIG_DIR / "hyprland-mimeapps.list", mime),
    ):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        print(f"  \033[32m✓\033[0m Generated: {path}")


def packages(catalog, choices):
    browser = next((b for b in catalog["browsers"] if b["id"] == choices["browser"]), catalog["browsers"][0])
    for source in ("pacman", "aur", "flatpak"):
        names = list(browser.get(source, []))
        for s in choices.get("special", []):
            names += s.get(source, [])
        for name in dict.fromkeys(names):
            print(source, name)


def main():
    args = set(sys.argv[1:])
    unknown = args - {"--pick", "--defaults", "--packages", "--no-reload", "-h", "--help"}
    if unknown or args & {"-h", "--help"}:
        # The comment at the top of this file.
        lines = Path(__file__).read_text().splitlines()[1:]
        print("\n".join(line[2:] for line in lines[: lines.index("")]))
        sys.exit(2 if unknown else 0)

    catalog = load_catalog()
    if "--defaults" in args:
        save({"browser": catalog["browsers"][0]["id"], "special": standard(catalog)})
    choices = load_choices(catalog)

    if "--packages" in args:
        packages(catalog, choices)
        return
    if "--pick" in args:
        if not sys.stdin.isatty():
            sys.exit("apply-apps: --pick asks on a terminal; --defaults takes the standard set")
        try:
            choices = pick(catalog, choices)
        except (Aborted, KeyboardInterrupt):
            sys.exit("\napply-apps: nothing changed")
        save(choices)

    render(catalog, choices)

    if "--no-reload" not in args and subprocess.run(["pgrep", "-x", "Hyprland"], capture_output=True).returncode == 0:
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        print("  \033[32m✓\033[0m Hyprland reloaded")


if __name__ == "__main__":
    main()

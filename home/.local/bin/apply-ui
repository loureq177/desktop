#!/usr/bin/env python3

import json
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))

# ui/templates/<template> -> ~/.config/<target>
TEMPLATES = {
    "ui.lua": "hypr/ui.lua",
    "ui.sh": "ui/ui.sh",
    "hyprlock.conf": "hypr/hyprlock.conf",
    "hyprlock-boot.conf": "hypr/hyprlock-boot.conf",
    "hyprtoolkit.conf": "hypr/hyprtoolkit.conf",
    "gtk.css": "gtk-3.0/gtk.css",
}

COMMENT = {".lua": "--", ".js": "//"}


def header(source, suffix):
    lines = ["Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.", f"Modify ~/.config/ui/{source} and run 'apply-ui'."]
    # CSS has only block comments: GTK reads a '#' line as a broken rule.
    if suffix == ".css":
        return "/* " + "\n * ".join(lines) + " */\n\n"
    mark = COMMENT.get(suffix, "#")
    return "".join(f"{mark} {line}\n" for line in lines) + "\n"


# @section_key@ is a ui.toml value ([border] size → @border_size@); colours are also
# there by name as "#rrggbb", and @name:bare@ drops the "#".
def render(template, values):
    def value(match):
        text = str(values[match.group(1)])
        return text.lstrip("#") if match.group(2) else text

    text = (CONFIG_DIR / "ui" / "templates" / template).read_text()
    source = f"templates/{template} or ~/.config/ui/ui.toml"
    return header(source, Path(template).suffix) + re.sub(r"@([a-z_]+)(:bare)?@", value, text)


def write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    print(f"  \033[32m✓\033[0m Generated: {path}")


# GTK and the portals read these from dconf. Hyprland sets them again at every
# start (--gtk): dconf needs the session bus, which install.sh may not have.
def apply_gtk(cfg):
    gsettings = {
        "cursor-theme": cfg["theme"]["cursor"],
        "icon-theme": cfg["theme"]["icon"],
        "font-name": cfg["font"]["ui"],
        "gtk-theme": cfg["theme"]["gtk"],
        "monospace-font-name": f"{cfg['font']['mono']} 12",
        "color-scheme": "prefer-dark",
    }
    for key, value in gsettings.items():
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, value], capture_output=True)

    # The file chooser opens in the folder the program runs in (home, for
    # the portal), not in Recent, and lists folders first, dotfiles included.
    file_chooser = {
        "startup-mode": "cwd",
        "sort-directories-first": "true",
        "show-hidden": "true",
    }
    for schema in ("org.gtk.Settings.FileChooser", "org.gtk.gtk4.Settings.FileChooser"):
        for key, value in file_chooser.items():
            subprocess.run(["gsettings", "set", schema, key, value], capture_output=True)


# --set section.key=value: changes that one line of ui.toml, keeping its comments and
# the value's kind; refused when it would not parse or the key is not there.
def set_value(assignment):
    path = CONFIG_DIR / "ui" / "ui.toml"
    name, _, raw = assignment.partition("=")
    section, _, key = name.strip().partition(".")
    text = path.read_text()
    old = tomllib.loads(text).get(section, {}).get(key)
    if old is None:
        sys.exit(f"apply-ui: no {section}.{key} in ui.toml")
    if isinstance(old, bool):
        value = "true" if raw.strip().lower() in ("true", "1", "on", "yes") else "false"
    elif isinstance(old, (int, float)):
        number = float(raw)
        value = str(int(number)) if isinstance(old, int) else repr(number)
    else:
        value = json.dumps(raw)
    lines = text.splitlines(keepends=True)
    current = None
    for i, line in enumerate(lines):
        header = re.match(r"\s*\[([^\]]+)\]", line)
        if header:
            current = header.group(1).strip()
        elif current == section and re.match(rf"\s*{re.escape(key)}\s*=", line):
            lines[i] = re.sub(r"=.*", f"= {value}", line.rstrip("\n"), count=1) + "\n"
            break
    new = "".join(lines)
    tomllib.loads(new)
    path.write_text(new)


# --dump: what the shell's settings list of ui.toml, as JSON: every value
# with its kind, and what the themes and fonts can be, from what is installed.
def dump():
    with open(CONFIG_DIR / "ui" / "ui.toml", "rb") as f:
        cfg = tomllib.load(f)
    values = []
    for section, table in cfg.items():
        for key, value in table.items():
            kind = "bool" if isinstance(value, bool) else "int" if isinstance(value, int) else "float" if isinstance(value, float) else "str"
            if section == "colors":
                kind = "color"
            values.append({"section": section, "key": key, "value": value, "kind": kind})

    roots = [Path.home() / ".local/share/icons", Path.home() / ".icons", Path("/usr/share/icons")]
    icons, cursors = set(), set()
    for root in roots:
        for theme in root.glob("*/index.theme"):
            dirs = {d.name for d in theme.parent.iterdir() if d.is_dir()}
            if "cursors" in dirs:
                cursors.add(theme.parent.name)
            if dirs - {"cursors", "cursors_scalable", "hyprcursors"}:
                icons.add(theme.parent.name)
    gtk = {d.parent.name for root in (Path.home() / ".themes", Path("/usr/share/themes")) for d in root.glob("*/gtk-3.0")}
    gtk.add("Adwaita")
    gtk.add("Adwaita-dark")

    def families(*pattern):
        out = subprocess.run(["fc-list", *pattern, "family"], capture_output=True, text=True).stdout
        return sorted({line.split(",")[0].strip() for line in out.splitlines() if line.strip()})

    choices = {
        "theme.icon": sorted(icons - {"hicolor", "default"}),
        "theme.cursor": sorted(cursors - {"default"}),
        "theme.gtk": sorted(gtk),
        "font.family": families(":"),
        "font.mono": families(":spacing=mono"),
    }
    print(json.dumps({"values": values, "choices": choices}))


def main():
    if "--dump" in sys.argv:
        dump()
        return

    for arg in sys.argv[1:]:
        if arg.startswith("--set="):
            set_value(arg[len("--set="):])

    with open(CONFIG_DIR / "ui" / "ui.toml", "rb") as f:
        cfg = tomllib.load(f)

    if "--gtk" in sys.argv:
        apply_gtk(cfg)
        return

    values = {f"{section}_{key}": v for section, table in cfg.items() for key, v in table.items()}
    values |= cfg["colors"]

    # Everything is rendered before anything is written: a bad template
    # leaves the old files in place.
    outputs = {CONFIG_DIR / target: render(template, values) for template, target in TEMPLATES.items()}
    # The shell reads ui.toml as it is (Theme.qml).
    outputs[CONFIG_DIR / "quickshell" / "ui.js"] = (
        header("ui.toml", ".js") + ".pragma library\n\nvar config = " + json.dumps(cfg, indent=4) + ";\n"
    )
    for path, content in outputs.items():
        write(path, content)

    if "--no-reload" in sys.argv:
        return

    print("\033[34m[INFO]\033[0m Reloading running UI components...")
    if subprocess.run(["pgrep", "-x", "Hyprland"], capture_output=True).returncode == 0:
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        subprocess.run([str(Path.home() / ".local/bin/power-save"), "--reapply"], capture_output=True)
        print("  \033[32m✓\033[0m Hyprland reloaded")

    apply_gtk(cfg)
    print("  \033[32m✓\033[0m GNOME/GTK settings updated")

    # The shell reads ui.js once, as it starts.
    if subprocess.run(["systemctl", "--user", "try-restart", "quickshell.service"], capture_output=True).returncode == 0:
        print("  \033[32m✓\033[0m Shell restarted")


if __name__ == "__main__":
    main()

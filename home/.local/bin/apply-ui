#!/usr/bin/env python3
"""
Central UI Style Generator & Applicator
Reads ~/.config/ui/ui.toml and compiles style definitions for:
- Hyprland (ui.lua & ui.conf)
- Waybar (ui.css)
- SwayNC (ui.css)
- SwayOSD (ui.css)
- Rofi (ui.rasi)
- Shell scripts (ui.sh)
- Ly (base + animation colors in config.ini)

Usage:
  apply-ui              # Generate configs and reload running apps
  apply-ui --no-reload  # Only generate configs without reloading
  apply-ui --check      # Verify that all generated files match ui.toml (exit 0/1)
"""

import sys
import os
import re
import tomllib
import subprocess
from pathlib import Path

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16) for i in (0, 2, 4))

def hex_to_hypr_rgba(hex_str, alpha="ee"):
    hex_str = hex_str.lstrip('#')
    return f"rgba({hex_str}{alpha})"

def hex_to_css_rgba(hex_str, alpha=0.6):
    r, g, b = hex_to_rgb(hex_str)
    return f"rgba({r}, {g}, {b}, {alpha})"

def hex_to_ly(hex_str, style="00"):
    return f"0x{style}{hex_str.lstrip('#').lower()}"

def get_config_path():
    candidates = [
        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "ui" / "ui.toml",
        Path.home() / ".files" / "archlinux" / ".config" / "ui" / "ui.toml",
    ]
    for c in candidates:
        if c.is_file():
            return c
    raise FileNotFoundError("Could not find ui.toml configuration file.")

def safe_write(path: Path, content: str, check_mode: bool = False) -> bool:
    # Resolve realpath if path is a symlink so we write into target dotfiles repo
    target = path.resolve() if path.exists() or path.is_symlink() else path
    if check_mode:
        if not target.exists():
            print(f"  \033[31m✗\033[0m Missing file: {target}")
            return False
        if target.read_text() != content:
            print(f"  \033[31m✗\033[0m Out of sync with ui.toml: {target}")
            return False
        print(f"  \033[32m✓\033[0m In sync: {target}")
        return True
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content)
    print(f"  \033[32m✓\033[0m Generated: {target}")
    return True

def main():
    check_mode = "--check" in sys.argv
    reload_apps = "--no-reload" not in sys.argv and not check_mode

    config_file = get_config_path()
    print(f"\033[34m[INFO]\033[0m Reading UI configuration from: {config_file}")

    with open(config_file, "rb") as f:
        cfg = tomllib.load(f)

    r = cfg.get("rounding", {})
    b = cfg.get("border", {})
    s = cfg.get("spacing", {})
    p = cfg.get("padding", {})
    o = cfg.get("opacity", {})
    fnt = cfg.get("font", {})
    thm = cfg.get("theme", {})
    c = cfg.get("colors", {})
    ly = cfg.get("ly", {})

    r_win = r.get("window", 0)
    r_elem = r.get("element", 0)
    r_subtle = r.get("subtle", 0)
    b_size = b.get("size", 2)

    config_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))

    # 1. Hyprland: ui.lua
    lua_content = f"""-- Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
-- Modify ~/.config/ui/ui.toml and run 'apply-ui'.

return {{
    rounding = {{
        window = {r_win},
        element = {r_elem},
        subtle = {r_subtle},
    }},
    border = {{
        size = {b_size},
    }},
    spacing = {{
        gaps_in = {s.get("gaps_in", 10)},
        gaps_out = {s.get("gaps_out", 20)},
        bar_spacing = {s.get("bar_spacing", 8)},
        bar_margin = {s.get("bar_margin", 4)},
        bar_margin_x = {s.get("bar_margin_x", 20)},
        bar_margin_y = {s.get("bar_margin_y", 4)},
    }},
    opacity = {{
        active = {o.get("active", 1.0)},
        inactive = {o.get("inactive", 0.75)},
    }},
    font = {{
        family = "{fnt.get("family", "JetBrainsMono Nerd Font Propo")}",
        mono = "{fnt.get("mono", "JetBrainsMono Nerd Font Mono")}",
        ui = "{fnt.get("ui", "Adwaita Sans 12")}",
        size_bar = {fnt.get("size_bar", 15)},
        size_rofi = {fnt.get("size_rofi", 13)},
        size_notif = {fnt.get("size_notif", 17)},
        size_cursor = {fnt.get("size_cursor", 24)},
    }},
    theme = {{
        cursor = "{thm.get("cursor", "Bibata-Modern-Classic")}",
        icon = "{thm.get("icon", "Papirus-Dark")}",
        gtk = "{thm.get("gtk", "Adwaita-dark")}",
    }},
    colors = {{
        bg_main = "{c.get("bg_main", "#0d1117")}",
        bg_card = "{c.get("bg_card", "#161b22")}",
        bg_hover = "{c.get("bg_hover", "#21262d")}",
        border = "{hex_to_hypr_rgba(c.get("border", "#30363d"))}",
        accent_blue = "{hex_to_hypr_rgba(c.get("accent_blue", "#58a6ff"))}",
        accent_purple = "{hex_to_hypr_rgba(c.get("accent_purple", "#bc8cff"))}",
        accent_green = "{hex_to_hypr_rgba(c.get("accent_green", "#3fb950"))}",
        warning = "{hex_to_hypr_rgba(c.get("warning", "#d29922"))}",
        critical = "{hex_to_hypr_rgba(c.get("critical", "#f85149"))}",
        text_main = "{c.get("text_main", "#c9d1d9")}",
        text_dim = "{c.get("text_dim", "#8b949e")}",
        text_muted = "{c.get("text_muted", "#484f58")}",
        shadow = "{hex_to_hypr_rgba(c.get("shadow", "#010409"))}",
    }},
}}
"""
    r1 = safe_write(config_dir / "hypr" / "ui.lua", lua_content, check_mode)

    # 2. Hyprland / Hyprlock: ui.conf
    r_text, g_text, b_text = hex_to_rgb(c.get("text_main", "#c9d1d9"))
    r_card, g_card, b_card = hex_to_rgb(c.get("bg_card", "#161b22"))
    conf_content = f"""# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml and run 'apply-ui'.

$font = {fnt.get("family", "JetBrainsMono Nerd Font Propo")}
$rounding = {r_win}
$outline_thickness = {b_size}

$accent_blue = {hex_to_hypr_rgba(c.get("accent_blue", "#58a6ff"))}
$accent_purple = {hex_to_hypr_rgba(c.get("accent_purple", "#bc8cff"))}
$accent_green = {hex_to_hypr_rgba(c.get("accent_green", "#3fb950"))}
$warning = {hex_to_hypr_rgba(c.get("warning", "#d29922"))}
$critical = {hex_to_hypr_rgba(c.get("critical", "#f85149"))}
$text_main = rgb({r_text}, {g_text}, {b_text})
$inner_color = rgba({r_card}, {g_card}, {b_card}, 0.65)
"""
    r2 = safe_write(config_dir / "hypr" / "ui.conf", conf_content, check_mode)

    # 3. Waybar: ui.css
    waybar_css = f"""/* Auto-generated by apply-ui. DO NOT EDIT DIRECTLY. */
/* Modify ~/.config/ui/ui.toml and run 'apply-ui'. */

@define-color text {c.get("text_main", "#c9d1d9")};
@define-color text-inactive {c.get("text_dim", "#8b949e")};
@define-color module-bg {hex_to_css_rgba(c.get("bg_card", "#161b22"), 0.6)};
@define-color module-hover {hex_to_css_rgba(c.get("border", "#30363d"), 0.8)};
@define-color hover-bg rgba(255, 255, 255, 0.1);

@define-color accent {c.get("accent_blue", "#58a6ff")};
@define-color accent-purple {c.get("accent_purple", "#bc8cff")};
@define-color accent-green {c.get("accent_green", "#3fb950")};
@define-color warning {c.get("warning", "#d29922")};
@define-color critical {c.get("critical", "#f85149")};

@define-color warning-bg {hex_to_css_rgba(c.get("warning", "#d29922"), 0.15)};
@define-color critical-bg {hex_to_css_rgba(c.get("critical", "#f85149"), 0.35)};
@define-color critical-bg-active {hex_to_css_rgba(c.get("critical", "#f85149"), 0.8)};
@define-color screenshare-bg {hex_to_css_rgba(c.get("accent_purple", "#bc8cff"), 0.15)};
@define-color record-bg {hex_to_css_rgba(c.get("critical", "#f85149"), 0.18)};
@define-color bluetooth-bg {hex_to_css_rgba(c.get("accent_blue", "#58a6ff"), 0.12)};

@define-color border-color {c.get("border", "#30363d")};
@define-color tooltip-bg {hex_to_css_rgba(c.get("bg_main", "#0d1117"), 0.95)};
@define-color tooltip-border {hex_to_css_rgba(c.get("border", "#30363d"), 0.8)};
@define-color tooltip-text {c.get("text_main", "#c9d1d9")};

* {{
  font-family: "{fnt.get("family", "JetBrainsMono Nerd Font Propo")}", sans-serif;
  font-size: {fnt.get("size_bar", 15)}px;
}}

tooltip {{
  border-radius: {r_subtle}px;
  padding: {p.get("tooltip", "8px 12px")};
}}

.modules-left > widget > *,
.modules-center > widget > *,
.modules-right > widget > * {{
  border-radius: {r_elem}px;
  padding: {p.get("module", "0 10px")};
}}

#workspaces button {{
  border-radius: {r_elem}px;
  padding: {p.get("workspace", "0 8px")};
}}
"""
    r3 = safe_write(config_dir / "waybar" / "ui.css", waybar_css, check_mode)

    # 4. SwayNC: ui.css
    swaync_css = f"""/* Auto-generated by apply-ui. DO NOT EDIT DIRECTLY. */
/* Modify ~/.config/ui/ui.toml and run 'apply-ui'. */

@define-color bg-main {c.get("bg_main", "#0d1117")};
@define-color bg-card {c.get("bg_card", "#161b22")};
@define-color bg-hover {c.get("bg_hover", "#21262d")};
@define-color accent {c.get("accent_blue", "#58a6ff")};
@define-color accent-alt {c.get("accent_green", "#3fb950")};
@define-color accent-purple {c.get("accent_purple", "#bc8cff")};
@define-color warning {c.get("warning", "#d29922")};
@define-color critical {c.get("critical", "#f85149")};
@define-color text-main {c.get("text_main", "#c9d1d9")};
@define-color text-dim {c.get("text_dim", "#8b949e")};
@define-color text-muted {c.get("text_muted", "#484f58")};
@define-color border-color {c.get("border", "#30363d")};
@define-color shadow-color {c.get("shadow", "#010409")};

* {{
  font-family: "{fnt.get("family", "JetBrainsMono Nerd Font Propo")}", sans-serif;
  font-size: {fnt.get("size_notif", 17)}px;
}}

.control-center {{
  border-radius: {r_win}px;
  border-width: {b_size}px;
  padding: {p.get("control_center", "12px")};
}}

.notification {{
  border-radius: {r_elem}px;
  border-width: {b_size}px;
  padding: {p.get("notification", "8px 12px")};
}}

.notification-group-headline {{
  border-radius: {r_elem}px;
  border-width: {b_size}px;
}}

.notification-action > button,
.widget-title > button,
.close-button,
.image,
.widget-dnd > switch,
.notification-group-headline > button,
.notification-group-collapse-button,
.notification-group-close-all-button {{
  border-radius: {r_elem}px;
}}

.control-center-list scrollbar slider,
.widget-dnd > switch slider {{
  border-radius: {r_subtle}px;
}}

.notification-action > button {{
  padding: {p.get("button", "6px 12px")};
}}
"""
    r4 = safe_write(config_dir / "swaync" / "ui.css", swaync_css, check_mode)

    # 5. Rofi: ui.rasi
    rofi_rasi = f"""/* Auto-generated by apply-ui. DO NOT EDIT DIRECTLY. */
/* Modify ~/.config/ui/ui.toml and run 'apply-ui'. */

* {{
    border-radius: {r_win}px;
    element-radius: {r_elem}px;
    entry-radius: {r_elem}px;
    border-width: {b_size}px;

    input-padding: {p.get("rofi_input", "16px 20px")};
    element-padding: {p.get("rofi_element", "14px 10px")};
    list-padding: {p.get("rofi_list", "16px 20px")};
    entry-padding: {p.get("rofi_entry", "8px 12px")};

    font-main: "{fnt.get("mono", "JetBrainsMono Nerd Font Mono")} {fnt.get("size_rofi", 13)}";
    font-bold: "{fnt.get("mono", "JetBrainsMono Nerd Font Mono")} Bold {int(fnt.get("size_rofi", 13)) + 1}";

    bg0: {c.get("bg_main", "#0d1117")};
    bg1: {c.get("bg_card", "#161b22")};
    bg2: {c.get("bg_hover", "#21262d")};
    fg0: {c.get("text_main", "#c9d1d9")};
    fg1: {c.get("text_dim", "#8b949e")};
    accent: {c.get("accent_blue", "#58a6ff")};
    accent-alt: {c.get("accent_green", "#3fb950")};
    urgent: {c.get("critical", "#f85149")};
    border-color: {c.get("border", "#30363d")};

    bg-window: {hex_to_css_rgba(c.get("bg_main", "#0d1117"), 0.95)};
    bg-input: {hex_to_css_rgba(c.get("bg_card", "#161b22"), 0.6)};
    selected-bg: {hex_to_css_rgba(c.get("accent_blue", "#58a6ff"), 0.15)};
    selected-border: {hex_to_css_rgba(c.get("accent_blue", "#58a6ff"), 0.4)};
}}
"""
    r5 = safe_write(config_dir / "rofi" / "ui.rasi", rofi_rasi, check_mode)

    # 6. SwayOSD: ui.css
    swayosd_css = f"""/* Auto-generated by apply-ui. DO NOT EDIT DIRECTLY. */
/* Modify ~/.config/ui/ui.toml and run 'apply-ui'. */

@define-color bg-main {c.get("bg_main", "#0d1117")};
@define-color bg-card {c.get("bg_card", "#161b22")};
@define-color bg-hover {c.get("bg_hover", "#21262d")};
@define-color accent {c.get("accent_blue", "#58a6ff")};
@define-color accent-alt {c.get("accent_green", "#3fb950")};
@define-color accent-purple {c.get("accent_purple", "#bc8cff")};
@define-color warning {c.get("warning", "#d29922")};
@define-color critical {c.get("critical", "#f85149")};
@define-color text-main {c.get("text_main", "#c9d1d9")};
@define-color text-dim {c.get("text_dim", "#8b949e")};
@define-color text-muted {c.get("text_muted", "#484f58")};
@define-color border-color {c.get("border", "#30363d")};
@define-color shadow-color {c.get("shadow", "#010409")};

* {{
  font-family: "{fnt.get("family", "JetBrainsMono Nerd Font Propo")}", sans-serif;
  font-size: {fnt.get("size_notif", 17)}px;
}}

window {{
  border-radius: {r_win}px;
  border-width: {b_size}px;
}}

progressbar,
segmentedprogress,
trough,
segment,
progress,
segment.active {{
  border-radius: {r_elem}px;
}}
"""
    r6 = safe_write(config_dir / "swayosd" / "ui.css", swayosd_css, check_mode)

    # 7. Waybar config.jsonc update spacing / margins if needed
    waybar_in_sync = True
    waybar_jsonc = config_dir / "waybar" / "config.jsonc"
    if waybar_jsonc.exists():
        target = waybar_jsonc.resolve()
        txt = target.read_text()
        new_txt = txt
        new_txt = re.sub(r'("spacing":\s*)\d+', rf'\g<1>{s.get("bar_spacing", 8)}', new_txt)
        bar_margin = s.get("bar_margin", 4)
        bar_margin_x = s.get("bar_margin_x", bar_margin)
        bar_margin_y = s.get("bar_margin_y", bar_margin)
        bar_margin_top = s.get("bar_margin_top", bar_margin_y)
        bar_margin_bottom = s.get("bar_margin_bottom", bar_margin_y)
        bar_margin_left = s.get("bar_margin_left", bar_margin_x)
        bar_margin_right = s.get("bar_margin_right", bar_margin_x)

        new_txt = re.sub(r'("margin-top":\s*)\d+', rf'\g<1>{bar_margin_top}', new_txt)
        new_txt = re.sub(r'("margin-bottom":\s*)\d+', rf'\g<1>{bar_margin_bottom}', new_txt)
        new_txt = re.sub(r'("margin-left":\s*)\d+', rf'\g<1>{bar_margin_left}', new_txt)
        new_txt = re.sub(r'("margin-right":\s*)\d+', rf'\g<1>{bar_margin_right}', new_txt)

        if check_mode:
            if txt != new_txt:
                print(f"  \033[31m✗\033[0m Out of sync with ui.toml: {target}")
                waybar_in_sync = False
            else:
                print(f"  \033[32m✓\033[0m In sync: {target}")
        else:
            if txt != new_txt:
                target.write_text(new_txt)
                print(f"  \033[32m✓\033[0m Updated Waybar geometry in: {target}")

    # 8. Shell environment: ui.sh
    bg_main = c.get("bg_main", "#0d1117")
    bg_hover = c.get("bg_hover", "#21262d")
    accent_blue = c.get("accent_blue", "#58a6ff")
    accent_green = c.get("accent_green", "#3fb950")
    border_color = c.get("border", "#30363d")
    text_main = c.get("text_main", "#c9d1d9")
    text_dim = c.get("text_dim", "#8b949e")
    fzf_theme = f"bg+:{bg_hover},bg:{bg_main},fg:{text_main},hl:{accent_blue},fg+:{text_main},hl+:{accent_blue},header:{accent_blue},info:{text_dim},pointer:{accent_blue},marker:{accent_green},prompt:{accent_blue},spinner:{accent_blue},border:{border_color}"

    slurp_args = f'-d -b "{bg_main}b0" -c "{accent_blue}" -s "{accent_blue}20" -w {b_size} -B "#00000000"'
    ui_sh = f"""# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml and run 'apply-ui'.

export UI_BG_MAIN="{bg_main}"
export UI_BG_CARD="{c.get("bg_card", "#161b22")}"
export UI_BG_HOVER="{bg_hover}"
export UI_BORDER_COLOR="{border_color}"
export UI_ACCENT_BLUE="{accent_blue}"
export UI_ACCENT_PURPLE="{c.get("accent_purple", "#bc8cff")}"
export UI_ACCENT_GREEN="{accent_green}"
export UI_WARNING="{c.get("warning", "#d29922")}"
export UI_CRITICAL="{c.get("critical", "#f85149")}"
export UI_TEXT_MAIN="{text_main}"
export UI_TEXT_DIM="{text_dim}"
export UI_TEXT_MUTED="{c.get("text_muted", "#484f58")}"

export UI_BORDER_SIZE="{b_size}"
export UI_ROUNDING_WINDOW="{r_win}"
export UI_ROUNDING_ELEMENT="{r_elem}"
export UI_ROUNDING_SUBTLE="{r_subtle}"

export SLURP_OPTS='{slurp_args}'
# Array form for direct use in bash scripts (arrays cannot be exported).
# shellcheck disable=SC2034
SLURP_ARGS=({slurp_args})
export UI_FZF_THEME="{fzf_theme}"
"""
    r7 = safe_write(config_dir / "ui" / "ui.sh", ui_sh, check_mode)

    # 8. Ly display manager: sync base + animation colors with ui.toml
    ly_in_sync = True
    ly_config = config_dir / "ly" / "config.ini"
    # TTY-tuned glyph color (plain console washes out the bright Wayland blue).
    ly_glyph = ly.get("matrix_fg", accent_blue)
    ly_frame_delay = ly.get("frame_delay", 5)
    if ly_config.exists():
        target = ly_config.resolve()
        txt = target.read_text()
        new_txt = txt
        ly_colors = {
            "bg": hex_to_ly(bg_main),
            "border_fg": hex_to_ly(border_color),
            "fg": hex_to_ly(text_main),
            "error_fg": hex_to_ly(c.get("critical", "#f85149"), style="01"),
            "colormix_col1": hex_to_ly(bg_main),
            "colormix_col2": hex_to_ly(accent_blue),
            "colormix_col3": hex_to_ly(c.get("accent_purple", "#bc8cff")),
            "doom_top_color": hex_to_ly("#8957e5"),
            "doom_middle_color": hex_to_ly(accent_blue),
            "doom_bottom_color": hex_to_ly(text_main),
            "cmatrix_fg": hex_to_ly(ly_glyph),
            "cmatrix_head_col": hex_to_ly(text_main, style="01"),
            "gameoflife_fg": hex_to_ly(ly_glyph),
        }
        new_txt = re.sub(
            rf"^(animation_frame_delay\s*=\s*)\d+",
            rf"\g<1>{ly_frame_delay}",
            new_txt,
            flags=re.MULTILINE,
        )
        for key, value in ly_colors.items():
            new_txt = re.sub(
                rf"^({key}\s*=\s*).*$",
                rf"\g<1>{value}",
                new_txt,
                flags=re.MULTILINE,
            )
        if check_mode:
            if txt != new_txt:
                print(f"  \033[31m✗\033[0m Out of sync with ui.toml: {target}")
                ly_in_sync = False
            else:
                print(f"  \033[32m✓\033[0m In sync: {target}")
        else:
            if txt != new_txt:
                target.write_text(new_txt)
                print(f"  \033[32m✓\033[0m Updated Ly colors in: {target}")

    if check_mode:
        all_ok = all([r1, r2, r3, r4, r5, r6, r7, waybar_in_sync, ly_in_sync])
        if all_ok:
            print("\033[32m[OK]\033[0m All UI configuration files are up to date with ui.toml.")
            sys.exit(0)
        else:
            print("\033[31m[FAIL]\033[0m Some generated UI files are missing or out of date. Run 'apply-ui' to regenerate.")
            sys.exit(1)

    print("\033[32m[OK]\033[0m All UI configuration files generated successfully.")

    # Reload applications
    if reload_apps:
        print("\033[34m[INFO]\033[0m Reloading running UI components...")
        
        # Hyprland
        res = subprocess.run(["pgrep", "-x", "Hyprland"], capture_output=True)
        if res.returncode == 0:
            subprocess.run(["hyprctl", "reload"], capture_output=True)
            print("  \033[32m✓\033[0m Hyprland reloaded")

        # Waybar
        res = subprocess.run(["pgrep", "-x", "waybar"], capture_output=True)
        if res.returncode == 0:
            subprocess.run(["pkill", "-SIGUSR2", "waybar"], capture_output=True)
            print("  \033[32m✓\033[0m Waybar reloaded")

        # SwayNC (restart via systemd to avoid GTK CSS reload infinite loop)
        res = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "swaync"])
        if res.returncode == 0:
            subprocess.run(["systemctl", "--user", "restart", "swaync"], capture_output=True)
            print("  \033[32m✓\033[0m SwayNC restarted")
        else:
            res = subprocess.run(["pgrep", "-x", "swaync"], capture_output=True)
            if res.returncode == 0:
                subprocess.run(["pkill", "-x", "swaync"], capture_output=True)
                subprocess.Popen(["swaync"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                print("  \033[32m✓\033[0m SwayNC restarted")

        # SwayOSD
        res = subprocess.run(["pgrep", "-x", "swayosd-server"], capture_output=True)
        if res.returncode == 0:
            subprocess.run(["pkill", "-x", "swayosd-server"], capture_output=True)
            h_res = subprocess.run(["hyprctl", "eval", 'hl.exec_cmd("swayosd-server")'], capture_output=True)
            if h_res.returncode != 0:
                subprocess.Popen(["swayosd-server"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            print("  \033[32m✓\033[0m SwayOSD restarted")

        # GSettings
        cursor = thm.get("cursor", "Bibata-Modern-Classic")
        icon = thm.get("icon", "Papirus-Dark")
        ui_font = fnt.get("ui", "Adwaita Sans 12")
        mono_font = f"{fnt.get('mono', 'JetBrainsMono Nerd Font Mono')} 12"
        gtk_theme = thm.get("gtk", "Adwaita-dark")

        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", cursor], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icon], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "font-name", ui_font], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_theme], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "monospace-font-name", mono_font], capture_output=True)
        print("  \033[32m✓\033[0m GNOME/GTK settings updated")

if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""
Central UI Style Generator & Applicator
Reads ~/.config/ui/ui.toml and compiles style definitions for:
- Hyprland (ui.lua & ui.conf)
- Quickshell (Theme.qml: launcher, keybindings, bar, notifications)
- Shell scripts (ui.sh)
- Ly (base + animation colors in config.ini, VT palette in startup.sh)
- Yazi (theme.toml)

Usage:
  apply-ui              # Generate configs and reload running apps
  apply-ui --no-reload  # Only generate configs without reloading
  apply-ui --check      # Verify that all generated files match ui.toml (exit 0/1)
"""

import sys
import os
import re
import tomllib
import subprocess
from pathlib import Path

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16) for i in (0, 2, 4))

def hex_to_hypr_rgba(hex_str, alpha="ee"):
    hex_str = hex_str.lstrip('#')
    return f"rgba({hex_str}{alpha})"

def hex_to_css_rgba(hex_str, alpha=0.6):
    r, g, b = hex_to_rgb(hex_str)
    return f"rgba({r}, {g}, {b}, {alpha})"

def hex_to_ly(hex_str, style="00"):
    return f"0x{style}{hex_str.lstrip('#').lower()}"


def hex_to_argb(hex_str):
    return f"0xFF{hex_str.lstrip('#').upper()}"

def get_config_path():
    candidates = [
        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "ui" / "ui.toml",
        Path.home() / ".files" / "archlinux" / ".config" / "ui" / "ui.toml",
    ]
    for c in candidates:
        if c.is_file():
            return c
    raise FileNotFoundError("Could not find ui.toml configuration file.")

def safe_write(path: Path, content: str, check_mode: bool = False) -> bool:
    # Resolve realpath so writes land in the dotfiles repo behind stow symlinks.
    # Non-strict resolve also follows dangling symlink chains (missing repo dirs).
    target = path.resolve(strict=False)
    if check_mode:
        if not target.exists():
            print(f"  \033[31m✗\033[0m Missing file: {target}")
            return False
        if target.read_text() != content:
            print(f"  \033[31m✗\033[0m Out of sync with ui.toml: {target}")
            return False
        print(f"  \033[32m✓\033[0m In sync: {target}")
        return True
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content)
    print(f"  \033[32m✓\033[0m Generated: {target}")
    return True

def main():
    check_mode = "--check" in sys.argv
    reload_apps = "--no-reload" not in sys.argv and not check_mode

    config_file = get_config_path()
    print(f"\033[34m[INFO]\033[0m Reading UI configuration from: {config_file}")

    with open(config_file, "rb") as f:
        cfg = tomllib.load(f)

    r = cfg.get("rounding", {})
    b = cfg.get("border", {})
    s = cfg.get("spacing", {})
    p = cfg.get("padding", {})
    o = cfg.get("opacity", {})
    fnt = cfg.get("font", {})
    thm = cfg.get("theme", {})
    c = cfg.get("colors", {})
    ly = cfg.get("ly", {})
    launcher = cfg.get("launcher", {})
    notif = cfg.get("notifications", {})

    r_win = r.get("window", 0)
    r_elem = r.get("element", 0)
    r_subtle = r.get("subtle", 0)
    b_size = b.get("size", 2)

    config_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))

    # 1. Hyprland: ui.lua
    lua_content = f"""-- Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
-- Modify ~/.config/ui/ui.toml and run 'apply-ui'.

return {{
    rounding = {{
        window = {r_win},
        element = {r_elem},
        subtle = {r_subtle},
    }},
    border = {{
        size = {b_size},
    }},
    spacing = {{
        gaps_in = {s.get("gaps_in", 10)},
        gaps_out = {s.get("gaps_out", 20)},
    }},
    opacity = {{
        active = {o.get("active", 1.0)},
        inactive = {o.get("inactive", 0.75)},
    }},
    font = {{
        family = "{fnt.get("family", "JetBrainsMono Nerd Font Propo")}",
        mono = "{fnt.get("mono", "JetBrainsMono Nerd Font Mono")}",
        ui = "{fnt.get("ui", "Adwaita Sans 12")}",
        size_bar = {fnt.get("size_bar", 15)},
        size_menu = {fnt.get("size_menu", 14)},
        size_notif = {fnt.get("size_notif", 17)},
        size_cursor = {fnt.get("size_cursor", 24)},
    }},
    theme = {{
        cursor = "{thm.get("cursor", "Bibata-Modern-Classic")}",
        icon = "{thm.get("icon", "Papirus-Dark")}",
        gtk = "{thm.get("gtk", "Adwaita-dark")}",
    }},
    colors = {{
        bg_main = "{c.get("bg_main", "#0d1117")}",
        bg_card = "{c.get("bg_card", "#161b22")}",
        bg_hover = "{c.get("bg_hover", "#21262d")}",
        border = "{hex_to_hypr_rgba(c.get("border", "#30363d"))}",
        accent_blue = "{hex_to_hypr_rgba(c.get("accent_blue", "#58a6ff"))}",
        accent_purple = "{hex_to_hypr_rgba(c.get("accent_purple", "#bc8cff"))}",
        accent_green = "{hex_to_hypr_rgba(c.get("accent_green", "#3fb950"))}",
        warning = "{hex_to_hypr_rgba(c.get("warning", "#d29922"))}",
        critical = "{hex_to_hypr_rgba(c.get("critical", "#f85149"))}",
        text_main = "{c.get("text_main", "#c9d1d9")}",
        text_dim = "{c.get("text_dim", "#8b949e")}",
        text_muted = "{c.get("text_muted", "#484f58")}",
        shadow = "{hex_to_hypr_rgba(c.get("shadow", "#010409"))}",
    }},
}}
"""
    r1 = safe_write(config_dir / "hypr" / "ui.lua", lua_content, check_mode)

    # 2. Hyprland / Hyprlock: ui.conf
    r_text, g_text, b_text = hex_to_rgb(c.get("text_main", "#c9d1d9"))
    r_card, g_card, b_card = hex_to_rgb(c.get("bg_card", "#161b22"))
    conf_content = f"""# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml and run 'apply-ui'.

$font = {fnt.get("family", "JetBrainsMono Nerd Font Propo")}
$rounding = {r_win}
$outline_thickness = {b_size}

$accent_blue = {hex_to_hypr_rgba(c.get("accent_blue", "#58a6ff"))}
$accent_purple = {hex_to_hypr_rgba(c.get("accent_purple", "#bc8cff"))}
$accent_green = {hex_to_hypr_rgba(c.get("accent_green", "#3fb950"))}
$warning = {hex_to_hypr_rgba(c.get("warning", "#d29922"))}
$critical = {hex_to_hypr_rgba(c.get("critical", "#f85149"))}
$text_main = rgb({r_text}, {g_text}, {b_text})
$inner_color = rgba({r_card}, {g_card}, {b_card}, 0.65)
"""
    r2 = safe_write(config_dir / "hypr" / "ui.conf", conf_content, check_mode)

    # 3. Shell environment: ui.sh
    bg_main = c.get("bg_main", "#0d1117")
    bg_card = c.get("bg_card", "#161b22")
    bg_hover = c.get("bg_hover", "#21262d")
    accent_blue = c.get("accent_blue", "#58a6ff")
    accent_purple = c.get("accent_purple", "#bc8cff")
    accent_green = c.get("accent_green", "#3fb950")
    warning = c.get("warning", "#d29922")
    critical = c.get("critical", "#f85149")
    border_color = c.get("border", "#30363d")
    text_main = c.get("text_main", "#c9d1d9")
    text_dim = c.get("text_dim", "#8b949e")
    fzf_theme = f"bg+:{bg_hover},bg:{bg_main},fg:{text_main},hl:{accent_blue},fg+:{text_main},hl+:{accent_blue},header:{accent_blue},info:{text_dim},pointer:{accent_blue},marker:{accent_green},prompt:{accent_blue},spinner:{accent_blue},border:{border_color}"

    slurp_args = f'-d -b "{bg_main}b0" -c "{accent_blue}" -s "{accent_blue}20" -w {b_size} -B "#00000000"'
    ui_sh = f"""# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml and run 'apply-ui'.
# Only vars with real consumers are exported here (grep ui.sh consumers
# before adding more).

export UI_ACCENT_GREEN="{accent_green}"
export UI_WARNING="{c.get("warning", "#d29922")}"
export UI_CRITICAL="{c.get("critical", "#f85149")}"
export UI_TEXT_MAIN="{text_main}"

export SLURP_OPTS='{slurp_args}'
# Array form for direct use in bash scripts (arrays cannot be exported).
# shellcheck disable=SC2034
SLURP_ARGS=({slurp_args})
export UI_FZF_THEME="{fzf_theme}"
"""
    r5 = safe_write(config_dir / "ui" / "ui.sh", ui_sh, check_mode)

    # 4. Ly display manager: sync base + animation colors with ui.toml
    ly_in_sync = True
    ly_startup_in_sync = True
    ly_config = config_dir / "ly" / "config.ini"
    # TTY-tuned glyph color (plain console washes out the bright Wayland blue).
    ly_glyph = ly.get("matrix_fg", accent_blue)
    ly_frame_delay = ly.get("frame_delay", 5)
    # Color addressing depends on the console ly runs on: kmscon is truecolor
    # (24-bit RGB values), while the plain kernel console supports 16 colors
    # only. In eight-color mode termbox2 ignores RGB and uses the low nibble
    # as the palette index (TB_BLACK=0x01..TB_WHITE=0x08,
    # TB_BRIGHT=0x40000000 for the bright half, TB_BOLD=0x01000000).
    # Slot order matches the _tty list in section 9:
    # 1=bg, 2=red, 3=green, 4=yellow, 5=blue, 6=magenta, 7=cyan, 8=text.
    ly_truecolor = bool(ly.get("full_color", True))
    ly_full_color = "true" if ly_truecolor else "false"
    def _ly_idx(base, bright=False, bold=False):
        v = base & 0x0F
        if bold:
            v |= 0x01000000
        if bright:
            v |= 0x40000000
        return f"0x{v:08x}"

    if ly_truecolor:
        _ly_colors = {
            "bg": hex_to_ly(bg_main),
            "border_fg": hex_to_ly(border_color),
            "fg": hex_to_ly(text_main),
            "error_fg": hex_to_ly(c.get("critical", "#f85149"), style="01"),
            "colormix_col1": hex_to_ly(bg_main),
            "colormix_col2": hex_to_ly(accent_blue),
            "colormix_col3": hex_to_ly(c.get("accent_purple", "#bc8cff")),
            "doom_top_color": hex_to_ly(ly.get("tty_purple_dark", "#8957e5")),
            "doom_middle_color": hex_to_ly(accent_blue),
            "doom_bottom_color": hex_to_ly(text_main),
            "cmatrix_fg": hex_to_ly(ly_glyph),
            "cmatrix_head_col": hex_to_ly(text_main, style="01"),
            "gameoflife_fg": hex_to_ly(ly_glyph),
        }
    else:
        _ly_colors = {
            "bg": _ly_idx(1),
            "border_fg": _ly_idx(1, bright=True),
            "fg": _ly_idx(8),
            "error_fg": _ly_idx(2, bright=True, bold=True),
            "colormix_col1": _ly_idx(1),
            "colormix_col2": _ly_idx(5, bright=True),
            "colormix_col3": _ly_idx(6, bright=True),
            "doom_top_color": _ly_idx(6),
            "doom_middle_color": _ly_idx(5, bright=True),
            "doom_bottom_color": _ly_idx(8),
            "cmatrix_fg": _ly_idx(5),
            "cmatrix_head_col": _ly_idx(8, bold=True),
            "gameoflife_fg": _ly_idx(5),
        }
    if ly_config.exists():
        target = ly_config.resolve()
        txt = target.read_text()
        new_txt = txt
        ly_colors = _ly_colors
        new_txt = re.sub(
            rf"^(animation_frame_delay\s*=\s*)\d+",
            rf"\g<1>{ly_frame_delay}",
            new_txt,
            flags=re.MULTILINE,
        )
        new_txt = re.sub(
            r"^(full_color\s*=\s*).*$",
            rf"\g<1>{ly_full_color}",
            new_txt,
            flags=re.MULTILINE,
        )
        for key, value in ly_colors.items():
            new_txt = re.sub(
                rf"^({key}\s*=\s*).*$",
                rf"\g<1>{value}",
                new_txt,
                flags=re.MULTILINE,
            )
        if check_mode:
            if txt != new_txt:
                print(f"  \033[31m✗\033[0m Out of sync with ui.toml: {target}")
                ly_in_sync = False
            else:
                print(f"  \033[32m✓\033[0m In sync: {target}")
        else:
            if txt != new_txt:
                target.write_text(new_txt)
                print(f"  \033[32m✓\033[0m Updated Ly colors in: {target}")

    # 9. Ly startup script: remap the 16-color Linux VT palette to the theme.
    # Executed by ly via start_cmd before the TTY is taken over. This is the
    # fallback for plain kernel VT (full_color=false, where ly addresses
    # these slots by index, see section 8). Under kmscon the TERM guard below
    # skips it, as kmscon renders truecolor directly.
    def _vt(hex_str):
        return hex_str.lstrip("#").lower()

    _tty = [
        bg_main,  # P0 black -> theme background (colormix base, box bg)
        c.get("critical", "#f85149"),  # P1 dark red (error text)
        c.get("accent_green", "#3fb950"),  # P2 dark green
        c.get("warning", "#d29922"),  # P3 dark yellow
        ly_glyph,  # P4 dark blue -> deep TTY-tuned blue (glyphs)
        ly.get("tty_purple_dark", "#8957e5"),  # P5 dark magenta (doom top)
        accent_blue,  # P6 dark cyan -> theme blue
        text_main,  # P7 light gray -> theme text
        border_color,  # P8 bright black -> theme border
        c.get("critical", "#f85149"),  # P9 bright red
        c.get("accent_green", "#3fb950"),  # PA bright green
        c.get("warning", "#d29922"),  # PB bright yellow
        accent_blue,  # PC bright blue (colormix mid)
        c.get("accent_purple", "#bc8cff"),  # PD bright magenta (colormix top)
        ly.get("tty_cyan_bright", "#79c0ff"),  # PE bright cyan
        ly.get("tty_white", "#f0f6fc"),  # PF white
    ]
    _palette_lines = "\n".join(
        f"    printf '\\033]P{X:X}{_vt(col)}'" for X, col in enumerate(_tty)
    )
    ly_startup = f"""#!/bin/sh
# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml ([colors], [ly]) and run 'apply-ui'.
# Remaps the 16-color Linux console palette to the theme so ly (which runs
# with full_color=false on TTY) renders colormix in theme colors.
# Executed by ly via start_cmd before the TTY is taken over.
set -eu
if [ "${{TERM:-linux}}" = "linux" ]; then
{_palette_lines}
    clear # fix background artifacting after palette change
fi
"""
    _startup_path = config_dir / "ly" / "startup.sh"
    if check_mode:
        _resolved = _startup_path.resolve() if _startup_path.exists() or _startup_path.is_symlink() else _startup_path
        if not _resolved.exists() or _resolved.read_text() != ly_startup:
            print(f"  \033[31m✗\033[0m Out of sync with ui.toml: {_resolved}")
            ly_startup_in_sync = False
        else:
            print(f"  \033[32m✓\033[0m In sync: {_resolved}")
    else:
        if safe_write(_startup_path, ly_startup, check_mode):
            _resolved = _startup_path.resolve()
            _resolved.chmod(0o755)
            print(f"  \033[32m✓\033[0m Made executable: {_resolved}")

    # 10. Yazi: theme.toml compiled from ui.toml colors.
    yazi_theme = f"""# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml ([colors]) and run 'apply-ui'.

[mgr]
cwd = {{ fg = "{accent_blue}", bold = true }}
syntect_theme = "~/.config/yazi/github-dark.tmTheme"

# Find
find_keyword  = {{ fg = "{accent_green}", bold = true, italic = true }}
find_position = {{ fg = "{accent_purple}", bg = "reset", bold = true }}

# Symlink
symlink_target = {{ fg = "{text_dim}", italic = true }}

# Marker
marker_copied   = {{ fg = "{accent_green}", bg = "{accent_green}" }}
marker_cut      = {{ fg = "{critical}", bg = "{critical}" }}
marker_marked   = {{ fg = "{accent_blue}", bg = "{accent_blue}" }}
marker_selected = {{ fg = "{warning}", bg = "{warning}" }}
marker_symbol   = "│"

# Count
count_copied   = {{ fg = "{bg_main}", bg = "{accent_green}", bold = true }}
count_cut      = {{ fg = "{bg_main}", bg = "{critical}", bold = true }}
count_selected = {{ fg = "{bg_main}", bg = "{warning}", bold = true }}

# Border
border_symbol = "│"
border_style  = {{ fg = "{border_color}" }}

[mode]
normal_main = {{ fg = "{bg_main}", bg = "{accent_blue}", bold = true }}
normal_alt  = {{ fg = "{accent_blue}", bg = "{bg_card}" }}

select_main = {{ fg = "{bg_main}", bg = "{accent_green}", bold = true }}
select_alt  = {{ fg = "{accent_green}", bg = "{bg_card}" }}

unset_main  = {{ fg = "{bg_main}", bg = "{critical}", bold = true }}
unset_alt   = {{ fg = "{critical}", bg = "{bg_card}" }}

[indicator]
parent  = {{ fg = "{accent_blue}", bg = "{bg_hover}" }}
current = {{ fg = "#ffffff", bg = "{bg_hover}", bold = true }}
preview = {{ underline = true }}

[status]
perm_sep   = {{ fg = "{border_color}" }}
perm_type  = {{ fg = "{accent_blue}" }}
perm_read  = {{ fg = "{warning}" }}
perm_write = {{ fg = "{critical}" }}
perm_exec  = {{ fg = "{accent_green}" }}

progress_label  = {{ fg = "{text_main}", bold = true }}
progress_normal = {{ fg = "{accent_blue}", bg = "{bg_card}" }}
progress_error  = {{ fg = "{critical}", bg = "{bg_card}" }}

[tabs]
active   = {{ fg = "{bg_main}", bg = "{accent_blue}", bold = true }}
inactive = {{ fg = "{text_dim}", bg = "{bg_card}" }}

[which]
border          = {{ fg = "{border_color}" }}
mask            = {{ bg = "{bg_card}" }}
cand            = {{ fg = "{accent_blue}" }}
rest            = {{ fg = "{text_dim}" }}
desc            = {{ fg = "{text_main}" }}
separator       = "  "
separator_style = {{ fg = "{border_color}" }}

[confirm]
border     = {{ fg = "{border_color}" }}
title      = {{ fg = "{accent_blue}", bold = true }}
btn_yes    = {{ fg = "{bg_main}", bg = "{accent_green}", bold = true }}
btn_no     = {{ fg = "{text_main}", bg = "{bg_hover}" }}

[input]
border   = {{ fg = "{accent_blue}" }}
selected = {{ bg = "{bg_hover}" }}

[cmp]
border   = {{ fg = "{border_color}" }}
active   = {{ fg = "{accent_blue}", bg = "{bg_hover}", bold = true }}

[tasks]
border  = {{ fg = "{border_color}" }}
title   = {{ fg = "{accent_blue}", bold = true }}
hovered = {{ bg = "{bg_hover}" }}

[help]
border  = {{ fg = "{border_color}" }}
chord   = {{ fg = "{accent_blue}" }}
hovered = {{ bg = "{bg_hover}", bold = true }}

[filetype]
rules = [
	# Media
	{{ mime = "**/image/*", fg = "{accent_purple}" }},
	{{ mime = "**/{{audio,video}}/*", fg = "{warning}" }},
	# Archive
	{{ mime = "**/application/{{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}}", fg = "{critical}" }},
	# Document
	{{ mime = "**/application/{{pdf,doc,docx,xls,xlsx,ppt,pptx}}", fg = "{accent_green}" }},
	# Executable
	{{ url = "*", is = "exec", fg = "{accent_green}", bold = true }},
	# Directory
	{{ url = "*/", fg = "{accent_blue}", bold = true }},
]
"""
    r6 = safe_write(config_dir / "yazi" / "theme.toml", yazi_theme, check_mode)

    # 11. Quickshell: Theme.qml compiled directly from ui.toml (native singleton, no JSON)
    qs_theme = f"""// Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
// Modify ~/.config/ui/ui.toml and run 'apply-ui'.
pragma Singleton
import Quickshell
import QtQuick

Singleton {{
	id: theme

	readonly property string bgMain: "{c.get("bg_main", "#0d1117")}"
	readonly property string bgCard: "{c.get("bg_card", "#161b22")}"
	readonly property string bgHover: "{c.get("bg_hover", "#21262d")}"
	readonly property string border: "{c.get("border", "#30363d")}"
	readonly property string accentBlue: "{c.get("accent_blue", "#58a6ff")}"
	readonly property string accentPurple: "{c.get("accent_purple", "#bc8cff")}"
	readonly property string accentGreen: "{c.get("accent_green", "#3fb950")}"
	readonly property string warning: "{c.get("warning", "#d29922")}"
	readonly property string critical: "{c.get("critical", "#f85149")}"
	readonly property string textMain: "{c.get("text_main", "#c9d1d9")}"
	readonly property string textDim: "{c.get("text_dim", "#8b949e")}"
	readonly property string textMuted: "{c.get("text_muted", "#484f58")}"
	readonly property string shadow: "{c.get("shadow", "#010409")}"

	// Color-coerced aliases + derived overlays (strings have no .r/.g/.b).
	readonly property color bgCardColor: bgCard
	readonly property color shadowColor: shadow
	readonly property color barStripColor: Qt.rgba(bgCardColor.r, bgCardColor.g, bgCardColor.b, 0.72)
	readonly property color overlayColor: Qt.rgba(bgCardColor.r, bgCardColor.g, bgCardColor.b, 0.92)
	readonly property color backdropColor: Qt.rgba(shadowColor.r, shadowColor.g, shadowColor.b, 0.55)

	readonly property int borderSize: {b_size}
	readonly property int roundingWindow: {r_win}
	readonly property int roundingElement: {r_elem}
	readonly property int paddingCard: {int(p.get("menu_card", 16))}
	readonly property int paddingItem: {int(p.get("menu_item", 8))}
	readonly property int windowWidth: {launcher.get("width", 960)}
	readonly property int windowHeight: {launcher.get("height", 600)}

	readonly property string fontFamily: "{fnt.get("family", "JetBrainsMono Nerd Font Propo")}"
	readonly property string fontMono: "{fnt.get("mono", "JetBrainsMono Nerd Font Mono")}"
	readonly property int fontSize: {fnt.get("size_notif", 17)}
	readonly property int fontSizeSmall: {fnt.get("size_menu", 14)}
	readonly property int fontSizeGrid: {fnt.get("size_grid", 13)}
	readonly property int fontSizeSearch: {fnt.get("size_search", fnt.get("size_bar", 15))}
	readonly property int fontSizeBar: {fnt.get("size_bar", 15)}
	readonly property int fontSizeBarIcon: {int(fnt.get("size_bar_icon", 18))}

	// Bar geometry: a single translucent strip with hover-highlighted modules.
	readonly property int barHeight: {s.get("bar_height", 30)}
	readonly property int barMarginX: {s.get("bar_margin_x", 20)}
	readonly property int barMarginY: {s.get("bar_margin_y", 4)}
	readonly property int barSpacing: {s.get("bar_spacing", 8)}
	readonly property int barPad: {int(p.get("bar_pad", 10))}

	// Notification surfaces: top-right panel below the bar.
	readonly property int notifWidth: {notif.get("width", 500)}
	readonly property int notifTopMargin: {notif.get("top_margin", 58)}
	readonly property int notifRightMargin: {s.get("gaps_out", 20)}
	readonly property int notifPadV: {int(p.get("notif_pad_v", 8))}
	readonly property int notifPadH: {int(p.get("notif_pad_h", 12))}

	readonly property color accent: accentBlue
	readonly property color selectionBg: Qt.rgba(accent.r, accent.g, accent.b, 0.15)
	readonly property color selectionBorder: Qt.rgba(accent.r, accent.g, accent.b, 0.45)
}}
"""
    r7 = safe_write(config_dir / "quickshell" / "Theme.qml", qs_theme, check_mode)

    if check_mode:
        all_ok = all([r1, r2, r5, r6, r7, ly_in_sync, ly_startup_in_sync])
        if all_ok:
            print("\033[32m[OK]\033[0m All UI configuration files are up to date with ui.toml.")
            sys.exit(0)
        else:
            print("\033[31m[FAIL]\033[0m Some generated UI files are missing or out of date. Run 'apply-ui' to regenerate.")
            sys.exit(1)

    print("\033[32m[OK]\033[0m All UI configuration files generated successfully.")

    # Reload applications
    if reload_apps:
        print("\033[34m[INFO]\033[0m Reloading running UI components...")
        
        # Hyprland
        res = subprocess.run(["pgrep", "-x", "Hyprland"], capture_output=True)
        if res.returncode == 0:
            subprocess.run(["hyprctl", "reload"], capture_output=True)
            print("  \033[32m✓\033[0m Hyprland reloaded")

        # Quickshell live-reloads QML and Theme.qml changes.

        # GSettings
        cursor = thm.get("cursor", "Bibata-Modern-Classic")
        icon = thm.get("icon", "Papirus-Dark")
        ui_font = fnt.get("ui", "Adwaita Sans 12")
        mono_font = f"{fnt.get('mono', 'JetBrainsMono Nerd Font Mono')} 12"
        gtk_theme = thm.get("gtk", "Adwaita-dark")

        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", cursor], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icon], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "font-name", ui_font], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", gtk_theme], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "monospace-font-name", mono_font], capture_output=True)
        print("  \033[32m✓\033[0m GNOME/GTK settings updated")

if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hypr_rgba(h, alpha="ee"):
    return f"rgba({h.lstrip('#')}{alpha})"


def ly_color(h, style="00"):
    return f"0x{style}{h.lstrip('#').lower()}"


def write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    print(f"  \033[32m✓\033[0m Generated: {path}")


def main():
    with open(CONFIG_DIR / "ui" / "ui.toml", "rb") as f:
        cfg = tomllib.load(f)

    r, b, s, p, o = (cfg[k] for k in ("rounding", "border", "spacing", "padding", "opacity"))
    fnt, thm, c = cfg["font"], cfg["theme"], cfg["colors"]
    hl_lock, ly, launcher = cfg["hyprlock"], cfg["ly"], cfg["launcher"]
    notif, anim = cfg["notifications"], cfg["animations"]

    bg_main, bg_card, bg_hover = c["bg_main"], c["bg_card"], c["bg_hover"]
    border_color = c["border"]
    accent_blue, accent_purple, accent_green = c["accent_blue"], c["accent_purple"], c["accent_green"]
    warning, critical = c["warning"], c["critical"]
    text_main, text_dim = c["text_main"], c["text_dim"]
    r_win, r_elem, r_subtle, r_power = r["window"], r["element"], r["subtle"], r["power"]
    b_size = b["size"]

    lua_content = f"""-- Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
-- Modify ~/.config/ui/ui.toml and run 'apply-ui'.

return {{
    rounding = {{
        window = {r_win},
        element = {r_elem},
        subtle = {r_subtle},
        power = {r_power},
    }},
    border = {{
        size = {b_size},
    }},
    spacing = {{
        gaps_in = {s["gaps_in"]},
        gaps_out = {s["gaps_out"]},
    }},
    opacity = {{
        active = {o["active"]},
        inactive = {o["inactive"]},
        dim_special = {o["dim_special"]},
    }},
    font = {{
        family = "{fnt["family"]}",
        mono = "{fnt["mono"]}",
        ui = "{fnt["ui"]}",
        size_bar = {fnt["size_bar"]},
        size_menu = {fnt["size_menu"]},
        size_notif = {fnt["size_notif"]},
        size_cursor = {fnt["size_cursor"]},
    }},
    theme = {{
        cursor = "{thm["cursor"]}",
        icon = "{thm["icon"]}",
        gtk = "{thm["gtk"]}",
    }},
    colors = {{
        bg_main = "{bg_main}",
        bg_card = "{bg_card}",
        bg_hover = "{bg_hover}",
        border = "{hypr_rgba(border_color)}",
        accent_blue = "{hypr_rgba(accent_blue)}",
        accent_purple = "{hypr_rgba(accent_purple)}",
        accent_green = "{hypr_rgba(accent_green)}",
        warning = "{hypr_rgba(warning)}",
        critical = "{hypr_rgba(critical)}",
        text_main = "{text_main}",
        text_dim = "{text_dim}",
        text_muted = "{c["text_muted"]}",
        shadow = "{hypr_rgba(c["shadow"])}",
    }},
}}
"""
    write(CONFIG_DIR / "hypr" / "ui.lua", lua_content)

    r_text, g_text, b_text = hex_to_rgb(text_main)
    r_card, g_card, b_card = hex_to_rgb(bg_card)
    conf_content = f"""# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml and run 'apply-ui'.

$font = {fnt["family"]}
$rounding = {r_win}
$rounding_power = {r_power}
$outline_thickness = {b_size}

$accent_blue = {hypr_rgba(accent_blue)}
$accent_purple = {hypr_rgba(accent_purple)}
$accent_green = {hypr_rgba(accent_green)}
$warning = {hypr_rgba(warning)}
$critical = {hypr_rgba(critical)}
$text_main = rgb({r_text}, {g_text}, {b_text})
$inner_color = rgba({r_card}, {g_card}, {b_card}, 0.65)

$hyprlock_blur_size = {hl_lock["blur_size"]}
$hyprlock_blur_passes = {hl_lock["blur_passes"]}
$hyprlock_noise = {hl_lock["noise"]}
$hyprlock_contrast = {hl_lock["contrast"]}
$hyprlock_brightness = {hl_lock["brightness"]}
$hyprlock_vibrancy = {hl_lock["vibrancy"]}
$hyprlock_vibrancy_darkness = {hl_lock["vibrancy_darkness"]}
"""
    write(CONFIG_DIR / "hypr" / "ui.conf", conf_content)

    fzf_theme = (
        f"bg+:{bg_hover},bg:{bg_main},fg:{text_main},hl:{accent_blue},fg+:{text_main},"
        f"hl+:{accent_blue},header:{accent_blue},info:{text_dim},pointer:{accent_blue},"
        f"marker:{accent_green},prompt:{accent_blue},spinner:{accent_blue},border:{border_color}"
    )
    slurp_args = f'-d -b "{bg_main}b0" -c "{accent_blue}" -s "{accent_blue}20" -w {b_size} -B "#00000000"'
    ui_sh = f"""# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml and run 'apply-ui'.
# Only vars with real consumers are exported here (grep ui.sh consumers
# before adding more).

export UI_ACCENT_GREEN="{accent_green}"
export UI_WARNING="{warning}"
export UI_CRITICAL="{critical}"
export UI_TEXT_MAIN="{text_main}"

# Sourced, not exported: arrays cannot be exported.
# shellcheck disable=SC2034
SLURP_ARGS=({slurp_args})
export UI_FZF_THEME="{fzf_theme}"
"""
    write(CONFIG_DIR / "ui" / "ui.sh", ui_sh)

    ly_glyph = ly["matrix_fg"]

    def ly_idx(base, bright=False, bold=False):
        v = base & 0x0F
        if bold:
            v |= 0x01000000
        if bright:
            v |= 0x40000000
        return f"0x{v:08x}"

    ly_spec = (
        ("bg", ly_color(bg_main), (1, False, False)),
        ("border_fg", ly_color(border_color), (1, True, False)),
        ("fg", ly_color(text_main), (8, False, False)),
        ("error_fg", ly_color(critical, style="01"), (2, True, True)),
        ("colormix_col1", ly_color(bg_main), (1, False, False)),
        ("colormix_col2", ly_color(accent_blue), (5, True, False)),
        ("colormix_col3", ly_color(accent_purple), (6, True, False)),
        ("doom_top_color", ly_color(ly["tty_purple_dark"]), (6, False, False)),
        ("doom_middle_color", ly_color(accent_blue), (5, True, False)),
        ("doom_bottom_color", ly_color(text_main), (8, False, False)),
        ("cmatrix_fg", ly_color(ly_glyph), (5, False, False)),
        ("cmatrix_head_col", ly_color(text_main, style="01"), (8, False, True)),
        ("gameoflife_fg", ly_color(ly_glyph), (5, False, False)),
    )
    ly_settings = {
        "animation_frame_delay": ly["frame_delay"],
        "full_color": "true" if ly["full_color"] else "false",
        **{k: (true if ly["full_color"] else ly_idx(*idx)) for k, true, idx in ly_spec},
    }
    ly_config = CONFIG_DIR / "ly" / "config.ini"
    txt = ly_config.read_text()
    new_txt = txt
    for key, value in ly_settings.items():
        new_txt = re.sub(rf"^({key}\s*=\s*).*$", rf"\g<1>{value}", new_txt, flags=re.MULTILINE)
    if new_txt != txt:
        ly_config.write_text(new_txt)
        print(f"  \033[32m✓\033[0m Updated Ly colors in: {ly_config}")

    tty = [
        bg_main, critical, accent_green, warning, ly_glyph, ly["tty_purple_dark"], accent_blue, text_main,
        border_color, critical, accent_green, warning, accent_blue, accent_purple,
        ly["tty_cyan_bright"], ly["tty_white"],
    ]
    palette_lines = "\n".join(f"    printf '\\033]P{i:X}{col.lstrip('#').lower()}'" for i, col in enumerate(tty))
    ly_startup = f"""#!/bin/sh
# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml ([colors], [ly]) and run 'apply-ui'.
# Remaps the 16-color Linux console palette to the theme so ly (which runs
# with full_color=false on TTY) renders colormix in theme colors.
# Executed by ly via start_cmd before the TTY is taken over.
set -eu
if [ "${{TERM:-linux}}" = "linux" ]; then
{palette_lines}
    clear # fix background artifacting after palette change
fi
"""
    startup_path = CONFIG_DIR / "ly" / "startup.sh"
    write(startup_path, ly_startup)
    startup_path.chmod(0o755)

    yazi_theme = f"""# Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
# Modify ~/.config/ui/ui.toml ([colors]) and run 'apply-ui'.

[mgr]
cwd = {{ fg = "{accent_blue}", bold = true }}
syntect_theme = "~/.config/yazi/github-dark.tmTheme"

# Find
find_keyword  = {{ fg = "{accent_green}", bold = true, italic = true }}
find_position = {{ fg = "{accent_purple}", bg = "reset", bold = true }}

# Symlink
symlink_target = {{ fg = "{text_dim}", italic = true }}

# Marker
marker_copied   = {{ fg = "{bg_main}", bg = "{accent_green}" }}
marker_cut      = {{ fg = "{bg_main}", bg = "{critical}" }}
marker_marked   = {{ fg = "{bg_main}", bg = "{accent_blue}" }}
marker_selected = {{ fg = "{bg_main}", bg = "{warning}" }}
marker_symbol   = "│"

# Count
count_copied   = {{ fg = "{bg_main}", bg = "{accent_green}", bold = true }}
count_cut      = {{ fg = "{bg_main}", bg = "{critical}", bold = true }}
count_selected = {{ fg = "{bg_main}", bg = "{warning}", bold = true }}

# Border
border_symbol = "│"
border_style  = {{ fg = "{border_color}" }}

[mode]
normal_main = {{ fg = "{bg_main}", bg = "{accent_blue}", bold = true }}
normal_alt  = {{ fg = "{accent_blue}", bg = "{bg_card}" }}

select_main = {{ fg = "{bg_main}", bg = "{accent_green}", bold = true }}
select_alt  = {{ fg = "{accent_green}", bg = "{bg_card}" }}

unset_main  = {{ fg = "{bg_main}", bg = "{critical}", bold = true }}
unset_alt   = {{ fg = "{critical}", bg = "{bg_card}" }}

[indicator]
parent  = {{ fg = "{accent_blue}", bg = "{bg_hover}" }}
current = {{ fg = "{text_main}", bg = "{bg_hover}", bold = true }}
preview = {{ underline = true }}

[status]
perm_sep   = {{ fg = "{border_color}" }}
perm_type  = {{ fg = "{accent_blue}" }}
perm_read  = {{ fg = "{warning}" }}
perm_write = {{ fg = "{critical}" }}
perm_exec  = {{ fg = "{accent_green}" }}

progress_label  = {{ fg = "{text_main}", bold = true }}
progress_normal = {{ fg = "{accent_blue}", bg = "{bg_card}" }}
progress_error  = {{ fg = "{critical}", bg = "{bg_card}" }}

[tabs]
active   = {{ fg = "{bg_main}", bg = "{accent_blue}", bold = true }}
inactive = {{ fg = "{text_dim}", bg = "{bg_card}" }}

[which]
border          = {{ fg = "{border_color}" }}
mask            = {{ bg = "{bg_card}" }}
cand            = {{ fg = "{accent_blue}" }}
rest            = {{ fg = "{text_dim}" }}
desc            = {{ fg = "{text_main}" }}
separator       = "  "
separator_style = {{ fg = "{border_color}" }}

[confirm]
border     = {{ fg = "{border_color}" }}
title      = {{ fg = "{accent_blue}", bold = true }}
btn_yes    = {{ fg = "{bg_main}", bg = "{accent_green}", bold = true }}
btn_no     = {{ fg = "{text_main}", bg = "{bg_hover}" }}

[input]
border   = {{ fg = "{accent_blue}" }}
selected = {{ bg = "{bg_hover}" }}

[cmp]
border   = {{ fg = "{border_color}" }}
active   = {{ fg = "{accent_blue}", bg = "{bg_hover}", bold = true }}

[tasks]
border  = {{ fg = "{border_color}" }}
title   = {{ fg = "{accent_blue}", bold = true }}
hovered = {{ bg = "{bg_hover}" }}

[help]
border  = {{ fg = "{border_color}" }}
chord   = {{ fg = "{accent_blue}" }}
hovered = {{ bg = "{bg_hover}", bold = true }}

[filetype]
rules = [
	# Media
	{{ mime = "**/image/*", fg = "{accent_purple}" }},
	{{ mime = "**/{{audio,video}}/*", fg = "{warning}" }},
	# Archive
	{{ mime = "**/application/{{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}}", fg = "{critical}" }},
	# Document
	{{ mime = "**/application/{{pdf,doc,docx,xls,xlsx,ppt,pptx}}", fg = "{accent_green}" }},
	# Executable
	{{ url = "*", is = "exec", fg = "{accent_green}", bold = true }},
	# Directory
	{{ url = "*/", fg = "{accent_blue}", bold = true }},
]
"""
    write(CONFIG_DIR / "yazi" / "theme.toml", yazi_theme)

    qs_theme = f"""// Auto-generated by apply-ui. DO NOT EDIT DIRECTLY.
// Modify ~/.config/ui/ui.toml and run 'apply-ui'.
pragma Singleton
import Quickshell
import QtQuick

Singleton {{
	id: theme

	readonly property string bgMain: "{bg_main}"
	readonly property string bgCard: "{bg_card}"
	readonly property string bgHover: "{bg_hover}"
	readonly property string border: "{border_color}"
	readonly property string accentBlue: "{accent_blue}"
	readonly property string accentPurple: "{accent_purple}"
	readonly property string accentGreen: "{accent_green}"
	readonly property string warning: "{warning}"
	readonly property string critical: "{critical}"
	readonly property string textMain: "{text_main}"
	readonly property string textDim: "{text_dim}"
	readonly property string textMuted: "{c["text_muted"]}"
	readonly property string shadow: "{c["shadow"]}"

	// Color-coerced aliases + derived overlays (strings have no .r/.g/.b).
	readonly property color bgCardColor: bgCard
	readonly property color barStripColor: Qt.rgba(bgCardColor.r, bgCardColor.g, bgCardColor.b, 0.85)
	readonly property color overlayColor: Qt.rgba(bgCardColor.r, bgCardColor.g, bgCardColor.b, 0.94)
	readonly property real backdropDim: {o["dim_special"]}
	readonly property color backdropColor: Qt.rgba(0, 0, 0, backdropDim)

	readonly property int borderSize: {b_size}
	readonly property int roundingWindow: {r_win}
	readonly property int roundingElement: {r_elem}
	readonly property int roundingSubtle: {r_subtle}
	readonly property int paddingCard: {p["menu_card"]}
	readonly property int paddingItem: {p["menu_item"]}
	readonly property int windowWidth: {launcher["width"]}
	readonly property int windowHeight: {launcher["height"]}

	readonly property string fontFamily: "{fnt["family"]}"
	readonly property string fontMono: "{fnt["mono"]}"
	readonly property int fontSize: {fnt["size_notif"]}
	readonly property int fontSizeSmall: {fnt["size_menu"]}
	readonly property int fontSizeGrid: {fnt["size_grid"]}
	readonly property int fontSizeSearch: {fnt["size_search"]}
	readonly property int fontSizeBar: {fnt["size_bar"]}
	readonly property int fontSizeBarIcon: {fnt["size_bar_icon"]}

	// Bar geometry: a single translucent strip with hover-highlighted modules.
	readonly property int barHeight: {s["bar_height"]}
	readonly property int barMarginX: {s["bar_margin_x"]}
	readonly property int barMarginY: {s["bar_margin_y"]}
	readonly property int barSpacing: {s["bar_spacing"]}
	readonly property int barPad: {p["bar_pad"]}

	// Notification surfaces: top-right panel below the bar.
	readonly property int notifWidth: {notif["width"]}
	readonly property int notifTopMargin: {notif["top_margin"]}
	readonly property int notifRightMargin: {s["gaps_out"]}
	readonly property int notifPadV: {p["notif_pad_v"]}
	readonly property int notifPadH: {p["notif_pad_h"]}

	readonly property color accent: accentBlue
	function alpha(c, a) {{
		var q = Qt.color(c);
		return Qt.rgba(q.r, q.g, q.b, a);
	}}
	readonly property color selectionBg: Qt.rgba(accent.r, accent.g, accent.b, 0.12)
	readonly property color selectionBorder: Qt.rgba(accent.r, accent.g, accent.b, 0.45)

	// Animation durations & physics matching Hyprland curves.
	readonly property int animFast: {anim["duration_fast"]}
	readonly property int animNormal: {anim["duration_normal"]}
	readonly property int animSmooth: {anim["duration_smooth"]}
	readonly property int flickDecel: {anim["flick_deceleration"]}
	readonly property int maxFlickVel: {anim["max_flick_velocity"]}

	// Cubic bezier control points matching Hyprland:
	// myBezier = {{ {{ 0.05, 0.9 }}, {{ 0.1, 1.05 }} }} (popin with subtle 1.05 bounce)
	readonly property var myBezier: [ 0.05, 0.9, 0.1, 1.05, 1.0, 1.0 ]
	// easeOutQuint = {{ {{ 0.23, 1 }}, {{ 0.32, 1 }} }}
	readonly property var easeOutQuint: [ 0.23, 1.0, 0.32, 1.0, 1.0, 1.0 ]
}}

"""
    write(CONFIG_DIR / "quickshell" / "Theme.qml", qs_theme)

    if "--no-reload" in sys.argv:
        return

    print("\033[34m[INFO]\033[0m Reloading running UI components...")
    if subprocess.run(["pgrep", "-x", "Hyprland"], capture_output=True).returncode == 0:
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        subprocess.run([str(Path.home() / ".local/bin/power-save"), "--reapply"], capture_output=True)
        print("  \033[32m✓\033[0m Hyprland reloaded")

    gsettings = {
        "cursor-theme": thm["cursor"],
        "icon-theme": thm["icon"],
        "font-name": fnt["ui"],
        "gtk-theme": thm["gtk"],
        "monospace-font-name": f"{fnt['mono']} 12",
    }
    for key, value in gsettings.items():
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, value], capture_output=True)
    print("  \033[32m✓\033[0m GNOME/GTK settings updated")


if __name__ == "__main__":
    main()

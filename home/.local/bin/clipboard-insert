#!/bin/sh
# Paste a cliphist entry into the focused app via clipboard + Shift+Insert.
# Shift+Insert works in both GUI and terminals, unlike Ctrl+V.
set -eu
id="${1:-}"
mime="${2:-}"
[ -n "$id" ] || exit 0
# Clipboard contents may be secrets: private temp file, removed on any exit.
tmp="$(mktemp "${TMPDIR:-/tmp}/clipboard-insert.XXXXXX.bin")"
chmod 600 "$tmp"
trap 'rm -f "$tmp"' EXIT INT TERM HUP
cliphist decode "$id" >"$tmp" || exit 0
if [ -n "$mime" ]; then
    wl-copy --type "$mime" <"$tmp" || exit 0
else
    wl-copy <"$tmp" || exit 0
fi
rm -f "$tmp"
trap - EXIT INT TERM HUP
sleep 0.05
wtype -M shift -k Insert -m shift 2>/dev/null || true

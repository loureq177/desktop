#!/bin/sh
set -eu

id="${1:-}"
mime="${2:-}"

[ -n "$id" ] || exit 0

tmp="$(mktemp "${TMPDIR:-/tmp}/clipboard-insert.XXXXXX.bin")"

chmod 600 "$tmp"
trap 'rm -f "$tmp"' EXIT INT TERM HUP
cliphist decode "$id" >"$tmp" || exit 0

if [ -n "$mime" ]; then
    wl-copy --type "$mime" <"$tmp" || exit 0
else
    wl-copy <"$tmp" || exit 0
fi

rm -f "$tmp"
trap - EXIT INT TERM HUP
sleep 0.05
# A terminal pastes the selection on Shift+Insert, the clipboard on Ctrl+Shift+V.
case "$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""')" in
*ghostty* | *kitty* | *foot* | *Alacritty* | *wezterm*) wtype -M ctrl -M shift -k v -m shift -m ctrl 2>/dev/null || true ;;
*) wtype -M shift -k Insert -m shift 2>/dev/null || true ;;
esac

#!/bin/sh
# Paste a cliphist entry into the focused app via clipboard + Shift+Insert.
# Shift+Insert works in both GUI and terminals, unlike Ctrl+V.
set -eu
id="${1:-}"
mime="${2:-}"
[ -n "$id" ] || exit 0
tmp="${TMPDIR:-/tmp}/clipboard-insert.$$.bin"
if [ -n "$mime" ]; then
    cliphist decode "$id" >"$tmp" || {
        rm -f "$tmp"
        exit 0
    }
    wl-copy --type "$mime" <"$tmp" || {
        rm -f "$tmp"
        exit 0
    }
else
    cliphist decode "$id" >"$tmp" || {
        rm -f "$tmp"
        exit 0
    }
    wl-copy <"$tmp" || {
        rm -f "$tmp"
        exit 0
    }
fi
rm -f "$tmp"
sleep 0.05
wtype -M shift -k Insert -m shift 2>/dev/null || true

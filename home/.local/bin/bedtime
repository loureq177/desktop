#!/usr/bin/env bash
set -euo pipefail

notify_bed() {
    notify-send \
        --app-name "Bedtime" \
        -t 5000 "Bedtime" \
        -i "weather-clear-night" \
        "$1" 2>/dev/null || true
}

MARKER="${XDG_STATE_HOME:-$HOME/.local/state}/bedtime/wifi-off"

set_wifi() {
    local current
    current="$(timeout 5 nmcli radio wifi 2>/dev/null || echo unknown)"
    case "$1" in
    off)
        if [ "$current" = "enabled" ]; then
            timeout 5 nmcli radio wifi off 2>/dev/null || return 0
            mkdir -p "$(dirname "$MARKER")"
            : >"$MARKER"
        fi
        ;;
    on)
        [ -f "$MARKER" ] || return 0
        if [ "$current" != "enabled" ]; then
            timeout 5 nmcli radio wifi on 2>/dev/null || return 0
        fi
        rm -f "$MARKER"
        ;;
    esac
}

hour=$((10#$(date +%H)))
minute=$((10#$(date +%M)))
now=$((hour * 60 + minute))
curfew=$((22 * 60))

if [ "$now" -ge "$curfew" ]; then
    if [ "$now" -lt $((curfew + 15)) ]; then
        notify_bed "WiFi has been turned off."
    fi
    set_wifi "off"
elif [ "$hour" -eq 21 ] && [ "$minute" -ge 45 ]; then
    notify_bed "WiFi will turn off in $((curfew - now)) minutes."
    set_wifi "on"
else
    set_wifi "on"
fi

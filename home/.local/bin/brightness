#!/usr/bin/env bash
set -euo pipefail

command -v brightnessctl >/dev/null 2>&1 || exit 0
timeout 5 brightnessctl -c backlight -m 2>/dev/null | grep -q . || exit 0

ACTION="${1:-}"
case "$ACTION" in
up) timeout 5 brightnessctl set +10% >/dev/null 2>&1 ;;
down) timeout 5 brightnessctl set 10%- >/dev/null 2>&1 ;;
*) echo "brightness: want up|down" >&2; exit 2 ;;
esac

PCT="$(timeout 5 brightnessctl -c backlight -m 2>/dev/null | head -n 1 | cut -d, -f4 | tr -dc '0-9')"
[[ -z "$PCT" ]] && PCT=0

qs ipc call osd brightness "$PCT" || true
qs ipc call quicksettings refresh >/dev/null 2>&1 || true

#!/usr/bin/env bash
# Backs up $HOME to Google Drive via rclone with exclusion filters (skips caches, dotfiles, venvs).
set -euo pipefail

LOCKFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rclone-sync.lock"
exec 200>"$LOCKFILE"
if ! flock -n 200; then
    echo "Another rclone sync is already running. Exiting."
    exit 0
fi

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rclone/backup.conf"
# Only honour known keys — never `source` the file, so a stray/modified
# backup.conf cannot execute arbitrary shell code with user privileges.
if [[ -f "$CONFIG_FILE" ]]; then
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        # Trim surrounding whitespace; skip blanks/comments.
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ -z "$key" || "$key" == \#* ]] && continue
        case "$key" in
        RCLONE_BACKUP_SOURCE|RCLONE_BACKUP_REMOTE)
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"
            # Strip one layer of matching single/double quotes, if present.
            if [[ ${#value} -ge 2 ]]; then
                case "$value" in
                \"*\"|\'*\') value="${value:1:-1}" ;;
                esac
            fi
            printf -v "$key" '%s' "$value"
            ;;
        *) echo "rclone-sync: ignoring unknown key '$key' in $CONFIG_FILE" >&2 ;;
        esac
    done <"$CONFIG_FILE"
fi

source_root="${RCLONE_BACKUP_SOURCE:-$HOME}"
remote_root="${RCLONE_BACKUP_REMOTE:-google-drive-backup:mlorenc-backup}"

excludes=(
    "--exclude=.*/**"
    "--exclude=.*"
    "--exclude=node_modules/**"
    "--exclude=.venv/**"
    "--exclude=venv/**"
    "--exclude=__pycache__/**"
    "--exclude=dist/**"
    "--exclude=build/**"
    "--exclude=target/**"
    "--exclude=.next/**"
    "--exclude=.idea/**"
    "--exclude=.vscode/**"
)

# --progress redraws a status block several times a second: fine on a
# terminal, pure journal spam under the systemd timer.
progress=()
[[ -t 1 ]] && progress=(--progress)

echo "Syncing: $source_root -> $remote_root"
# Capture rclone's own status: `if ! cmd` reports the negation's status (0),
# which made the failure branch exit 0 and hid failures from systemd.
rc=0
rclone sync \
    "$source_root" \
    "$remote_root" \
    "${excludes[@]}" \
    "${progress[@]}" \
    --drive-chunk-size 128M \
    --transfers 8 \
    --checkers 8 \
    --buffer-size 32M \
    --fast-list \
    --track-renames \
    --drive-use-trash=true \
    --verbose || rc=$?

if [ "$rc" -ne 0 ]; then
    notify-send --app-name "Rclone" -t 5000 "Rclone" -i "dialog-error" "Rclone Sync failed. Check the logs for details"
    exit "$rc"
fi

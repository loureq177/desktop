#!/usr/bin/env bash
# phone-cam [front]: the phone's camera as this computer's webcam (/dev/video10), over
# Wi-Fi; run again, it stops. The back camera unless told otherwise.
#
# Once on the phone: Developer options > Wireless debugging > Pair device with pairing
# code, then here: adb pair IP:PORT. After that Wireless debugging only has to be on.
set -euo pipefail

UNIT="phone-cam.service"
MARKER="$XDG_RUNTIME_DIR/phone_cam"
SINK=/dev/video10

say() { notify-send --app-name "Phone camera" -i camera-web "$@"; }

if [[ "${1:-}" == --run ]]; then
    trap 'rm -f "$MARKER"' EXIT
    touch "$MARKER"
    errors="$(mktemp)"
    if ! scrcpy --serial="$2" --video-source=camera --camera-facing="$3" --camera-size=1920x1080 \
        --video-bit-rate=8M --no-audio --no-window --v4l2-sink="$SINK" 2> >(tee "$errors" >&2); then
        say "The camera stopped" "$(grep -m1 ERROR "$errors" || echo "Is the phone unlocked and on this network?")"
    fi
    rm -f "$errors"
    exit 0
fi

exec 200>"$XDG_RUNTIME_DIR/phone_cam.lock"
flock -w 2 200 || exit 0

if systemctl --user is-active --quiet "$UNIT"; then
    systemctl --user stop "$UNIT"
    exit 0
fi

if [[ ! -c "$SINK" ]]; then
    say "No virtual webcam" "$SINK is missing: run install.sh, or sudo modprobe v4l2loopback"
    exit 1
fi

# The phone adb has, or one the network announces (paired, Wireless debugging on).
phone() { adb devices | awk 'NR > 1 && $2 == "device" { print $1; exit }'; }
adb start-server >/dev/null 2>&1
serial="$(phone)"
if [[ -z "$serial" ]]; then
    while read -r address; do
        adb connect "$address" >/dev/null 2>&1 || true
    done < <(adb mdns services | awk '/_adb-tls-connect/ { print $NF }')
    sleep 1
    serial="$(phone)"
fi
if [[ -z "$serial" ]]; then
    say "No phone found" "Turn on Wireless debugging, on the same network. The first time: adb pair IP:PORT"
    exit 1
fi

systemd-run --user --unit="${UNIT%.service}" --collect "$0" --run "$serial" "${1:-back}" >/dev/null 2>&1
say "Camera on" "Pick \"Phone Camera\" in the app. Run it again to stop."

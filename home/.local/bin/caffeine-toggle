#!/usr/bin/env bash
# Toggles idle inhibition via systemd-inhibit and signals quickshell.
set -euo pipefail

INHIBIT_PID_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/caffeine_inhibit.pid"

_is_active() {
    [[ -f "$INHIBIT_PID_FILE" ]] && kill -0 "$(<"$INHIBIT_PID_FILE")" 2>/dev/null
}

if [[ "${1:-}" == "--status" ]]; then
    _is_active && echo "on" || echo "off"
    exit 0
fi

if _is_active; then
    pid="$(<"$INHIBIT_PID_FILE")"
    # PID file holds systemd-inhibit itself (see below), whose PGID == PID
    # for a background job. Kill the whole group so the `sleep infinity`
    # child dies too; fall back to plain kill if group kill is unavailable.
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    # Reap if it was our child; otherwise poll until it exits.
    wait "$pid" 2>/dev/null || true
    for _ in {1..20}; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.05
    done
    rm -f "$INHIBIT_PID_FILE"
else
    # No setsid: $! must be systemd-inhibit's PID so stop() can kill it.
    # (setsid forks when it is a group leader, making $! stale.) disown
    # already detaches the job from this short-lived script; no TTY HUP
    # applies when launched from a Hyprland keybind.
    systemd-inhibit --what=idle --who=caffeine \
        --why="User requested stay awake" --mode=block \
        sleep infinity >/dev/null 2>&1 &
    echo $! >"$INHIBIT_PID_FILE"
    disown
    for _ in {1..10}; do
        [[ -f "$INHIBIT_PID_FILE" ]] && break
        sleep 0.005
    done
fi

qs ipc call quicksettings refresh >/dev/null 2>&1 || true

#!/usr/bin/env bash
set -uo pipefail

get_volume() {
    timeout 1 wpctl get-volume "@DEFAULT_AUDIO_${1}@" 2>/dev/null || true
}

last_sink="$(get_volume SINK)"
last_source="$(get_volume SOURCE)"

while IFS= read -r line; do
    case "$line" in
    *"on sink"* | *"on card"* | *"on server"*)
        out="$(get_volume SINK)"
        [[ -n "$out" && "$out" != "$last_sink" ]] || continue
        last_sink="$out"
        [[ "$out" =~ Volume:[[:space:]]+([0-9]+)\.([0-9]{2}) ]] || continue
        pct=$((10#${BASH_REMATCH[1]} * 100 + 10#${BASH_REMATCH[2]}))
        muted=false
        [[ "$out" == *"[MUTED]"* ]] && muted=true
        qs ipc call osd volume "$pct" "$muted" >/dev/null 2>&1 &
        qs ipc call quicksettings refresh >/dev/null 2>&1 &
        ;;
    *"on source"*)
        out="$(get_volume SOURCE)"
        [[ -n "$out" && "$out" != "$last_source" ]] || continue
        last_source="$out"
        muted=false
        [[ "$out" == *"[MUTED]"* ]] && muted=true
        qs ipc call osd mic "$muted" >/dev/null 2>&1 &
        ;;
    esac
done < <(exec pactl subscribe 2>/dev/null)

#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/lib/dotfiles/capture.sh"
single_instance screenshot_slurp

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
BASE="$DIR/$(date +'%Y-%m-%d_%H-%M-%S')"
FILE="$BASE.png"
if [[ -e "$FILE" ]]; then
    n=1
    while [[ -e "$BASE-$n.png" ]]; do
        n=$((n + 1))
    done
    FILE="$BASE-$n.png"
fi

trap stop_picker EXIT

# PNG at compression level 1: a 1440p screen in 0.2 s instead of the 1 s the
# default 6 takes, for a file a fifth larger.
GRIM=(timeout 5 grim -l 1)

# The monitor the pointer is on, or every monitor when it is unknown.
grab_screen() {
    local output
    output=$(focused_output)
    if [[ -n "$output" ]]; then
        "${GRIM[@]}" -o "$output" "$FILE" || "${GRIM[@]}" "$FILE"
    else
        "${GRIM[@]}" "$FILE"
    fi
}

# region: drag an area or click a window; a click on neither takes the
# monitor (its rect from --outputs).
if [ "${1:-region}" = "region" ]; then
    pick_region --freeze --windows --outputs || exit 0
    is_click "$GEOM" && exit 0

    play_sound camera-shutter
    "${GRIM[@]}" -g "$GEOM" "$FILE"
elif [ "${1:-}" = "fullscreen" ]; then
    play_sound camera-shutter
    grab_screen
else
    echo "screenshot: unknown mode '${1:-}' (want region|fullscreen)" >&2
    exit 2
fi

if [ ! -f "$FILE" ]; then
    exit 0
fi

exec 200>&-
wl-copy -t image/png <"$FILE" || true

ACTION=$(notify-send --app-name "Screenshot" -t 3000 "Captured" -i "$FILE" -A "default=Edit" "Saved and copied to clipboard.")

if [ "$ACTION" = "default" ]; then
    satty --filename "$FILE" --output-filename "$FILE"
fi

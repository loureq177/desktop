#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/lib/dotfiles/capture.sh"
single_instance screenshot_slurp

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
BASE="$DIR/$(date +'%Y-%m-%d_%H-%M-%S')"
FILE="$BASE.png"
if [[ -e "$FILE" ]]; then
    n=1
    while [[ -e "$BASE-$n.png" ]]; do
        n=$((n + 1))
    done
    FILE="$BASE-$n.png"
fi

trap stop_picker EXIT

if [ "${1:-region}" = "region" ]; then
    pick_region --freeze --windows || exit 0
    is_click "$GEOM" && exit 0

    timeout 5 grim -g "$GEOM" "$FILE"
elif [ "${1:-}" = "window" ]; then
    GEOM=$(active_window_geom)
    if [[ -z "${GEOM:-}" || "$GEOM" == "null" ]]; then
        play_sound dialog-warning
        notify-send --app-name "Screenshot" -t 3000 --icon "dialog-warning" "No Window Found" "Unable to detect active window geometry."
        exit 0
    fi
    timeout 5 grim -g "$GEOM" "$FILE"
elif [ "${1:-}" = "fullscreen" ] || [ "${1:-}" = "output" ] || [ "${1:-}" = "full" ]; then
    FOCUSED_OUTPUT=$(focused_output)
    if [[ -n "${FOCUSED_OUTPUT:-}" ]]; then
        timeout 5 grim -o "$FOCUSED_OUTPUT" "$FILE" || timeout 5 grim "$FILE"
    else
        timeout 5 grim "$FILE"
    fi
else
    echo "screenshot.sh: unknown mode '${1:-}' (want region|window|fullscreen|output)" >&2
    exit 2
fi

if [ ! -f "$FILE" ]; then
    exit 0
fi

play_sound camera-shutter

exec 200>&-
wl-copy -t image/png <"$FILE" || true

ACTION=$(notify-send --app-name "Screenshot" -t 3000 "Captured" -i "$FILE" -A "default=Edit" "Saved and copied to clipboard.")

if [ "$ACTION" = "default" ]; then
    satty --filename "$FILE" --fullscreen --output-filename "$FILE"
fi

#!/usr/bin/env bash
set -euo pipefail

LOC_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/weather/weather.json"

case "${1:-}" in
"")
    name=$(jq -r '.name // empty' "$LOC_FILE" 2>/dev/null || true)
    [[ -n "$name" ]] || name=$(curl -fsS --max-time 3 "https://geolocation-db.com/json/" | jq -r '.city // empty' || true)
    [[ -z "$name" ]] || echo "$name"
    ;;
--set)
    city="${2:?Usage: weather-location --set <name> [lat,lon]}"
    coords="${3:-}"
    if [[ -z "$coords" ]]; then
        coords=$(curl -fsS --max-time 4 -G "https://geocoding-api.open-meteo.com/v1/search" \
            --data-urlencode "name=$city" -d count=1 -d language=en -d format=json |
            jq -r '.results[0] // empty | "\(.latitude),\(.longitude)"' || true)
    fi
    if [[ -n "$coords" ]]; then
        location=$(jq -n --arg name "$city" --argjson lat "${coords%,*}" --argjson lon "${coords#*,}" \
            '{name: $name, latitude: $lat, longitude: $lon}')
    else
        location=$(jq -n --arg name "$city" '{$name}')
    fi
    mkdir -p "${LOC_FILE%/*}"
    printf '%s\n' "$location" >"$LOC_FILE"
    qs ipc call weather refresh >/dev/null 2>&1 || true
    ;;
--clear)
    rm -f "$LOC_FILE"
    qs ipc call weather refresh >/dev/null 2>&1 || true
    ;;
*)
    echo "Usage: weather-location [--set <name> [lat,lon]|--clear]" >&2
    exit 1
    ;;
esac

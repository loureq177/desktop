#!/usr/bin/env bash
# Show or set the location used for weather reports.
# State lives in ~/.local/state/weather/weather.json.
set -euo pipefail

LOC_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/weather"
LOC_FILE="$LOC_DIR/weather.json"

COORDS_PATTERN='^(-?[0-9]+(\.[0-9]+)?),(-?[0-9]+(\.[0-9]+)?)$'

case "${1:-}" in
"")
    name=""
    if [[ -f "$LOC_FILE" ]]; then
        name=$(jq -r '.name // ""' "$LOC_FILE" 2>/dev/null || true)
    fi
    if [[ -z "$name" ]]; then
        name=$(curl -fsS --max-time 3 "https://geolocation-db.com/json/" 2>/dev/null | jq -r '.city // ""' 2>/dev/null || true)
    fi
    [[ -n "$name" ]] && echo "$name"
    ;;
--set)
    [[ -n "${2:-}" ]] || { echo "Usage: weather-location --set <name> [lat,lon]" >&2; exit 1; }
    city="$2"
    if [[ -n "${3:-}" ]]; then
        [[ "${3}" =~ $COORDS_PATTERN ]] || { echo "Invalid coordinates: $3 (expected lat,lon)" >&2; exit 1; }
        location=$(jq -n --arg name "$city" --argjson latitude "${3%,*}" --argjson longitude "${3#*,}" '{$name, $latitude, $longitude}')
    else
        geo=$(curl -fsS --max-time 4 "https://geocoding-api.open-meteo.com/v1/search?name=$(jq -rn --arg c "$city" '$c|@uri')&count=1&language=en&format=json" 2>/dev/null || true)
        lat=$(echo "$geo" | jq -r '.results[0].latitude // ""' 2>/dev/null || true)
        lon=$(echo "$geo" | jq -r '.results[0].longitude // ""' 2>/dev/null || true)
        if [[ -n "$lat" && -n "$lon" && "$lat" != "null" && "$lon" != "null" ]]; then
            location=$(jq -n --arg name "$city" --argjson latitude "$lat" --argjson longitude "$lon" '{$name, $latitude, $longitude}')
        else
            location=$(jq -n --arg name "$city" '{$name}')
        fi
    fi
    mkdir -p "$LOC_DIR"
    tmp_loc=$(mktemp "$LOC_DIR/.weather.json.XXXXXX")
    printf '%s\n' "$location" >"$tmp_loc"
    mv -f "$tmp_loc" "$LOC_FILE"
    qs ipc call weather refresh >/dev/null 2>&1 || true
    ;;
--clear)
    rm -f "$LOC_FILE"
    qs ipc call weather refresh >/dev/null 2>&1 || true
    ;;
*)
    echo "Usage: weather-location [--set <name> [lat,lon]|--clear]" >&2
    exit 1
    ;;
esac

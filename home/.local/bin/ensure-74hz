#!/usr/bin/env bash
set -euo pipefail

MON=PL2792Q
GEOM=2560x1440
MIN_HZ=73

for _ in {1..20}; do
    fields="$(hyprctl monitors -j | jq -r --arg m "$MON" --arg g "$GEOM" --argjson min "$MIN_HZ" '
        first(.[] | select(.description | contains($m))) as $mon
        | ([$mon.availableModes[] | select(startswith($g + "@")) | sub(".*@"; "") | rtrimstr("Hz")]
           | max_by(tonumber)) as $hz
        | select($hz != null and ($hz | tonumber) >= $min and $mon.refreshRate < $min)
        | [$hz, $mon.description, $mon.x, $mon.y, $mon.scale] | @tsv' || true)"
    [[ -n "$fields" ]] && break
    sleep 0.5
done
[[ -n "$fields" ]] || exit 0

IFS=$'\t' read -r hz desc x y scale <<<"$fields"
if hyprctl eval "hl.monitor({ output = 'desc:${desc}', mode = '${GEOM}@${hz}', position = '${x}x${y}', scale = ${scale} })" >/dev/null; then
    logger -t ensure-74hz "switched $MON to ${GEOM}@${hz}"
    notify-send -a ensure-74hz "Monitor 74Hz" "$MON switched to ${GEOM}@${hz}"
fi

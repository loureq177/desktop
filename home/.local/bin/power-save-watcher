#!/usr/bin/env bash
# power-save-watcher: auto-disable power-save mode when AC is connected.
# Only ever disables (never auto-enables): unplugging stays manual, so a
# deliberate battery profile is never silently dropped mid-session.
set -euo pipefail

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/powersave_mode"

on_ac() { # true when any AC/ADP supply reports online
    local f v
    for f in /sys/class/power_supply/ADP*/online /sys/class/power_supply/AC*/online; do
        [[ -r "$f" ]] || continue
        v="$(cat "$f" 2>/dev/null || echo "")"
        [[ "$v" == "1" ]] && return 0
    done
    return 1
}

maybe_disable() {
    sleep 1 # let sysfs settle after the uevent burst
    # The state-file check only saves a process spawn: --disable is a no-op
    # when the mode is already off.
    if on_ac && [[ -f "$STATE_FILE" ]]; then
        "$HOME/.local/bin/power-save" --disable >/dev/null 2>&1 || true
    fi
}

# No AC/ADP supplies (desktop): nothing to watch.
if ! compgen -G "/sys/class/power_supply/ADP*/online" >/dev/null 2>&1 \
    && ! compgen -G "/sys/class/power_supply/AC*/online" >/dev/null 2>&1; then
    exit 0
fi

maybe_disable & # initial state (e.g. service started while already on AC)

# udev is the source of truth for plug/unplug; listening needs no root.
udevadm monitor --udev --property --subsystem-match=power_supply 2>/dev/null | while IFS= read -r line; do
    # Event blocks start with "UDEV  [seq] ..."; react once per event.
    [[ "$line" == UDEV\ * ]] && maybe_disable &
done

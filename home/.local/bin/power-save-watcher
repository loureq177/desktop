#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/powersave_mode"

on_ac() {
    local f v
    for f in /sys/class/power_supply/ADP*/online /sys/class/power_supply/AC*/online; do
        [[ -r "$f" ]] || continue
        v="$(cat "$f" 2>/dev/null || echo "")"
        [[ "$v" == "1" ]] && return 0
    done
    return 1
}

maybe_disable() {
    sleep 1
    if on_ac && [[ -f "$STATE_FILE" ]]; then
        "$HOME/.local/bin/power-save" --disable >/dev/null 2>&1 || true
    fi
}

if ! compgen -G "/sys/class/power_supply/ADP*/online" >/dev/null 2>&1 \
    && ! compgen -G "/sys/class/power_supply/AC*/online" >/dev/null 2>&1; then
    exit 0
fi

maybe_disable &

udevadm monitor --udev --property --subsystem-match=power_supply 2>/dev/null | while IFS= read -r line; do
    [[ "$line" == UDEV\ * ]] && maybe_disable &
done

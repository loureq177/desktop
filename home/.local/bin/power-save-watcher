#!/usr/bin/env bash
set -euo pipefail

# Re-evaluates power-save state on every power supply change: leaves power-save
# mode when AC is connected and switches the Ghostty eye-candy with the power source.
sync() {
    sleep 1
    "$HOME/.local/bin/power-save" --sync >/dev/null 2>&1 || true
}

if ! compgen -G "/sys/class/power_supply/ADP*/online" >/dev/null 2>&1 \
    && ! compgen -G "/sys/class/power_supply/AC*/online" >/dev/null 2>&1; then
    exit 0
fi

sync &

udevadm monitor --udev --property --subsystem-match=power_supply 2>/dev/null | while IFS= read -r line; do
    [[ "$line" == UDEV\ * ]] && sync &
done

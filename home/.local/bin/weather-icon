#!/usr/bin/env bash
# Returns a Nerd Font weather icon via Open-Meteo.
set -euo pipefail

LOC_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/weather/weather.json"
OMARCHY_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/settings/weather.json"

file=""
if [[ -s "$LOC_FILE" ]]; then
    file="$LOC_FILE"
elif [[ -s "$OMARCHY_FILE" ]]; then
    file="$OMARCHY_FILE"
fi

lat=""
lon=""

if [[ -n "$file" ]]; then
    lat=$(jq -r '.latitude // ""' "$file" 2>/dev/null || true)
    lon=$(jq -r '.longitude // ""' "$file" 2>/dev/null || true)
fi

if [[ -z "$lat" || -z "$lon" || "$lat" == "null" || "$lon" == "null" ]]; then
    # IP fallback: ipapi.co first, ipinfo.io second. (geolocation-db.com,
    # used previously, is deprecated/unreliable.) Both over HTTPS.
    ip_data=$(curl -fsS --max-time 3 "https://ipapi.co/json/" 2>/dev/null || true)
    if [[ -n "$ip_data" ]]; then
        lat=$(echo "$ip_data" | jq -r '.latitude // .lat // ""' 2>/dev/null || true)
        lon=$(echo "$ip_data" | jq -r '.longitude // .lon // ""' 2>/dev/null || true)
    fi
    if [[ -z "$lat" || -z "$lon" || "$lat" == "null" || "$lon" == "null" ]]; then
        ip_data=$(curl -fsS --max-time 3 "https://ipinfo.io/json" 2>/dev/null || true)
        if [[ -n "$ip_data" ]]; then
            # ipinfo returns "loc": "lat,lon"
            _loc=$(echo "$ip_data" | jq -r '.loc // ""' 2>/dev/null || true)
            if [[ -n "$_loc" && "$_loc" == *,* ]]; then
                lat="${_loc%,*}"
                lon="${_loc#*,}"
            else
                lat=$(echo "$ip_data" | jq -r '.latitude // .lat // ""' 2>/dev/null || true)
                lon=$(echo "$ip_data" | jq -r '.longitude // .lon // ""' 2>/dev/null || true)
            fi
        fi
    fi
fi

if [[ -z "$lat" || -z "$lon" || "$lat" == "null" || "$lon" == "null" ]]; then
    exit 1
fi

weather_json=$(curl -fsS --max-time 4 "https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=weather_code,is_day&timezone=auto" 2>/dev/null || true)

if [[ -z "$weather_json" ]]; then
    exit 1
fi

code=$(echo "$weather_json" | jq -r '.current.weather_code // 0')
is_day=$(echo "$weather_json" | jq -r '.current.is_day // 1')

case "$code" in
    0) (( is_day == 1 )) && icon="" || icon="" ;;
    1|2) (( is_day == 1 )) && icon="" || icon="" ;;
    3) icon="" ;;
    45|48) (( is_day == 1 )) && icon="" || icon="" ;;
    51|53|55|61|63|65) icon="" ;;
    56|57|66|67) icon="" ;;
    71|73|75|77) icon="" ;;
    80|81|82) (( is_day == 1 )) && icon="" || icon="" ;;
    85|86) (( is_day == 1 )) && icon="" || icon="" ;;
    95|96|99) icon="" ;;
    *) (( is_day == 1 )) && icon="" || icon="" ;;
esac

printf '%s\n' "$icon"

#!/usr/bin/env bash
set -euo pipefail

WALL_DIR="${WALL_DIR:-$HOME/Pictures/Wallpapers}"
STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper/current"
DEFAULT_WALLPAPER="$WALL_DIR/hyprland.png"
[[ -f "$DEFAULT_WALLPAPER" ]] || DEFAULT_WALLPAPER="$HOME/.config/hypr/wallpapers/hyprland.png"

die() {
    echo "wallpaper: $*" >&2
    exit 1
}

list_files() {
    find "$WALL_DIR" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        -printf '%f\n' 2>/dev/null | sort
}

current_path() {
    local saved=""
    saved="$(cat "$STATE_FILE" 2>/dev/null || true)"
    [[ -n "$saved" && -f "$saved" ]] || return 1
    printf '%s\n' "$saved"
}

resolve_name() {
    local target="$1" matches=""
    if [[ -f "$target" ]]; then
        realpath -s "$target"
        return 0
    fi
    if [[ -f "$WALL_DIR/$target" ]]; then
        realpath -s "$WALL_DIR/$target"
        return 0
    fi
    matches="$(list_files | grep -F -- "$target" || true)"
    [[ -z "$matches" ]] && die "no wallpaper matching '$target' (see: wallpaper list)"
    if [[ "$(printf '%s\n' "$matches" | wc -l)" -gt 1 ]]; then
        echo "wallpaper: ambiguous '$target', matches:" >&2
        printf '%s\n' "$matches" >&2
        exit 1
    fi
    realpath -s "$WALL_DIR/$matches"
}

apply() {
    local old=""
    old="$(pgrep -x swaybg || true)"
    setsid swaybg -i "$1" -m fill >/dev/null 2>&1 &
    sleep 0.3
    [[ -n "$old" ]] && printf '%s\n' "$old" | xargs kill 2>/dev/null || true
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$1" >"$STATE_FILE"
}

step() {
    local files cur idx=-1 i
    mapfile -t files < <(list_files)
    [[ "${#files[@]}" -eq 0 ]] && die "no wallpapers in $WALL_DIR"
    cur="$(basename "$(current_path 2>/dev/null || true)")"
    for i in "${!files[@]}"; do
        [[ "${files[$i]}" == "$cur" ]] && idx="$i" && break
    done
    apply "$WALL_DIR/${files[$(((idx + $1 + ${#files[@]}) % ${#files[@]}))]}"
}

pick_random() {
    local cur pick
    cur="$(basename "$(current_path 2>/dev/null || true)")"
    pick="$(list_files | grep -vxF -- "$cur" | shuf -n 1 || true)"
    [[ -n "$pick" ]] || pick="$(list_files | shuf -n 1)"
    [[ -n "$pick" ]] || die "no wallpapers in $WALL_DIR"
    apply "$WALL_DIR/$pick"
}

restore_state() {
    local saved=""
    saved="$(current_path 2>/dev/null || true)"
    [[ -n "$saved" ]] || { [[ -f "$DEFAULT_WALLPAPER" ]] && saved="$DEFAULT_WALLPAPER"; }
    [[ -n "$saved" ]] || saved="$WALL_DIR/$(list_files | head -n 1)"
    [[ -f "$saved" ]] || die "no wallpapers in $WALL_DIR"
    apply "$saved"
}

usage() {
    cat <<EOF
Usage: wallpaper [list|current|set <name|path>|next|prev|random|restore|init]
  list              list available wallpapers
  current           show the active wallpaper
  set <name>        set wallpaper (basename or unique substring)
  next|prev         cycle through wallpapers (alphabetical)
  random            random wallpaper
  restore | init    re-apply saved wallpaper (autostart entry)
Env: WALL_DIR (default: ~/Pictures/Wallpapers).
Binds: SUPER+P next wallpaper in order.
EOF
}

case "${1:-}" in
list) list_files ;;
current) current_path || die "cannot determine current wallpaper" ;;
set) [[ -n "${2:-}" ]] || die "usage: wallpaper set <name|path>"; apply "$(resolve_name "$2")" ;;
next) step 1 ;;
prev) step -1 ;;
random) pick_random ;;
restore | init) restore_state ;;
"" | -h | --help | help) usage ;;
*) die "unknown command '${1}' (see: wallpaper --help)" ;;
esac

#!/usr/bin/env bash
set -euo pipefail

WALL_DIR="${WALL_DIR:-$HOME/Pictures/Wallpapers}"
STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper/current"
DEFAULT_WALLPAPER="$WALL_DIR/hyprland.png"
[[ -f "$DEFAULT_WALLPAPER" ]] || DEFAULT_WALLPAPER="$HOME/.config/hypr/wallpapers/hyprland.png"

die() {
    echo "wallpaper: $*" >&2
    exit 1
}

list_files() {
    find "$WALL_DIR" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        -printf '%f\n' 2>/dev/null | sort
}

current_path() {
    local saved=""
    saved="$(cat "$STATE_FILE" 2>/dev/null || true)"
    [[ -n "$saved" && -f "$saved" ]] || return 1
    printf '%s\n' "$saved"
}

# quickshell watches the state file and draws whatever it names.
apply() {
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$1" >"$STATE_FILE"
}

# Next wallpaper in alphabetical order, wrapping around.
next() {
    local files cur idx=-1 i
    mapfile -t files < <(list_files)
    [[ "${#files[@]}" -eq 0 ]] && die "no wallpapers in $WALL_DIR"
    cur="$(basename "$(current_path 2>/dev/null || true)")"
    for i in "${!files[@]}"; do
        [[ "${files[$i]}" == "$cur" ]] && idx="$i" && break
    done
    apply "$WALL_DIR/${files[$(((idx + 1) % ${#files[@]}))]}"
}

# Make sure a wallpaper is set (autostart entry).
init() {
    local saved=""
    saved="$(current_path 2>/dev/null || true)"
    [[ -n "$saved" ]] || { [[ -f "$DEFAULT_WALLPAPER" ]] && saved="$DEFAULT_WALLPAPER"; }
    [[ -n "$saved" ]] || saved="$WALL_DIR/$(list_files | head -n 1 || true)"
    [[ -f "$saved" ]] || die "no wallpapers in $WALL_DIR"
    apply "$saved"
}

case "${1:-}" in
next) next ;;
init) init ;;
*) die "usage: wallpaper next|init" ;;
esac

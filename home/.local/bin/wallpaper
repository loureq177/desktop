#!/usr/bin/env bash
set -euo pipefail

WALL_DIR="${WALL_DIR:-$HOME/Pictures/Wallpapers}"
# The ones the desktop comes with.
SYSTEM_DIR="$HOME/.config/hypr/wallpapers"
STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper/current"
DEFAULT_WALLPAPER="$WALL_DIR/hyprland.webp"
[[ -f "$DEFAULT_WALLPAPER" ]] || DEFAULT_WALLPAPER="$SYSTEM_DIR/hyprland.webp"

die() {
    echo "wallpaper: $*" >&2
    exit 1
}

images() {
    find "$1" -maxdepth 1 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        2>/dev/null
}

# The paths of the user's wallpapers and the desktop's, by file name; the
# user's copy of one (by name, whatever its format) stands in for the desktop's.
list_files() {
    local own
    own="$(images "$WALL_DIR" | sed 's|.*/||; s|\.[^.]*$||')"
    {
        images "$WALL_DIR"
        images "$SYSTEM_DIR" | while IFS= read -r f; do
            local stem="${f##*/}"
            grep -qxF "${stem%.*}" <<<"$own" || printf '%s\n' "$f"
        done
    } | awk -F/ '{ print $NF "\t" $0 }' | sort | cut -f2-
}

current_path() {
    local saved=""
    saved="$(cat "$STATE_FILE" 2>/dev/null || true)"
    [[ -n "$saved" && -f "$saved" ]] || return 1
    printf '%s\n' "$saved"
}

# quickshell watches the state file and draws whatever it names.
apply() {
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$1" >"$STATE_FILE"
}

# Next wallpaper in alphabetical order, wrapping around.
next() {
    local files cur idx=-1 i
    mapfile -t files < <(list_files)
    if [[ "${#files[@]}" -eq 0 ]]; then
        # Run from a key: stderr goes nowhere anyone reads.
        notify-send --app-name=Wallpaper -i image-missing "No wallpapers" \
            "Put images (png, jpg, webp) in ${WALL_DIR/#$HOME/\~}" 2>/dev/null || true
        die "no wallpapers in $WALL_DIR or $SYSTEM_DIR"
    fi
    cur="$(current_path 2>/dev/null || true)"
    for i in "${!files[@]}"; do
        [[ "${files[$i]}" == "$cur" ]] && idx="$i" && break
    done
    apply "${files[$(((idx + 1) % ${#files[@]}))]}"
}

# Make sure a wallpaper is set (autostart entry).
init() {
    local saved=""
    saved="$(current_path 2>/dev/null || true)"
    [[ -n "$saved" ]] || { [[ -f "$DEFAULT_WALLPAPER" ]] && saved="$DEFAULT_WALLPAPER"; }
    [[ -n "$saved" ]] || saved="$(list_files | head -n 1 || true)"
    [[ -f "$saved" ]] || die "no wallpapers in $WALL_DIR or $SYSTEM_DIR"
    apply "$saved"
}

case "${1:-}" in
next) next ;;
init) init ;;
*) die "usage: wallpaper next|init" ;;
esac

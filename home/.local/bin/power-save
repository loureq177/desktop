#!/usr/bin/env bash
set -euo pipefail

# No argument toggles the mode; --reapply is for apply-ui, --sync for the shell
# (SystemStatus.qml runs it whenever the power source changes).
action="${1:-toggle}"
with_brightness=true
command -v brightnessctl >/dev/null || with_brightness=false

RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec 201>"$RUN_DIR/powersave.lock"
flock -w 2 201 || exit 0

STATE_FILE="$RUN_DIR/powersave_mode"
PREV_BRIGHTNESS_FILE="$RUN_DIR/powersave_prev_brightness"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
GHOSTTY_PERF="$STATE_DIR/ghostty/perf.conf"
GHOSTTY_SHADER="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/shaders/cursor_warp.glsl"
OPENCODE_KV="$STATE_DIR/opencode/kv.json"

is_active() { [[ -f "$STATE_FILE" ]]; }

# True on AC power, and on machines without an AC adapter (desktops).
on_ac() {
    local f found=false
    for f in /sys/class/power_supply/ADP*/online /sys/class/power_supply/AC*/online; do
        [[ -r "$f" ]] || continue
        found=true
        [[ "$(<"$f")" == 1 ]] && return 0
    done
    ! $found
}

detach() { ( exec 201>&-; "$@" ) >/dev/null 2>&1 & }

bri() { brightnessctl -c backlight "$@" >/dev/null || true; }

report_brightness() {
    local pct
    pct="$(brightnessctl -c backlight -m | head -n 1 | cut -d, -f4 | tr -dc '0-9' || true)"
    [[ -z "$pct" ]] || detach qs ipc call osd brightness "$pct"
}

ghostty_reload() {
    if systemctl --user is-active -q app-com.mitchellh.ghostty.service; then
        systemctl --user reload app-com.mitchellh.ghostty.service
    else
        pkill -SIGUSR2 -x ghostty
    fi || true
}

slow_tail() {
    ghostty_reload
    powerprofilesctl set "$1" || true
}

apply_display() {
    local fields desc width height pos scale hz blur=true
    fields="$(hyprctl monitors -j | jq -r --arg hz "$1" '
        first(.[] | select(.name | startswith("eDP"))) as $m
        | ([$m.availableModes[] | select(startswith("\($m.width)x\($m.height)@"))
            | sub(".*@"; "") | rtrimstr("Hz") | tonumber | floor] | max // ($m.refreshRate | floor)) as $max
        | [if ($m.description // "") != "" then "desc:\($m.description)" else $m.name end,
           $m.width, $m.height, "\($m.x)x\($m.y)", $m.scale, (if $hz == "max" then $max else $hz end)]
        | @tsv' || true)"
    [[ -n "$fields" ]] || return 0
    IFS=$'\t' read -r desc width height pos scale hz <<<"$fields"
    [[ "$1" == 60 ]] && blur=false
    hyprctl eval "hl.monitor({ output = '${desc}', mode = '${width}x${height}@${hz}', position = '${pos}', scale = ${scale} }); hl.config({ decoration = { blur = { enabled = ${blur} } } })" >/dev/null || true
}

# Ghostty shader animation + translucency cost GPU time, so they are on only
# on AC power and outside power-save mode. Returns 1 when nothing changed.
ghostty_candy() {
    local shader="$GHOSTTY_SHADER" anim=true opacity=0.80 conf
    if ! on_ac || is_active; then
        # An empty custom-shader clears the list: no shader at all.
        shader="" anim=false opacity=1.0
    fi
    conf="# Managed by power-save. Do not edit.
# background-opacity below 1 makes Ghostty send a buffer with alpha, and only
# then does Hyprland blur what is behind the window (at 1.0 the buffer is
# opaque and there is nothing to blur; background-blur itself is KDE-only).
custom-shader = $shader
custom-shader-animation = $anim
background-opacity = $opacity"
    [[ "$(cat "$GHOSTTY_PERF" 2>/dev/null)" != "$conf" ]] || return 1
    mkdir -p "${GHOSTTY_PERF%/*}"
    printf '%s\n' "$conf" >"$GHOSTTY_PERF"
}

opencode_anims() {
    local json
    mkdir -p "${OPENCODE_KV%/*}"
    [[ -s "$OPENCODE_KV" ]] && json="$(<"$OPENCODE_KV")" || json='{}'
    # Through a temp file: a jq that fails must not leave opencode's state empty.
    if jq --argjson v "$1" '.animations_enabled = $v' <<<"$json" >"$OPENCODE_KV.tmp"; then
        mv "$OPENCODE_KV.tmp" "$OPENCODE_KV"
    else
        rm -f "$OPENCODE_KV.tmp"
    fi
}

enable_mode() {
    is_active && return 0
    touch "$STATE_FILE"

    if $with_brightness; then
        local cur
        cur="$(brightnessctl -c backlight get || true)"
        [[ -f "$PREV_BRIGHTNESS_FILE" || -z "$cur" ]] || echo "$cur" >"$PREV_BRIGHTNESS_FILE"
        bri --min-value=5 set 20%-
        report_brightness
    fi

    apply_display 60
    ghostty_candy || true
    opencode_anims false
    detach slow_tail power-saver
}

disable_mode() {
    is_active || return 0
    rm -f "$STATE_FILE"

    if $with_brightness; then
        local prev="" cur
        [[ -s "$PREV_BRIGHTNESS_FILE" ]] && prev="$(<"$PREV_BRIGHTNESS_FILE")"
        rm -f "$PREV_BRIGHTNESS_FILE"
        cur="$(brightnessctl -c backlight get || true)"
        if ((${prev:-0} > ${cur:-0})); then
            bri set "$prev"
        else
            bri set +20%
        fi
        report_brightness
    fi

    apply_display max
    ghostty_candy || true
    opencode_anims true
    detach slow_tail balanced
}

case "$action" in
toggle) if is_active; then disable_mode; else enable_mode; fi ;;
--reapply) if is_active; then apply_display 60; fi ;;
--sync)
    # Called by the shell on every power supply change.
    if is_active && on_ac; then
        disable_mode
    elif ghostty_candy; then
        ghostty_reload
    fi
    ;;
esac

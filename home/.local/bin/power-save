#!/usr/bin/env bash
# Toggles Hyprland power-save mode (refresh rate 60/165Hz, blur, brightness, ghostty shader, opencode anims). Usage: [--status|--enable|--disable]
set -euo pipefail

action="toggle"
with_brightness=true

for arg in "$@"; do
    case "$arg" in
    --status|status)
        action="status"
        ;;
    --enable|enable)
        action="enable"
        ;;
    --disable|disable)
        action="disable"
        ;;
    --toggle|toggle)
        action="toggle"
        ;;
    --no-brightness)
        with_brightness=false
        ;;
    *)
        ;;
    esac
done

# Serialize toggles: wait briefly for a running instance instead of dropping
# the second click (flock -n silently ignored it, forcing a manual cooldown).
# The critical section below is fast (~150ms), so -w 2 only ever sleeps
# through one in-flight toggle; a hung holder still times out.
if [[ "$action" != "status" ]]; then
    LOCK_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/powersave.lock"
    exec 201>"$LOCK_FILE"
    if ! flock -w 2 201; then
        exit 0
    fi
fi

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/powersave_mode"
PREV_BRIGHTNESS_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/powersave_prev_brightness"
GHOSTTY_SHADERS="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/shaders"
# Machine-local symlink that ~/.config/ghostty/config points at. Both targets
# are stowed files; only this link is mutable, so toggling never dirties the
# dotfiles repo (see _ghostty_shader).
GHOSTTY_SHADER="${XDG_STATE_HOME:-$HOME/.local/state}/ghostty/active-shader.glsl"
GHOSTTY_PERF="${XDG_STATE_HOME:-$HOME/.local/state}/ghostty/perf.conf"
OPENCODE_KV="${XDG_STATE_HOME:-$HOME/.local/state}/opencode/kv.json"

_is_active() {
    [[ -f "$STATE_FILE" ]]
}

bri() {
    timeout 5 brightnessctl -c backlight "$@" >/dev/null 2>&1 || true
}

_report_brightness() {
    local pct
    pct="$(timeout 5 brightnessctl -c backlight -m 2>/dev/null | head -n 1 | cut -d, -f4 | tr -dc '0-9' || true)"
    # OSD + tile refresh are fire-and-forget: don't hold the lock for IPC.
    # exec 201>&- first: background subshells inherit the lock fd, and an
    # open copy would keep the flock held until they exit.
    (
        exec 201>&-
        if [[ -n "${pct:-}" ]]; then
            qs ipc call osd brightness "$pct" >/dev/null 2>&1 || true
        fi
        qs ipc call quicksettings refresh >/dev/null 2>&1 || true
    ) >/dev/null 2>&1 &
}

prof() {
    powerprofilesctl set "$1" >/dev/null 2>&1 || true
}

_slow_tail() { # $1: power-saver|balanced — ghostty reload + profile, detached
    # File writes (shader/perf) are already done synchronously above; only
    # the slow consumers (systemd reload, powerprofilesctl, qs IPC) go here.
    (
        exec 201>&-
        _ghostty_reload
        prof "$1"
        qs ipc call quicksettings refresh >/dev/null 2>&1 || true
    ) >/dev/null 2>&1 &
}

_apply_display() { # $1: 60|max — single monitors fetch + single hyprctl eval
    local target_hz="$1"
    local mon_json mon_info
    # One hyprctl round-trip per process (was: two monitors -j calls).
    mon_json="$(timeout 5 hyprctl monitors -j 2>/dev/null || echo '[]')"
    mon_info=$(jq -r '
        .[] | select(.name | startswith("eDP")) |
        "\(if .description and (.description | length > 0) then "desc:\(.description)" else .name end)|\(.width)|\(.height)|\(.x)x\(.y)|\(.scale)"
    ' <<<"$mon_json" 2>/dev/null | head -n 1 || true)

    [[ -z "$mon_info" ]] && return 0

    local desc width height pos scale
    IFS="|" read -r desc width height pos scale <<<"$mon_info"
    # Guard the eval below: compositor JSON is untrusted input for Lua.
    [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || return 0
    [[ "$scale" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
    desc="${desc//\'/\\\'}"
    [[ "$pos" =~ ^-?[0-9]+x-?[0-9]+$ ]] || return 0

    local hz="$target_hz"
    if [[ "$target_hz" == "max" || "$target_hz" == "high" ]]; then
        # Reuse the same JSON (was: a second hyprctl monitors -j).
        local detected_max
        detected_max=$(jq -r '
            .[] | select(.name | startswith("eDP")) |
            .availableModes[]? | select(startswith("'"${width}x${height}"'"))
        ' <<<"$mon_json" 2>/dev/null | sed -E 's/.*@([0-9]+(\.[0-9]+)?).*/\1/' | sort -n | tail -n 1 || true)
        detected_max="${detected_max%%.*}"
        [[ "$detected_max" =~ ^[0-9]+$ ]] || detected_max=""
        hz="${detected_max:-165}"
    fi

    # One IPC round-trip: modeset + decoration together (was: two hyprctl
    # eval calls). Blur follows the mode: off on battery (perf), on in
    # eye-candy to match hyprland.lua (enabled + ignore_opacity).
    local blur_enabled="true"
    if [[ "$target_hz" == "60" ]]; then
        blur_enabled="false"
    fi
    [[ "$hz" =~ ^[0-9]+$ ]] || return 0
    timeout 5 hyprctl eval "hl.monitor({ output = '${desc}', mode = '${width}x${height}@${hz}', position = '${pos}', scale = ${scale} }); hl.config({ animations = { enabled = true }, decoration = { blur = { enabled = ${blur_enabled}, ignore_opacity = true }, shadow = { enabled = false } } })" >/dev/null 2>&1 || true
}

_ghostty_reload() {
    # Ghostty does not watch the config file; the same reload as
    # ctrl+shift+, (reload_config) must be triggered explicitly.
    # SIGUSR2 is the supported reload signal; the systemd unit wraps it.
    if systemctl --user is-active -q app-com.mitchellh.ghostty.service 2>/dev/null; then
        systemctl reload --user app-com.mitchellh.ghostty.service >/dev/null 2>&1 || true
    else
        pkill -SIGUSR2 -x ghostty >/dev/null 2>&1 || true
    fi
}

_shader_target() { # $1: on|off -> stowed shader file to point at
    if [[ "$1" == "off" ]]; then
        printf '%s\n' "$GHOSTTY_SHADERS/noop.glsl"
    else
        printf '%s\n' "$GHOSTTY_SHADERS/cursor_warp.glsl"
    fi
}

_shader_state() { # current on|off, read from the symlink; defaults to "on"
    case "$(readlink "$GHOSTTY_SHADER" 2>/dev/null || true)" in
    *noop.glsl) printf 'off\n' ;;
    *) printf 'on\n' ;;
    esac
}

_ghostty_shader() { # $1: on|off
    local want tmp
    want="$(_shader_target "$1")"
    [[ -f "$want" ]] || return 0
    # Already in the wanted state and the link exists: nothing to do.
    if [[ -e "$GHOSTTY_SHADER" ]] && [[ "$(_shader_state)" == "$1" ]]; then
        return 0
    fi
    mkdir -p "$(dirname "$GHOSTTY_SHADER")" || return 0
    tmp="$(mktemp "$(dirname "$GHOSTTY_SHADER")/.shader.XXXXXX")" || return 0
    if ! ln -sfn "$want" "$tmp" || ! mv -f "$tmp" "$GHOSTTY_SHADER"; then
        rm -f "$tmp"
        return 0
    fi
}

_ghostty_perf() { # $1: on|off (on = eye-candy, off = static opaque)
    # The shader symlink alone is not enough: custom-shader-animation=true
    # forces a full-rate redraw even with the noop shader, and
    # background-opacity<1 + blur + minimum-contrast keep the
    # compositor busy every frame. This file overrides those four keys;
    # it is included last via `config-file` in ghostty/config.
    local mode="$1"
    [[ "$mode" == "on" || "$mode" == "off" ]] || return 0
    mkdir -p "$(dirname "$GHOSTTY_PERF")" || return 0
    local tmp
    tmp=$(mktemp "$(dirname "$GHOSTTY_PERF")/.perf.conf.XXXXXX") || return 0
    if [[ "$mode" == "off" ]]; then
        cat >"$tmp" <<'EOF'
# Managed by power-save. Do not edit.
custom-shader-animation = false
background-opacity = 1.0
background-blur = false
minimum-contrast = 1
EOF
    else
        cat >"$tmp" <<'EOF'
# Managed by power-save. Do not edit.
# background-opacity<1: Ghostty wysyła bufor z alfą, dopiero wtedy Hyprland
# bluruje tło za oknem (przy 1.0 bufor jest nieprzeźroczysty i blur nie ma
# czego łapać — docs: background-blur na Linuksie tylko pod KDE).
custom-shader-animation = true
background-opacity = 0.97
background-blur = false
minimum-contrast = 1
EOF
    fi
    mv -f "$tmp" "$GHOSTTY_PERF" || rm -f "$tmp"
}

_opencode_anims() { # $1: true|false (persists TUI animation state in kv.json for NEW sessions only)
    # Upstream has no watcher or reload IPC: packages/tui/src/context/kv.tsx
    # reads kv.json once at startup and kv.set() updates memory + disk together.
    # External edits apply to the next launched TUI; running TUIs need a
    # manual Commands > Disable/Enable animations or a restart.
    local enabled="$1"
    [[ "$enabled" == "true" || "$enabled" == "false" ]] || return 0
    mkdir -p "$(dirname "$OPENCODE_KV")"
    if [[ ! -s "$OPENCODE_KV" ]]; then
        printf '{"animations_enabled":%s}\n' "$enabled" >"$OPENCODE_KV"
        return 0
    fi
    local tmp
    tmp=$(mktemp "$(dirname "$OPENCODE_KV")/.kv.json.XXXXXX") || return 0
    local ok=false
    if command -v jq >/dev/null 2>&1; then
        if jq --argjson v "$enabled" '.animations_enabled = $v' "$OPENCODE_KV" >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
            ok=true
        fi
    else
        # Atomic too: stage into $tmp first so a kill mid-write cannot
        # leave kv.json empty/truncated (previous code wrote in place).
        if python3 -c 'import json,sys; p=sys.argv[1]; v=sys.argv[2]=="true"; t=sys.argv[3]; d=json.load(open(p)); d["animations_enabled"]=v; json.dump(d,open(t,"w"))' "$OPENCODE_KV" "$enabled" "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
            ok=true
        fi
    fi

    if $ok; then
        mv -f "$tmp" "$OPENCODE_KV"
    else
        rm -f "$tmp"
        printf '{"animations_enabled":%s}\n' "$enabled" >"$OPENCODE_KV"
    fi
}

_status() {
    local max_hz="High"
    local detected_max
    detected_max=$(timeout 5 hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.name | startswith("eDP")) | .availableModes[0] // ""' 2>/dev/null | sed -E 's/.*@([0-9]+).*/\1/' || true)
    [[ "$detected_max" =~ ^[0-9]+$ ]] || detected_max=""
    [[ -n "$detected_max" ]] && max_hz="${detected_max} Hz"

    if _is_active; then
        printf '%s\n' '{"text": "󰌪", "alt": "on", "class": "on", "tooltip": "Power Saving Mode: ON\n• Refresh rate: 60 Hz\n• Blur: Disabled\n• Ghostty: Static opaque (shader/animation/blur off)\n• OpenCode anims: Disabled\n• Brightness: Reduced (-20%)\n• Profile: Power-saver\n\nClick to disable"}'
    else
        printf '%s\n' '{"text": "󰌪", "alt": "off", "class": "off", "tooltip": "Power Saving Mode: OFF\n• Refresh rate: '"$max_hz"'\n• Blur: Enabled\n• Ghostty: Translucent + blur (warp shader + anim on)\n• OpenCode anims: Enabled\n\nClick to enable"}'
    fi
}

_enable() {
    local with_brightness=true
    if [[ "${1:-}" == "false" || "${1:-}" == "--no-brightness" ]]; then
        with_brightness=false
    fi

    touch "$STATE_FILE"

    if $with_brightness && command -v brightnessctl >/dev/null 2>&1; then
        local cur_b
        cur_b=$(timeout 5 brightnessctl -c backlight get 2>/dev/null || echo "")
        if [[ ! -f "$PREV_BRIGHTNESS_FILE" ]] && [[ -n "$cur_b" ]]; then
            echo "$cur_b" >"$PREV_BRIGHTNESS_FILE"
        fi
        bri --min-value=5 set 20%-
        _report_brightness
    fi

    _apply_display 60
    _ghostty_perf off
    _ghostty_shader off
    _opencode_anims false
    _slow_tail power-saver
    # Fallback: re-assert backlight once dGPU settling timeout expires.
    # 201>&-: the 12s sleep must not inherit the lock fd (see above).
    (exec 201>&-; sleep 12 && restore-backlight) >/dev/null 2>&1 &
}

_disable() {
    local with_brightness=true
    if [[ "${1:-}" == "false" || "${1:-}" == "--no-brightness" ]]; then
        with_brightness=false
    fi

    rm -f "$STATE_FILE"

    if $with_brightness && command -v brightnessctl >/dev/null 2>&1; then
        local prev_b=""
        if [[ -f "$PREV_BRIGHTNESS_FILE" ]] && [[ -s "$PREV_BRIGHTNESS_FILE" ]]; then
            prev_b=$(cat "$PREV_BRIGHTNESS_FILE")
            rm -f "$PREV_BRIGHTNESS_FILE"
        fi

        local cur_b
        cur_b=$(timeout 5 brightnessctl -c backlight get 2>/dev/null || echo "")

        if [[ "$prev_b" =~ ^[0-9]+$ ]] && [[ "$cur_b" =~ ^[0-9]+$ ]] && (( prev_b > cur_b )); then
            bri set "$prev_b"
        else
            bri set +20%
        fi
        _report_brightness
    fi

    _apply_display max
    _ghostty_perf on
    _ghostty_shader on
    _opencode_anims true
    _slow_tail balanced
    # Fallback: re-assert backlight once dGPU settling timeout (modeset wake) expires.
    # 201>&-: the 12s sleep must not inherit the lock fd (see above).
    (exec 201>&-; sleep 12 && restore-backlight) >/dev/null 2>&1 &
}

_toggle() {
    if _is_active; then
        _disable "${1:-}"
    else
        _enable "${1:-}"
    fi
    # No direct qs call here: _report_brightness and _slow_tail already queue
    # exactly one quicksettings refresh each, detached (was: 3rd sync IPC).
}

# Self-seed: on a fresh clone the tracked ghostty config points at this link
# before it exists. Cheap and idempotent; only ever flips on a real change.
# Skipped for status: status queries (e.g. bar polling) must be read-only.
if [[ "$action" != "status" ]]; then
    [[ -e "$GHOSTTY_SHADER" ]] || _ghostty_shader on
    # Seed the perf profile without reload; the action below reloads.
    if [[ ! -e "$GHOSTTY_PERF" ]]; then
        if _is_active; then _ghostty_perf off; else _ghostty_perf on; fi
    fi
fi

case "$action" in
status)
    _status
    ;;
enable)
    _enable "$with_brightness"
    ;;
disable)
    _disable "$with_brightness"
    ;;
toggle)
    _toggle "$with_brightness"
    ;;
esac

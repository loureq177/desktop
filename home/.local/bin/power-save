#!/usr/bin/env bash
set -euo pipefail

action=toggle
with_brightness=true
for arg in "$@"; do
    case "${arg#--}" in
    status | enable | disable | toggle | reapply | sync) action="${arg#--}" ;;
    no-brightness) with_brightness=false ;;
    esac
done
command -v brightnessctl >/dev/null || with_brightness=false

if [[ "$action" != status ]]; then
    exec 201>"$XDG_RUNTIME_DIR/powersave.lock"
    flock -w 2 201 || exit 0
fi

STATE_FILE="$XDG_RUNTIME_DIR/powersave_mode"
PREV_BRIGHTNESS_FILE="$XDG_RUNTIME_DIR/powersave_prev_brightness"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
GHOSTTY_SHADER="$STATE_DIR/ghostty/active-shader.glsl"
GHOSTTY_PERF="$STATE_DIR/ghostty/perf.conf"
OPENCODE_KV="$STATE_DIR/opencode/kv.json"

is_active() { [[ -f "$STATE_FILE" ]]; }

# True on AC power, and on machines without an AC adapter (desktops).
on_ac() {
    local f found=false
    for f in /sys/class/power_supply/ADP*/online /sys/class/power_supply/AC*/online; do
        [[ -r "$f" ]] || continue
        found=true
        [[ "$(<"$f")" == 1 ]] && return 0
    done
    ! $found
}

detach() { ( exec 201>&-; "$@" ) >/dev/null 2>&1 & }

bri() { brightnessctl -c backlight "$@" >/dev/null || true; }

notify_ui() {
    [[ -z "${1:-}" ]] || qs ipc call osd brightness "$1" || true
    qs ipc call quicksettings refresh || true
}

report_brightness() {
    local pct
    pct="$(brightnessctl -c backlight -m | head -n 1 | cut -d, -f4 | tr -dc '0-9' || true)"
    detach notify_ui "$pct"
}

ghostty_reload() {
    if systemctl --user is-active -q app-com.mitchellh.ghostty.service; then
        systemctl --user reload app-com.mitchellh.ghostty.service
    else
        pkill -SIGUSR2 -x ghostty
    fi || true
}

slow_tail() {
    ghostty_reload
    powerprofilesctl set "$1" || true
    qs ipc call quicksettings refresh || true
}

restore_later() {
    sleep 12
    restore-backlight
}

apply_display() {
    local fields desc width height pos scale hz blur=true
    fields="$(hyprctl monitors -j | jq -r --arg hz "$1" '
        first(.[] | select(.name | startswith("eDP"))) as $m
        | ([$m.availableModes[] | select(startswith("\($m.width)x\($m.height)@"))
            | sub(".*@"; "") | rtrimstr("Hz") | tonumber | floor] | max // 165) as $max
        | [if ($m.description // "") != "" then "desc:\($m.description)" else $m.name end,
           $m.width, $m.height, "\($m.x)x\($m.y)", $m.scale, (if $hz == "max" then $max else $hz end)]
        | @tsv' || true)"
    [[ -n "$fields" ]] || return 0
    IFS=$'\t' read -r desc width height pos scale hz <<<"$fields"
    [[ "$1" == 60 ]] && blur=false
    hyprctl eval "hl.monitor({ output = '${desc}', mode = '${width}x${height}@${hz}', position = '${pos}', scale = ${scale} }); hl.config({ decoration = { blur = { enabled = ${blur} } } })" >/dev/null || true
}

ghostty_shader() {
    local shader=cursor_warp
    [[ "$1" == off ]] && shader=noop
    mkdir -p "${GHOSTTY_SHADER%/*}"
    ln -sfn "${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/shaders/$shader.glsl" "$GHOSTTY_SHADER"
}

ghostty_perf() {
    local anim=true opacity=0.80
    [[ "$1" == off ]] && { anim=false; opacity=1.0; }
    mkdir -p "${GHOSTTY_PERF%/*}"
    cat >"$GHOSTTY_PERF" <<EOF
# Managed by power-save. Do not edit.
# background-opacity<1: Ghostty wysyła bufor z alfą, dopiero wtedy Hyprland
# bluruje tło za oknem (przy 1.0 bufor jest nieprzeźroczysty i blur nie ma
# czego łapać — docs: background-blur na Linuksie tylko pod KDE).
custom-shader-animation = $anim
background-opacity = $opacity
background-blur = false
minimum-contrast = 1
EOF
}

# Ghostty shader animation + translucency cost GPU time, so they are on only
# on AC power and outside power-save mode. Returns 1 when nothing changed.
ghostty_candy() {
    local want=off
    if on_ac && ! is_active; then want=on; fi
    local anim=true
    [[ "$want" == off ]] && anim=false
    if [[ -e "$GHOSTTY_SHADER" ]] && grep -qx "custom-shader-animation = $anim" "$GHOSTTY_PERF" 2>/dev/null; then
        return 1
    fi
    ghostty_perf "$want"
    ghostty_shader "$want"
}

opencode_anims() {
    local json
    mkdir -p "${OPENCODE_KV%/*}"
    [[ -s "$OPENCODE_KV" ]] && json="$(<"$OPENCODE_KV")" || json='{}'
    jq --argjson v "$1" '.animations_enabled = $v' <<<"$json" >"$OPENCODE_KV"
}

enable_mode() {
    is_active && return 0
    touch "$STATE_FILE"

    if $with_brightness; then
        local cur
        cur="$(brightnessctl -c backlight get || true)"
        [[ -f "$PREV_BRIGHTNESS_FILE" || -z "$cur" ]] || echo "$cur" >"$PREV_BRIGHTNESS_FILE"
        bri --min-value=5 set 20%-
        report_brightness
    fi

    apply_display 60
    ghostty_candy || true
    opencode_anims false
    detach slow_tail power-saver
    detach restore_later
}

disable_mode() {
    is_active || return 0
    rm -f "$STATE_FILE"

    if $with_brightness; then
        local prev="" cur
        [[ -s "$PREV_BRIGHTNESS_FILE" ]] && prev="$(<"$PREV_BRIGHTNESS_FILE")"
        rm -f "$PREV_BRIGHTNESS_FILE"
        cur="$(brightnessctl -c backlight get || true)"
        if ((${prev:-0} > ${cur:-0})); then
            bri set "$prev"
        else
            bri set +20%
        fi
        report_brightness
    fi

    apply_display max
    ghostty_candy || true
    opencode_anims true
    detach slow_tail balanced
    detach restore_later
}

case "$action" in
status) if is_active; then echo on; else echo off; fi ;;
enable) enable_mode ;;
disable) disable_mode ;;
toggle) if is_active; then disable_mode; else enable_mode; fi ;;
reapply) if is_active; then apply_display 60; fi ;;
sync)
    # Called by power-save-watcher on every power supply change.
    if is_active && on_ac; then
        disable_mode
    elif ghostty_candy; then
        ghostty_reload
    fi
    ;;
esac

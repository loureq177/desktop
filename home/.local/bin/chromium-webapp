#!/usr/bin/env bash
set -euo pipefail

BROWSER="${1:-}"
APP_URL="${2:-}"
shift 2 || true

if [ -z "$BROWSER" ] || [ -z "$APP_URL" ]; then
    echo "Usage: chromium-webapp <browser> <app-url> [args...]" >&2
    exit 1
fi

# The browser's own profile, so links open as its tabs. The window is named after the
# URL's host (specials.lua matches it).
exec "$BROWSER" \
    --ozone-platform=wayland \
    --no-first-run \
    --no-default-browser-check \
    --app="$APP_URL" "$@"

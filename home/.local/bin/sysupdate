#!/usr/bin/env zsh
# Arch Linux system updater: pacman/AUR (paru), flatpaks, zinit, dev tools, and .pacnew review.
set -euo pipefail

step() {
    local msg=$1 tool=$2
    shift 2
    command -v "$tool" >/dev/null 2>&1 || return 0
    echo "\n==> $msg"
    "$@" || true
}

echo "==> Updating system & AUR packages..."
if command -v paru >/dev/null 2>&1; then
    paru -Syu --devel
fi

echo "\n==> Updating Zsh plugins (zinit)..."
zsh -ic "zinit self-update && zinit update --all" || true

if command -v fwupdmgr >/dev/null 2>&1; then
    echo "\n==> Checking firmware updates..."
    fwupdmgr refresh || true
    fwupdmgr update -y || true
fi

step "Updating Flatpak packages..." flatpak flatpak update -y

step "Updating tldr cache..." tldr tldr --update

if command -v uv >/dev/null 2>&1; then
    echo "\n==> Updating uv tools..."
    uv tool upgrade --all 2>/dev/null || true
fi

step "Updating Neovim plugins (LazyVim)..." nvim nvim --headless "+Lazy! sync" +qa

# Check for pacnew / pacsave files
if command -v pacdiff >/dev/null 2>&1; then
    echo "\n==> Checking and cleaning .pacnew / .pacsave files..."
    # 1. Automatically remove .pacnew files that are 100% identical to current
    yes s | DIFFPROG=true pacdiff -s >/dev/null 2>&1 || true

    # 2. Check if files with actual changes remain
    pacnew_files=$(pacdiff -o || true)
    if [ -n "$pacnew_files" ]; then
        echo "⚠️  Detected .pacnew/.pacsave files requiring attention:"
        echo "$pacnew_files"
        echo
        read -r "reply?Do you want to merge differences with pacdiff (nvim) now? [y/N] " || reply="n"
        if [[ "$reply" =~ ^[Yy]$ ]]; then
            DIFFPROG="nvim -d" pacdiff -s
        fi
    else
        echo "✓ No pending .pacnew files."
    fi
fi

# Check if reboot is recommended (kernel modules changed)
if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
    echo "\n⚠️  Running kernel ($(uname -r)) modules not found on disk. A reboot is recommended!"
fi

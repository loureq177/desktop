#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/lib/dotfiles/common.sh"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sysupdate"
mkdir -p "$STATE"
# All that the steps printed, for when the lines here are not enough.
TASKS_LOG="$STATE/last.log"
: >"$TASKS_LOG"
source "$HOME/.local/lib/dotfiles/tasks.sh"

# queue LABEL TOOL FUNCTION: a step, when TOOL is installed. The steps run at once
# (tasks.sh); a failing one does not stop the others.
queue() {
    command -v "$2" >/dev/null 2>&1 || return 0
    task "$1" "$3"
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send --app-name="System update" --icon="$1" --urgency="$2" "$3" "$4" || true
}

# What needs a look once it is all done, said again at the end.
attention=()

# "a, b and c".
listing() {
    local out="" i=0 x
    for x in "$@"; do
        i=$((i + 1))
        if ((i == 1)); then
            out=$x
        elif ((i == $#)); then
            out+=" and $x"
        else
            out+=", $x"
        fi
    done
    printf '%s' "$out"
}

# "a, b, c": a summary's details.
commas() {
    local IFS=,
    printf '%s' "$*" | sed 's/,/, /g'
}

# --- System packages ---------------------------------------------------------

# pacman's stages as the step's changing line (it prints a line per stage without a tty),
# keeping only warnings, errors and failing hooks.
pacman_stages() {
    local line stage="Syncing databases" shown="" hooks=0 count="" done_ops=0
    task_status "$stage"
    while IFS= read -r line || [[ -n "$line" ]]; do
        case $line in
        "" | "no new news" | " there is nothing to do" | ":: Synchronizing package databases..." | ":: Starting full system upgrade..." | \
            "resolving dependencies..." | "looking for conflicting packages..." | "checking dependencies..." | \
            ":: Proceed with installation? [Y/n]"* | " "*" is up to date" | \
            "Total Installed Size:"* | "Net Upgrade Size:"*) ;;
        " "*" downloading...")
            [[ -n "$count" ]] && stage="Downloading $count packages${PACMAN_SIZE:+, $PACMAN_SIZE}"
            ;;
        # Without a terminal pacman prints no line per package: this is the whole download.
        ":: Retrieving packages...")
            stage="Downloading${count:+ $count packages}${PACMAN_SIZE:+, $PACMAN_SIZE}"
            ;;
        "Packages ("*)
            count=${line#Packages (}
            count=${count%%)*}
            ;;
        "Total Download Size:"*)
            PACMAN_SIZE=${line#*:}
            PACMAN_SIZE=${PACMAN_SIZE#"${PACMAN_SIZE%%[![:space:]]*}"}
            ;;
        "checking keyring..." | "checking package integrity..." | "loading package files..." | \
            "checking for file conflicts..." | "checking available disk space...")
            stage="Checking packages"
            ;;
        ":: Processing package changes...") stage="Installing" ;;
        "upgrading "*... | "installing "*... | "removing "*... | "reinstalling "*... | "downgrading "*...)
            done_ops=$((done_ops + 1))
            stage="${line%...}${count:+ ($done_ops/$count)}"
            stage=${stage^}
            ;;
        ":: Running pre-transaction hooks..." | ":: Running post-transaction hooks...")
            hooks=1
            stage="Running hooks"
            ;;
        "("[0-9]*"/"[0-9]*") "*)
            if ((hooks)); then
                stage=${line#*) }
                stage=${stage%...}
            fi
            ;;
        *)
            # A hook's own output is noise unless something went wrong.
            if ! ((hooks)) || grep -qiE 'error|fail' <<<"$line"; then
                case $line in
                "warning: "*) printf '%s\n' "${line#warning: }" >>"$TASKS_DIR/pacman.warnings" ;;
                *) printf '%s\n' "${line#error: }" ;;
                esac
            fi
            ;;
        esac
        if [[ "$stage" != "$shown" ]]; then
            task_status "$stage"
            shown=$stage
        fi
    done
}

# What pacman changed since line $1 of its log: the count, then a package a line.
pacman_changes() {
    local from=$1 what=$2
    local -a lines
    mapfile -t lines < <(tail -n "+$((from + 1))" "$PACMAN_LOG" 2>/dev/null |
        sed -nE 's/.*\[ALPM\] (upgraded|installed|removed|downgraded|reinstalled) ([^ ]+) \((.*)\)$/\1\t\2\t\3/p')
    if ((${#lines[@]} == 0)); then
        _log_ok "Up to date${what:+ · $what}"
        return
    fi
    local -A counts=()
    local l verb name ver width=0
    for l in "${lines[@]}"; do
        IFS=$'\t' read -r verb name ver <<<"$l"
        counts[$verb]=$((${counts[$verb]:-0} + 1))
        ((${#name} > width)) && width=${#name}
    done
    local -a said=()
    for verb in upgraded installed downgraded reinstalled removed; do
        [[ -n "${counts[$verb]:-}" ]] && said+=("${counts[$verb]} $verb")
    done
    _log_ok "$(listing "${said[@]}" | sed 's/upgraded/updated/')${what:+ · $what}"
    # By name; three or more with the same start and the same change are one line.
    local -A size=() seen=()
    local key
    for l in "${lines[@]}"; do
        IFS=$'\t' read -r verb name ver <<<"$l"
        key="${name%%-*} $verb $ver"
        size[$key]=$((${size[$key]:-0} + 1))
    done
    local -a names=() vers=()
    local i
    width=0
    while IFS=$'\t' read -r verb name ver; do
        key="${name%%-*} $verb $ver"
        if ((size[$key] >= 3)); then
            [[ -z "${seen[$key]:-}" ]] || continue
            seen[$key]=1
            name+=" +$((size[$key] - 1))"
        fi
        ver=${ver// -> / → }
        [[ "$verb" == upgraded ]] || ver="$verb $ver"
        names+=("$name")
        vers+=("$ver")
        ((${#name} > width)) && width=${#name}
    done < <(printf '%s\n' "${lines[@]}" | sort -t $'\t' -k2,2)
    for i in "${!names[@]}"; do
        printf '    %-*s  %s%s%s\n' "$width" "${names[$i]}" "$_C_DIM" "${vers[$i]}" "$_C_NC"
    done
}

# --- AUR ---------------------------------------------------------------------

AUR_CLONES=${XDG_CACHE_HOME:-$HOME/.cache}/paru/clone

# Read, never sourced: the maintainers, the upstream and the hosts sources come from.
pkgbuild_facts() {
    local text=$1 url
    url=$(sed -nE 's/^url=["'\'']?([^"'\'' ]*).*/\1/p' <<<"$text" | head -n 1)
    printf '%s\n' "$(sed -nE 's/^#[[:space:]]*Maintainer:[[:space:]]*//p' <<<"$text" | sed -E 's/[[:space:]]*<[^>]*>//; s/[[:space:]]+$//' | paste -sd, | sed 's/,/, /g')"
    printf '%s\n' "$(sed -E 's#^(https?://)?(www\.)?##' <<<"$url")"
    grep -v -e '^[[:space:]]*#' -e '^url=' <<<"$text" | sed -e "s#\${url}#$url#g" -e "s#\$url#$url#g" |
        grep -oE '[a-z+]+://[^/"'\'' )]+' | sed -E 's#.*://##; s#^www\.##' | sort -u | paste -sd, | sed 's/,/, /g'
}

# "  label  now", and what it was when that changed.
aur_fact() {
    local label=$1 now=$2 was=$3
    if [[ -n "$was" && "$was" != "$now" ]]; then
        printf '      %-9s %s%s%s  %s(was %s)%s\n' "$label" "$_C_YELLOW" "${now:-none}" "$_C_NC" "$_C_DIM" "$was" "$_C_NC"
    else
        printf '      %-9s %s\n' "$label" "${now:-none}"
    fi
}

# Y on Enter; one key, no Enter needed.
ask_yes() {
    local key
    printf '    %s %s[Y/n]%s ' "$1" "$_C_DIM" "$_C_NC"
    read -rsn1 key || key=n
    if [[ -z "$key" || "$key" == [yY] ]]; then
        printf 'yes\n'
        return 0
    fi
    printf 'no\n'
    return 1
}

# Who and where for one package, against what was last built; the whole of it on request.
# Agreed to build: its clone remembers the version as seen (paru's AUR_SEEN).
aur_review() {
    local name=$1 old=$2 new=$3 base dir last="" head text was_text=""
    base=$(curl -fsS --max-time 10 "https://aur.archlinux.org/rpc/v5/info?arg[]=$name" 2>/dev/null | jq -r '.results[0].PackageBase // empty' 2>/dev/null || true)
    base=${base:-$name}
    dir=$AUR_CLONES/$base
    printf '    %s%s%s  %s%s → %s%s\n' "$_C_BOLD" "$name" "$_C_NC" "$_C_DIM" "$old" "$new" "$_C_NC"
    if [[ -d "$dir/.git" ]]; then
        git -C "$dir" fetch -q origin 2>/dev/null || true
    else
        mkdir -p "$AUR_CLONES"
        git clone -q "https://aur.archlinux.org/$base.git" "$dir" 2>/dev/null || true
    fi
    head=$(git -C "$dir" rev-parse -q --verify origin/HEAD 2>/dev/null || git -C "$dir" rev-parse -q --verify HEAD 2>/dev/null || true)
    if [[ -z "$head" ]]; then
        _log_warn "Could not fetch $base's build files"
        return 1
    fi
    [[ -f "$dir/.git/AUR_SEEN" ]] && last=$(git -C "$dir" rev-parse -q --verify "$(<"$dir/.git/AUR_SEEN")^{commit}" 2>/dev/null || true)
    text=$(git -C "$dir" show "$head:PKGBUILD" 2>/dev/null || true)
    [[ -n "$last" ]] && was_text=$(git -C "$dir" show "$last:PKGBUILD" 2>/dev/null || true)
    local -a now was=("" "" "")
    mapfile -t now < <(pkgbuild_facts "$text")
    [[ -n "$was_text" ]] && mapfile -t was < <(pkgbuild_facts "$was_text")
    aur_fact "by" "${now[0]}" "${was[0]}"
    aur_fact "upstream" "${now[1]}" "${was[1]}"
    aur_fact "sources" "${now[2]}" "${was[2]}"
    if [[ "$last" == "$head" ]]; then
        printf '      %sBuild files unchanged%s\n' "$_C_DIM" "$_C_NC"
    elif ask_yes "See $([[ -n "$last" ]] && echo "what changed" || echo "the build files")?"; then
        if [[ -n "$last" ]]; then
            git -C "$dir" -c color.ui=always diff -U100000 "$last" "$head" -- . ':!.SRCINFO' | less -R
        else
            git -C "$dir" ls-tree -r --name-only "$head" | grep -vx '.SRCINFO' | while read -r f; do
                printf '%s==> %s%s\n' "$_C_BOLD" "$f" "$_C_NC"
                git -C "$dir" show "$head:$f"
            done | less -R
        fi
        ask_yes "Build $name?" || return 1
    fi
    printf '%s\n' "$head" >"$dir/.git/AUR_SEEN"
    printf '\n'
}

# makepkg's and pacman's stages as the step's line; the rest kept for when it fails.
aur_stages() {
    local line stage="Fetching" shown="Fetching" pkg=""
    task_status "$stage"
    while IFS= read -r line || [[ -n "$line" ]]; do
        printf '%s\n' "$line" >>"$TASKS_DIR/aur.out"
        case $line in
        "==> Making package: "*)
            pkg=${line#==> Making package: }
            pkg=${pkg%% *}
            stage="Preparing $pkg"
            ;;
        "==> Retrieving sources..." | "  -> Downloading "*) stage="Downloading $pkg" ;;
        "==> Validating "*) stage="Verifying $pkg" ;;
        "==> Starting prepare()"*) stage="Preparing $pkg" ;;
        "==> Starting build()"*) stage="Building $pkg" ;;
        "==> Starting check()"*) stage="Testing $pkg" ;;
        "==> Starting package()"* | "==> Creating package"*) stage="Packaging $pkg" ;;
        "checking keyring..." | "checking package integrity..." | "loading package files..." | \
            "checking for file conflicts..." | "checking available disk space...") stage="Checking packages" ;;
        "upgrading "*... | "installing "*... | "reinstalling "*... | "downgrading "*...)
            stage="${line%...}"
            stage=${stage^}
            ;;
        ":: Running post-transaction hooks...") stage="Running hooks" ;;
        esac
        if [[ "$stage" != "$shown" ]]; then
            task_status "$stage"
            shown=$stage
        fi
    done
}

build_aur() {
    local rc
    echo 1 >"$TASKS_DIR/aur.exit"
    aur_stages < <({
        rc=0
        paru -S --skipreview --noconfirm "${aur_picked[@]}" 2>&1 || rc=$?
        echo "$rc" >"$TASKS_DIR/aur.exit"
    } | tee -a "$TASKS_LOG")
    rc=$(<"$TASKS_DIR/aur.exit")
    if [[ "$rc" != 0 ]]; then
        tail -n 15 "$TASKS_DIR/aur.out"
        return "$rc"
    fi
    pacman_changes "$aur_log_start" "" | head -n 1
}

# --- The steps ---------------------------------------------------------------

# The summary comes last, the packages stay for after the steps. pacman_stages reads in
# this shell, not in a pipe's: what it finds stays.
update_system() {
    local rc
    echo 1 >"$TASKS_DIR/pacman.exit"
    pacman_stages < <({
        rc=0
        if command -v paru >/dev/null 2>&1; then
            paru -Syu --repo --noconfirm 2>&1 || rc=$?
        else
            sudo pacman -Syu --noconfirm 2>&1 || rc=$?
        fi
        echo "$rc" >"$TASKS_DIR/pacman.exit"
    } | tee -a "$TASKS_LOG")
    rc=$(<"$TASKS_DIR/pacman.exit")
    if [[ "$rc" != 0 ]]; then
        return "$rc"
    fi
    pacman_changes "$pacman_log_start" "${PACMAN_SIZE:-}" >"$TASKS_DIR/pacman.changes"
    head -n 1 "$TASKS_DIR/pacman.changes"
}

# Building needs pacman's lock and you, so it comes after the steps; looking does not.
check_aur() {
    paru -Qua --devel >"$TASKS_DIR/aur" 2>/dev/null || true
    if [[ -s "$TASKS_DIR/aur" ]]; then
        local -a names
        mapfile -t names < <(awk '{ print $1 }' "$TASKS_DIR/aur")
        _log_ok "${#names[@]} to build · $(commas "${names[@]}")"
    else
        _log_ok "Up to date"
    fi
}

# Zinit and its plugins in parallel (10× faster); what changed comes from the plugins'
# commits. Own session: an interactive zsh grabs the terminal.
update_zsh_plugins() {
    local dir="${XDG_DATA_HOME:-$HOME/.local/share}/zinit" d
    local -A before=()
    for d in "$dir/zinit.git" "$dir/plugins/"*/; do
        d=${d%/}
        [[ -d "$d/.git" ]] && before[$d]=$(git -C "$d" rev-parse HEAD 2>/dev/null || true)
    done
    run_captured setsid -w zsh -ic "zinit self-update && zinit update --parallel" || return 1
    local -a updated=()
    for d in "${!before[@]}"; do
        [[ "$(git -C "$d" rev-parse HEAD 2>/dev/null || true)" == "${before[$d]}" ]] && continue
        d=${d##*/}
        d=${d%.git}
        updated+=("${d#*---}")
    done
    if ((${#updated[@]})); then
        _log_ok "${#updated[@]} updated · $(commas "${updated[@]}")"
    else
        _log_ok "Up to date"
    fi
}

# Lazy's sync log runs to hundreds of lines; the lockfile diff says what moved.
update_nvim_plugins() {
    local lock="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lazy-lock.json" old_lock="" new_lock=""
    local -a changed
    [ -f "$lock" ] && old_lock=$(<"$lock")
    run_captured nvim --headless "+Lazy! sync" +qa || return 1
    [ -f "$lock" ] || return 0
    new_lock=$(<"$lock")
    mapfile -t changed < <(diff <(printf '%s\n' "$old_lock") <(printf '%s\n' "$new_lock") | sed -nE 's/^> *"([^"]+)".*/\1/p' || true)
    if ((${#changed[@]})); then
        _log_ok "${#changed[@]} updated · $(commas "${changed[@]}")"
    else
        _log_ok "Up to date"
    fi
}

# Once a week is enough for votes; the stamp counts a run without the
# credentials too, so the hint comes weekly, not every time.
AUR_VOTES_STAMP="$STATE/aur-votes"
aur_votes_due() {
    [[ ! -f "$AUR_VOTES_STAMP" ]] || [[ -n "$(find "$AUR_VOTES_STAMP" -mtime +6 2>/dev/null)" ]]
}

sync_aur_votes() {
    if python3 -c "import keyring, sys; sys.exit(0 if keyring.get_credential('aur-sync-vote', None) else 1)" >/dev/null 2>&1; then
        run_captured aur-sync-vote || return 1
        printf '%s\n' "$OUT"
        touch "$AUR_VOTES_STAMP"
        _log_ok "Synced"
    else
        touch "$AUR_VOTES_STAMP"
        _log_warn "Off: 'aur-sync-vote --remember' turns it on"
    fi
}

# Only the check: installing may ask for a password (polkit), so it comes
# after the steps, in the terminal, when there is something to install.
check_firmware() {
    fwupdmgr refresh >/dev/null 2>&1 || true
    local rc=0
    fwupdmgr get-updates --no-unreported-check >/dev/null 2>&1 || rc=$?
    if [ "$rc" -eq 0 ]; then
        touch "$TASKS_DIR/firmware"
        _log_warn "Updates to install"
    else
        _log_ok "Up to date"
    fi
}

# What there is to update is asked first: the update itself does not say it
# plainly without a terminal.
update_flatpak() {
    local -a apps
    mapfile -t apps < <(flatpak remote-ls --updates --columns=name 2>/dev/null | sed '/^$/d' || true)
    run_captured flatpak update -y --noninteractive || return 1
    printf '%s\n' "$OUT"
    if ((${#apps[@]})); then
        _log_ok "${#apps[@]} updated · $(commas "${apps[@]}")"
    else
        _log_ok "Up to date"
    fi
}

update_tldr() {
    run_captured tldr --update || return 1
    printf '%s\n' "$OUT"
    _log_ok "Up to date"
}

# "Updated ruff v0.6.1 -> v0.6.2" for each tool that moved.
update_uv_tools() {
    run_captured uv tool upgrade --all || return 1
    printf '%s\n' "$OUT"
    local -a moved
    mapfile -t moved < <(sed -nE 's/^Updated ([^ ]+) v?([^ ]+) -> v?([^ ]+).*/\1 \2 → \3/p' <<<"$OUT")
    if ((${#moved[@]})); then
        _log_ok "${#moved[@]} updated · $(commas "${moved[@]}")"
    else
        _log_ok "Up to date"
    fi
}

# Merges what pacdiff can do alone, then lists what needs a human.
check_pacnew() {
    yes s | pacdiff -s >/dev/null 2>&1 || true
    local -a files
    mapfile -t files < <(pacdiff -o 2>/dev/null || true)
    ((${#files[@]})) || return 0
    local f
    for f in "${files[@]}"; do
        attention+=("$f to merge: DIFFPROG=\"nvim -d\" pacdiff -s")
    done
    notify dialog-warning normal "Pacnew files detected" "Configuration merge needed for:\n$(printf '%s\n' "${files[@]}")"
}

# What the update added to Hyprland's and Quickshell's APIs: new abilities, said once. The
# first run has nothing to compare with, and only remembers.
API_SEEN="$STATE/api"
API_NEWS="$STATE/api-news"
API_SHOWN=40
api_news() {
    command -v desktop-api >/dev/null 2>&1 || return 0
    local now added removed
    now=$(desktop-api) || return 0
    if [[ -f "$API_SEEN" ]]; then
        # C: the order desktop-api sorts in.
        added=$(LC_ALL=C comm -13 "$API_SEEN" <(printf '%s\n' "$now"))
        removed=$(LC_ALL=C comm -23 "$API_SEEN" <(printf '%s\n' "$now"))
        if [[ -n "$added$removed" ]]; then
            {
                [[ -z "$added" ]] || printf '%s\n' "$added"
                [[ -z "$removed" ]] || sed 's/^/gone: /' <<<"$removed"
            } >"$API_NEWS"
            _log_info "New in Hyprland and Quickshell"
            head -n "$API_SHOWN" "$API_NEWS" | sed 's/^/    /'
            local lines
            lines=$(wc -l <"$API_NEWS")
            ((lines <= API_SHOWN)) || printf '    %s… %d more in %s%s\n' "$_C_DIM" "$((lines - API_SHOWN))" "$API_NEWS" "$_C_NC"
        fi
    fi
    printf '%s\n' "$now" >"$API_SEEN"
}

# --- The run -----------------------------------------------------------------

PACMAN_LOG=${PACMAN_LOG:-/var/log/pacman.log}
# The password first, before any heading or spinner, and off the clock.
if [[ -t 0 ]]; then
    sudo -v || exit 1
fi
RUN_START=${EPOCHREALTIME/./}

pacman_log_start=0
if [ -f "$PACMAN_LOG" ]; then
    pacman_log_start=$(wc -l <"$PACMAN_LOG" 2>/dev/null || echo 0)
fi

task "System packages" update_system
queue "AUR" paru check_aur
queue "Flatpak apps" flatpak update_flatpak
queue "Firmware" fwupdmgr check_firmware
queue "tldr pages" tldr update_tldr
queue "Zsh plugins" zsh update_zsh_plugins
aur_votes_due && queue "AUR votes" aur-sync-vote sync_aur_votes
queue "uv tools" uv update_uv_tools
queue "Neovim plugins" nvim update_nvim_plugins

run_tasks "Update"

rc=$(<"$TASKS_DIR/pacman.exit")
if [[ -n "$(tail -n +2 "$TASKS_DIR/pacman.changes" 2>/dev/null)" ]]; then
    _log_info "System packages"
    tail -n +2 "$TASKS_DIR/pacman.changes"
fi
if [[ -f "$TASKS_DIR/pacman.warnings" ]]; then
    while IFS= read -r line; do
        _log_warn "$line"
    done <"$TASKS_DIR/pacman.warnings"
fi

# AUR build scripts run as this user and come from strangers: who wrote them and where they
# fetch from is shown, the rest on request, so this part needs a terminal.
if [[ "$rc" == 0 && -s "$TASKS_DIR/aur" ]]; then
    _log_info "AUR packages"
    if [[ -t 0 ]]; then
        aur_picked=()
        mapfile -t aur_lines <"$TASKS_DIR/aur"
        for l in "${aur_lines[@]}"; do
            read -r name old _ new <<<"$l"
            aur_review "$name" "$old" "$new" && aur_picked+=("$name")
        done
        if ((${#aur_picked[@]})); then
            sudo -v || exit 1
            aur_log_start=$(wc -l <"$PACMAN_LOG" 2>/dev/null || echo 0)
            task "AUR packages" build_aur
            run_tasks "Build"
        fi
    else
        _log_warn "Skipped: AUR updates are reviewed before they are built. Run 'sysupdate' in a terminal."
    fi
fi

if [ -f "$TASKS_DIR/firmware" ]; then
    _log_info "Firmware"
    fwupdmgr update -y || true
fi

command -v pacdiff >/dev/null 2>&1 && check_pacnew
api_news

reboot_reasons=()
if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
    reboot_reasons+=("the running kernel $(uname -r) is gone")
fi
if [ -f "$PACMAN_LOG" ] && [ "$pacman_log_start" -gt 0 ]; then
    upgraded_critical=$(tail -n "+$((pacman_log_start + 1))" "$PACMAN_LOG" 2>/dev/null |
        grep -E "\[ALPM\] upgraded (linux|linux-zen|linux-lts|linux-firmware|nvidia|nvidia-dkms|nvidia-open|nvidia-open-dkms|nvidia-utils|mesa|systemd|glibc|amd-ucode|intel-ucode) \(" |
        sed -E 's/.*upgraded ([^ ]+) .*/\1/' |
        sort -u |
        tr '\n' ' ' || true)
    if [ -n "$upgraded_critical" ]; then
        read -ra critical <<<"$upgraded_critical"
        # A kernel gone says linux already.
        [[ -d "/usr/lib/modules/$(uname -r)" ]] || mapfile -t critical < <(printf '%s\n' "${critical[@]}" | grep -vxE 'linux(-zen|-lts)?' || true)
        ((${#critical[@]} == 0)) || reboot_reasons+=("$(listing "${critical[@]}") updated")
    fi
fi
if ((${#reboot_reasons[@]})); then
    reason=${reboot_reasons[0]}
    for r in "${reboot_reasons[@]:1}"; do
        reason+="; $r"
    done
    attention+=("Restart: $reason")
    notify system-reboot critical "Reboot recommended" "$(printf '%s\n' "${reboot_reasons[@]}")"
else
    notify archlinux normal "Update complete" "System update completed successfully."
fi

if ((${#attention[@]})); then
    _log_info "Needs you"
    for a in "${attention[@]}"; do
        _log_warn "$a"
    done
fi

printf '\n'
if ((TASKS_FAILED)); then
    printf '%s✗ Updated in %s, %d step(s) failed%s\n' "$_C_RED$_C_BOLD" "$(_task_time $((${EPOCHREALTIME/./} - RUN_START)))" "$TASKS_FAILED" "$_C_NC"
else
    printf '%s%s\n' "$_C_BOLD" "$(_gradient "✓ Up to date · $(_task_time $((${EPOCHREALTIME/./} - RUN_START)))")"
fi

# In a window of its own (the launcher, the update notification) the summary
# stays until a key is pressed; from a shell there is nothing to wait for.
if [[ -t 0 ]] && ! [[ "$(ps -o comm= -p "$PPID" 2>/dev/null)" =~ ^(zsh|bash|fish|sh)$ ]]; then
    read -rsn1 -p $'\nPress any key to close.' || true
fi

exit "$rc"

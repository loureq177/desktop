#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/lib/dotfiles/common.sh"

# step MSG TOOL CMD...: run CMD under a heading when TOOL is installed; a
# failing step does not stop the others.
step() {
    local msg=$1 tool=$2
    shift 2
    command -v "$tool" >/dev/null 2>&1 || return 0
    _log_info "$msg"
    "$@" || true
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send --app-name="System Update" --icon="$1" --urgency="$2" "$3" "$4" || true
}

abort() {
    echo "operation aborted" >&2
    exit "$1"
}

# Zinit prints a line for every plugin it checks; real changes (git output)
# still come through, the checked ones are only counted.
update_zsh_plugins() {
    run_captured zsh -ic "zinit self-update && zinit update --all" || return 0
    local checked rest
    checked=$(grep -cE 'Updating [^ ]+/[^ ]+$' <<<"$OUT" || true)
    rest=$(grep -vE -e 'Updating [^ ]+/[^ ]+$' -e "can't change option" <<<"$OUT" || true)
    [ -z "$rest" ] || printf '%s\n' "$rest"
    [ "$checked" -eq 0 ] || _log_ok "Checked $checked plugins."
}

# Lazy's sync log runs to hundreds of lines; the lockfile diff says what moved.
update_nvim_plugins() {
    local lock="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lazy-lock.json" before="" after="" total changed
    [ -f "$lock" ] && before=$(<"$lock")
    run_captured nvim --headless "+Lazy! sync" +qa || return 0
    [ -f "$lock" ] || return 0
    after=$(<"$lock")
    total=$(grep -c '^ *"' <<<"$after" || true)
    changed=$(diff <(printf '%s\n' "$before") <(printf '%s\n' "$after") \
        | sed -nE 's/^> *"([^"]+)".*/\1/p' | paste -sd, - | sed 's/,/, /g' || true)
    if [ -n "$changed" ]; then
        _log_ok "Updated: $changed (checked $total plugins)."
    else
        _log_ok "Checked $total plugins, none updated."
    fi
}

sync_aur_votes() {
    if python3 -c "import keyring, sys; sys.exit(0 if keyring.get_credential('aur-sync-vote', None) else 1)" >/dev/null 2>&1; then
        aur-sync-vote
    else
        echo "Skipping vote sync: no saved AUR credentials."
        echo "Run 'aur-sync-vote --remember' once to enable it."
    fi
}

update_firmware() {
    fwupdmgr refresh || true
    fwupdmgr update -y
}

# Merges what pacdiff can do alone, then lists what needs a human.
check_pacnew() {
    yes s | pacdiff -s >/dev/null 2>&1 || true
    local pacnew_files
    pacnew_files=$(pacdiff -o 2>/dev/null || true)
    if [ -z "$pacnew_files" ]; then
        _log_ok "No pending .pacnew files."
        return
    fi
    _log_warn "Detected .pacnew/.pacsave files requiring attention:"
    echo "$pacnew_files"
    echo "Run 'DIFFPROG=\"nvim -d\" pacdiff -s' to review and merge."
    notify dialog-warning normal "Pacnew Files Detected" "Configuration merge needed for:\n$pacnew_files"
}

pacman_log_start=0
if [ -f /var/log/pacman.log ]; then
    pacman_log_start=$(wc -l < /var/log/pacman.log 2>/dev/null || echo 0)
fi

root=$(as_root)

_log_info "Updating system packages..."
if command -v paru >/dev/null 2>&1; then
    paru -Syu --repo --noconfirm --sudo "$root" || abort $?

    # AUR build scripts run as this user and come from strangers: paru shows
    # what changed and asks before building, so this part needs a terminal.
    _log_info "Updating AUR packages..."
    if [[ -z "$(paru -Qua --devel 2>/dev/null || true)" ]]; then
        _log_ok "Nothing to update."
    elif [[ -t 0 ]]; then
        paru -Sua --devel --sudo "$root" || abort $?
    else
        echo "Skipped: AUR updates are reviewed before they are built. Run 'sysupdate' in a terminal."
    fi
elif command -v pacman >/dev/null 2>&1; then
    "$root" pacman -Syu --noconfirm || abort $?
fi

_log_info "Updating Zsh plugins (zinit)..."
update_zsh_plugins

step "Syncing AUR votes..." aur-sync-vote sync_aur_votes
step "Checking firmware updates..." fwupdmgr update_firmware
step "Updating Flatpak packages..." flatpak flatpak update -y
step "Updating tldr cache..." tldr tldr --update
step "Updating uv tools..." uv uv tool upgrade --all
step "Updating Neovim plugins (LazyVim)..." nvim update_nvim_plugins
step "Checking and cleaning .pacnew / .pacsave files..." pacdiff check_pacnew

reboot_reasons=()

if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
    reboot_reasons+=("Running kernel ($(uname -r)) modules not found on disk")
fi

if [ -f /var/log/pacman.log ] && [ "$pacman_log_start" -gt 0 ]; then
    upgraded_critical=$(tail -n "+$((pacman_log_start + 1))" /var/log/pacman.log 2>/dev/null \
        | grep -E "\[ALPM\] upgraded (linux|linux-zen|linux-lts|linux-firmware|nvidia|nvidia-dkms|nvidia-open|nvidia-open-dkms|nvidia-utils|mesa|systemd|glibc|amd-ucode|intel-ucode) \(" \
        | sed -E 's/.*upgraded ([^ ]+) .*/\1/' \
        | sort -u \
        | tr '\n' ' ' || true)
    if [ -n "$upgraded_critical" ]; then
        reboot_reasons+=("Updated core packages: ${upgraded_critical% }")
    fi
fi

if ((${#reboot_reasons[@]})); then
    _log_warn "A system restart is recommended:"
    printf '   • %s\n' "${reboot_reasons[@]}"
    notify system-reboot critical "Reboot Recommended" "$(printf '%s\n' "${reboot_reasons[@]}")"
else
    _log_ok "System update complete. No reboot required."
    notify archlinux normal "Update Complete" "System update completed successfully."
fi

sleep 3

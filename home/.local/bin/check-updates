#!/usr/bin/env bash
# Checks for official, AUR, and .pacnew updates; sends a desktop notification with update action.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/check-updates"
STAMP="$STATE_DIR/last-check"
FORCE=0

for arg in "$@"; do
    case "$arg" in
        -f|--force) FORCE=1 ;;
    esac
done

# If run interactively in a terminal, always run and display output
if [[ -t 1 ]]; then
    FORCE=1
fi

NOW=$(date +%s)
# Cooldown for automated runs: at least 3 hours (10800s) between checks
COOLDOWN=10800

if (( !FORCE )) && [[ -f "$STAMP" ]]; then
    LAST_CHECK=$(<"$STAMP")
    if [[ "$LAST_CHECK" =~ ^[0-9]+$ ]] && (( NOW - LAST_CHECK < COOLDOWN )); then
        exit 0
    fi
fi

# Count updates
official_count=$(checkupdates 2>/dev/null | grep -c . || true)
aur_count=$(paru -Qum 2>/dev/null | grep -c . || true)
pacnew_count=$(pacdiff -o 2>/dev/null | grep -c . || true)
total=$((official_count + aur_count))

mkdir -p "$STATE_DIR"
printf '%s\n' "$NOW" >"$STAMP"

if [[ -t 1 ]]; then
    echo "Updates check completed: $official_count official, $aur_count AUR, $pacnew_count .pacnew (total: $total)"
fi

if (( total > 0 || pacnew_count > 0 )); then
    if (( total > 0 )); then
        summary="Available updates ($total)"
        body=$(printf 'Official packages: %s\nAUR packages: %s' "$official_count" "$aur_count")
        (( pacnew_count > 0 )) && body=$(printf '%s\n.pacnew files: %s' "$body" "$pacnew_count")
    else
        summary=".pacnew files detected ($pacnew_count)"
        body="System configuration merge required."
    fi
    body=$(printf '%s\n\nClick Update to start the upgrade.' "$body")

    gdbus call --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify \
        -- \
        "System Update" 0 "archlinux" \
        "$summary" "$body" \
        '["update", "Update system"]' \
        '{}' -1 >/dev/null 2>&1 || true
fi

#!/usr/bin/env bash
# Checks for official, AUR, and .pacnew updates; sends a desktop notification with update action.
set -euo pipefail

# Check if network is reachable. ICMP is blocked on plenty of networks, and a
# hardcoded echo host says nothing about the mirror checkupdates talks to, so
# probe the first pacman mirror instead: any HTTP response means online, while
# curl's 6/7/28 (no DNS / refused / timeout) mean offline.
if command -v curl >/dev/null 2>&1; then
    mirror="$(sed -n 's|^[[:space:]]*Server[[:space:]]*=[[:space:]]*||p' /etc/pacman.d/mirrorlist 2>/dev/null | head -n 1)"
    if [ -z "$mirror" ] || ! curl -sS -m 5 -o /dev/null "${mirror%%/\$repo*}/" >/dev/null 2>&1; then
        exit 0
    fi
fi

# Count official Arch updates
official_count=$(checkupdates 2>/dev/null | grep -c . || true)

# Count AUR updates via paru
aur_count=0
if command -v paru >/dev/null 2>&1; then
    aur_count=$(paru -Qum 2>/dev/null | grep -c . || true)
fi

pacnew_count=0
if command -v pacdiff >/dev/null 2>&1; then
    pacnew_count=$(pacdiff -o 2>/dev/null | grep -c . || true)
fi

total=$((official_count + aur_count))

if [ "$total" -gt 0 ] || [ "$pacnew_count" -gt 0 ]; then
    if [ "$total" -gt 0 ]; then
        summary="Available updates ($total)"
        body="Official packages: $official_count\nAUR packages: $aur_count"
        if [ "$pacnew_count" -gt 0 ]; then
            body="$body\n.pacnew files: $pacnew_count"
        fi
    else
        summary=".pacnew files detected ($pacnew_count)"
        body="System configuration merge required."
    fi
    body="$body\n\nClick the button below to update."

    action=$(notify-send \
        --app-name="System Update" \
        --icon="software-update-available" \
        --urgency=normal \
        -A "update=Update system" \
        "$summary" "$body" || true)

    if [ "$action" = "update" ]; then
        "${TERMINAL:-ghostty}" --class=sysupdate -e "$HOME/.local/bin/sysupdate" >/dev/null 2>&1 &
        disown || true
    fi
fi

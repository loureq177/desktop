#!/usr/bin/env bash
set -euo pipefail

# Check if network is reachable
if ! ping -q -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then
    exit 0
fi

# Count official Arch updates
official_count=$(checkupdates 2>/dev/null | wc -l || echo 0)

# Count AUR updates via paru
aur_count=0
if command -v paru >/dev/null 2>&1; then
    aur_count=$(paru -Qum 2>/dev/null | wc -l || echo 0)
fi

total=$((official_count + aur_count))

if [ "$total" -gt 0 ]; then
    summary="Dostępne aktualizacje ($total)"
    body="Pakiety oficjalne: $official_count\nPakiety AUR: $aur_count\n\nKliknij przycisk poniżej, aby zaktualizować."

    action=$(notify-send \
        --app-name="System Update" \
        --icon="software-update-available" \
        --urgency=normal \
        --action="update=Zaktualizuj system" \
        "$summary" "$body" 2>/dev/null || true)

    if [ "$action" = "update" ]; then
        ghostty --class=sysupdate -e "$HOME/.local/bin/sysupdate" &
    fi
fi

#!/usr/bin/env bash
set -euo pipefail

SRC="${XDG_CONFIG_HOME:-$HOME/.config}/firefox-defaults"
INIFILE="${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox/profiles.ini"

usage() {
    echo "usage: firefox-apply [--extensions]"
    echo "  --extensions   print AMO URLs from extensions.txt"
    exit 1
}

if [ $# -gt 0 ] && [ "$1" = "--extensions" ]; then
    [ -f "$SRC/extensions.txt" ] || { echo "firefox-apply: $SRC/extensions.txt not found" >&2; exit 1; }
    cat "$SRC/extensions.txt"
    exit 0
fi
[ $# -eq 0 ] || usage

[ -f "$SRC/user.js" ] || { echo "firefox-apply: $SRC/user.js not found" >&2; exit 1; }

[ -f "$INIFILE" ] || { echo "firefox-apply: $INIFILE not found" >&2; exit 1; }

SEL="$(awk '
    function val() { return substr($0, index($0, "=") + 1) }
    function save() {
        if (p_path == "") return
        if (first_path == "") { first_path = p_path; first_rel = p_rel }
        if (p_def) { flagged_path = p_path; flagged_rel = p_rel }
    }
    /^\[Install/  { save(); section = "install"; next }
    /^\[Profile/  { save(); section = "profile"; p_path = ""; p_rel = "1"; p_def = 0; next }
    /^\[/         { save(); section = ""; next }
    section == "install" && /^Default=/ { if (install_default == "") install_default = val(); next }
    section == "profile" && /^Path=/ { p_path = val(); next }
    section == "profile" && /^IsRelative=/ { p_rel = val(); next }
    section == "profile" && /^Default=/ { if (val() + 0 == 1) p_def = 1; next }
    END {
        save()
        if (install_default != "") { print "1\t" install_default }
        else if (flagged_path != "") { print flagged_rel "\t" flagged_path }
        else { print first_rel "\t" first_path }
    }
' "$INIFILE")"
ISREL="${SEL%%$'\t'*}"
PROFILE="${SEL#*$'\t'}"
[ -n "$PROFILE" ] || { echo "firefox-apply: no profile found in profiles.ini" >&2; exit 1; }

if [ "$ISREL" = "0" ]; then
    case "$PROFILE" in
        /*) PROFILE_CANDIDATE="$PROFILE" ;;
        *) echo "firefox-apply: IsRelative=0 but Path is not absolute: $PROFILE" >&2; exit 1 ;;
    esac
else
    case "$PROFILE" in
        ""|*/*|*..*) echo "firefox-apply: unsafe relative profile path: $PROFILE" >&2; exit 1 ;;
    esac
    PROFILE_CANDIDATE="${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox/$PROFILE"
fi

PROFILE_DIR="$(readlink -f "$PROFILE_CANDIDATE")" || { echo "firefox-apply: cannot resolve profile dir: $PROFILE_CANDIDATE" >&2; exit 1; }
[ -d "$PROFILE_DIR" ] || { echo "firefox-apply: profile dir not found: $PROFILE_DIR" >&2; exit 1; }

install -m 600 "$SRC/user.js" "$PROFILE_DIR/user.js"
echo "[OK] user.js -> $PROFILE_DIR"

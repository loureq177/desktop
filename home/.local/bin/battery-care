#!/usr/bin/env bash
set -euo pipefail

MARKER="$XDG_RUNTIME_DIR/battery_care"
DEST=org.freedesktop.UPower
IFACE=org.freedesktop.UPower.Device

action="${1:-toggle}"

exec 202>"$XDG_RUNTIME_DIR/battery_care.lock"
flock -w 2 202 || exit 0

dev="$(upower -e 2>/dev/null | grep -m1 '/battery_' || true)"

# "b true" -> "true"
prop() { busctl get-property --system "$DEST" "$dev" "$IFACE" "$1" 2>/dev/null | awk '{print $2}'; }

if [[ -z "$dev" || "$(prop ChargeThresholdSupported)" != true ]]; then
    rm -f "$MARKER"
    [[ "$action" == --sync ]] || echo "battery-care: this battery has no charge limit" >&2
    [[ "$action" == --sync ]]
    exit
fi

enabled="$(prop ChargeThresholdEnabled)"
if [[ "$action" == toggle ]]; then
    [[ "$enabled" == true ]] && want=false || want=true
    busctl call --system "$DEST" "$dev" "$IFACE" EnableChargeThreshold b "$want"
    enabled="$(prop ChargeThresholdEnabled)"
fi

if [[ "$enabled" == true ]]; then echo on >"$MARKER"; else echo off >"$MARKER"; fi

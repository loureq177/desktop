#!/usr/bin/env bash
set -euo pipefail

INHIBIT_PID_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/awake_inhibit.pid"
LOCK_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/awake_toggle.lock"

UNIT_NAME="awake-inhibit"

if [[ "${1:-}" != "--status" ]]; then
    exec 200>"$LOCK_FILE"
    flock -w 2 200 || exit 0
fi

_is_active() {
    if systemctl --user is-active --quiet "$UNIT_NAME.service" 2>/dev/null; then
        return 0
    fi
    if [[ -f "$INHIBIT_PID_FILE" ]]; then
        local pid=""
        pid="$(<"$INHIBIT_PID_FILE")"
        if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
            if tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q "sleep infinity"; then
                return 0
            fi
        fi
    fi
    return 1
}

if [[ "${1:-}" == "--status" ]]; then
    _is_active && echo "on" || echo "off"
    exit 0
fi

if _is_active; then
    systemctl --user stop "$UNIT_NAME.service" 2>/dev/null || true
    if [[ -f "$INHIBIT_PID_FILE" ]]; then
        pid="$(<"$INHIBIT_PID_FILE")"
        if [[ "$pid" =~ ^[0-9]+$ ]]; then
            kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
        fi
        rm -f "$INHIBIT_PID_FILE"
    fi
else
    systemd-run --user --unit="$UNIT_NAME" --collect \
        systemd-inhibit --what=idle:sleep:handle-lid-switch --who=awake \
        --why="Awake mode" --mode=block \
        sleep infinity >/dev/null 2>&1
    pid="$(systemctl --user show -p MainPID --value "$UNIT_NAME.service" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ && "$pid" != "0" ]]; then
        printf '%s\n' "$pid" >"$INHIBIT_PID_FILE"
    else
        rm -f "$INHIBIT_PID_FILE"
    fi
fi

qs ipc call quicksettings refresh >/dev/null 2>&1 || true

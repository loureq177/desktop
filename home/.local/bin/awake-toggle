#!/usr/bin/env bash
set -euo pipefail

UNIT="awake-inhibit.service"
PID_FILE="$XDG_RUNTIME_DIR/awake_inhibit.pid"

is_active() { systemctl --user is-active --quiet "$UNIT"; }

if [[ "${1:-}" == "--status" ]]; then
    if is_active; then echo on; else echo off; fi
    exit 0
fi

exec 200>"$XDG_RUNTIME_DIR/awake_toggle.lock"
flock -w 2 200 || exit 0

if is_active; then
    systemctl --user stop "$UNIT"
    rm -f "$PID_FILE"
else
    systemd-run --user --unit="${UNIT%.service}" --collect \
        systemd-inhibit --what=idle:sleep:handle-lid-switch --who=awake \
        --why="Awake mode" --mode=block \
        sleep infinity >/dev/null 2>&1
    systemctl --user show -p MainPID --value "$UNIT" >"$PID_FILE"
fi

qs ipc call quicksettings refresh >/dev/null 2>&1 || true

#!/usr/bin/env bash
# Forces kernel and Lenovo EC to re-sync panel backlight.
# The EC can silently dim the panel on dGPU D3cold power cuts without the
# kernel noticing. Re-writing the same level is a no-op for the driver, so
# step one unit away and back to make it resend the level to the EC.
set -euo pipefail

command -v brightnessctl >/dev/null 2>&1 || exit 0

_nudge() {
    local cur
    cur="$(brightnessctl -c backlight get 2>/dev/null || true)"
    [[ "$cur" =~ ^[0-9]+$ ]] || return 0
    brightnessctl -q -c backlight set "$((cur > 0 ? cur - 1 : 1))" >/dev/null 2>&1 || true
    brightnessctl -q -c backlight set "$cur" >/dev/null 2>&1 || true
}

_nudge
# The EC can finish its power-cut handling after the first nudge; reassert
# once it has settled.
(sleep 0.5 && _nudge) >/dev/null 2>&1 &

#!/usr/bin/env bash
set -euo pipefail

# Some laptop firmware (Lenovo Legion) dims the panel when the dGPU loses power
# (D3cold) or the power profile changes, without touching the brightness value.
# Writing the value again makes it take effect; the firmware needs a different
# value in between, and now and then a second try.

nudge() {
    local cur
    cur="$(brightnessctl -c backlight get)"
    brightnessctl -q -c backlight set "$((cur > 0 ? cur - 1 : 1))"
    brightnessctl -q -c backlight set "$cur"
}

nudge
sleep 0.5
nudge

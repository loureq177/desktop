#!/usr/bin/env bash
# Run by quickshell.service whenever the shell stops. quickshell is also the
# lock screen, and autologin counts on it: the session opens unlocked and the
# shell locks it as it starts. A shell that dies without having recorded an
# unlock (LockScreen.qml) leaves nothing holding the lock, so hyprlock takes
# over until the password is given.
set -uo pipefail

# A deliberate stop (systemctl stop, qs kill).
[[ "${SERVICE_RESULT:-success}" == success ]] && exit 0
# The session is going down, not the shell.
hyprctl -j monitors >/dev/null 2>&1 || exit 0

state="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/quickshell-lock-state"
[[ "$(cat "$state" 2>/dev/null)" == unlocked ]] && exit 0

logger -t quickshell "no shell to hold the lock, falling back to hyprlock"
if hyprlock; then
    mkdir -p "${state%/*}"
    echo unlocked >"$state"
else
    logger -p user.err -t quickshell "hyprlock failed as well: THE SESSION IS NOT LOCKED"
fi

#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

AUTO=0
if [[ "${1:-}" == "--auto" ]]; then
    AUTO=1
fi

section() {
    printf '\n%s\n' "$*"
}

skip_sudo() {
    echo "  (skipped in --auto: needs sudo)"
}

run_if() {
    command -v "$1" >/dev/null 2>&1 || return 0
    local tool=$1 rc=0
    shift
    timeout 120 "$@" </dev/null 2>/dev/null || rc=$?
    [ "$rc" -ne 124 ] || echo "  (skipped $tool - timed out)"
}

avail_bytes() {
    df -B1 --output=source,avail "$@" 2>/dev/null |
        awk 'NR>1 && !seen[$1]++ {sum+=$2} END {print sum+0}'
}

print_total() {
    local green=$'\033[1;32m' reset=$'\033[0m'
    local line="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    printf '\n%s%s\n  Total reclaimed space: %s\n%s%s\n' "$green" "$line" "$1" "$line" "$reset"
}

CLEAN_MOUNTS=()
for m in / /home /boot; do
    [ -e "$m" ] && CLEAN_MOUNTS+=("$m")
done
AVAIL_BEFORE=$(avail_bytes "${CLEAN_MOUNTS[@]}")

echo "Checking for orphaned packages..."
orphan_list=$(paru -Qdtq || true)
if [ -n "$orphan_list" ]; then
    if [ "$AUTO" = 1 ]; then
        echo "Orphans found (leaving them: removal needs sudo):"
        echo "$orphan_list"
    else
        mapfile -t orphans <<<"$orphan_list"
        echo "Removing: ${orphans[*]}"
        sudo pacman -Rns --noconfirm "${orphans[@]}"
    fi
else
    echo "No orphaned packages."
fi

section "Cleaning cached pacman packages..."
if [ "$AUTO" = 1 ]; then
    skip_sudo
elif command -v paccache >/dev/null 2>&1; then
    sudo paccache -r -k 2
    sudo paccache -r -u -k 0
fi

section "Cleaning Paru AUR cache..."
if [ -d "$HOME/.cache/paru" ]; then
    rm -rf "$HOME/.cache/paru/clone/"* "$HOME/.cache/paru/diff/"* 2>/dev/null || true
    if [ -d "$HOME/.cache/paru/pkg" ]; then
        paccache -r -k 2 -c "$HOME/.cache/paru/pkg" 2>/dev/null || true
        paccache -r -u -k 0 -c "$HOME/.cache/paru/pkg" 2>/dev/null || true
    fi
fi

if command -v flatpak >/dev/null 2>&1; then
    section "Cleaning Flatpak leftovers..."
    if [ "$AUTO" = 1 ]; then
        flatpak uninstall --user --unused -y 2>/dev/null || true
    else
        flatpak uninstall --unused -y 2>/dev/null || true
    fi
fi

section "Cleaning miscellaneous caches..."
rm -rf "$HOME/.cache/thumbnails/"* /tmp/paru/* 2>/dev/null || true

section "Emptying trash..."
if [ "$AUTO" = 1 ]; then
    echo "  (skipped in --auto: deletes user data)"
else
    run_if gio gio trash --empty
fi

section "Cleaning Python & Node caches..."
run_if uv uv cache prune
run_if pip pip cache purge
run_if bun bun pm cache rm
run_if npm npm cache clean --force

section "Pruning container engines..."
if [ "$AUTO" = 1 ]; then
    echo "  (skipped in --auto: deletes images)"
else
    # Images, stopped containers and build cache come back with a pull or a
    # build. Volumes hold data and do not: they stay.
    run_if podman podman system prune -a --force
    run_if docker docker system prune -a -f
    run_if docker docker builder prune -f
fi

section "Cleaning orphaned kernel modules..."
if [ "$AUTO" = 1 ]; then
    skip_sudo
else
    running_kernel=$(uname -r)
    for dir in /usr/lib/modules/*/; do
        dir="${dir%/}"
        [ -L "$dir" ] && continue
        ver="${dir##*/}"
        if [ "$ver" = "$running_kernel" ]; then
            echo "  Keeping $ver (running kernel)"
            continue
        fi
        if [ -e "$dir/modules.dep" ]; then
            pacman -Qo "$dir/modules.dep" &>/dev/null && continue
        fi
        pacman -Qo "$dir" &>/dev/null && continue
        echo "Removing orphaned modules directory: $dir"
        sudo rm -rf -- "${dir:?module dir unset}"
    done
fi

section "Vacuuming systemd coredumps..."
if [ "$AUTO" = 1 ]; then
    skip_sudo
elif [ -d /var/lib/systemd/coredump ]; then
    sudo sh -c 'rm -rf -- /var/lib/systemd/coredump/*' 2>/dev/null || true
fi

section "Vacuuming journal..."
if [ "$AUTO" = 1 ]; then
    skip_sudo
else
    sudo journalctl --vacuum-size=200M --vacuum-time=2weeks --quiet
fi

section "Checking for failed systemd services..."
failed_sys=$(systemctl --failed --no-legend --no-pager 2>/dev/null || true)
failed_user=$(systemctl --user --failed --no-legend --no-pager 2>/dev/null || true)

if [ -n "$failed_sys" ]; then
    echo "⚠️  Failed system services:"
    echo "$failed_sys"
fi
if [ -n "$failed_user" ]; then
    echo "⚠️  Failed user services:"
    echo "$failed_user"
fi
if [ -z "$failed_sys" ] && [ -z "$failed_user" ]; then
    echo "No failed services."
fi

section "System is clean."

AVAIL_AFTER=$(avail_bytes "${CLEAN_MOUNTS[@]}")
FREED_BYTES=$((AVAIL_AFTER - AVAIL_BEFORE))
if [ "$FREED_BYTES" -lt 0 ]; then FREED_BYTES=0; fi
print_total "$(numfmt --to=iec-i --suffix=B -- "$FREED_BYTES")"

#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

# Next to the script, not under $HOME: the --root run gets root's environment.
# Through ~/.local/bin, not the repo, which keeps the library in common/.
SELF="$(cd "$(dirname "$0")" && pwd)/${0##*/}"
source "${SELF%/*}/../lib/dotfiles/common.sh"

AUTO=0
ROOT=0
case "${1:-}" in
--auto) AUTO=1 ;;
--root) ROOT=1 ;;
esac

skip_sudo() {
    echo "  (skipped in --auto: needs sudo)"
}

# prune_paccache CMD... [-- EXTRA...]: keep two versions of every package and
# drop uninstalled ones, reporting only paccache's own "finished" verdicts.
prune_paccache() {
    local -a cmd=() extra=()
    local arg sep=0 mode out line found=0
    for arg in "$@"; do
        if [ "$arg" = -- ]; then
            sep=1
        elif [ "$sep" = 0 ]; then
            cmd+=("$arg")
        else
            extra+=("$arg")
        fi
    done
    for mode in "-r -k 2" "-r -u -k 0"; do
        # shellcheck disable=SC2086
        out=$("${cmd[@]}" $mode "${extra[@]}" 2>&1) || true
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            _log_ok "${line#finished: }"
            found=1
        done < <(grep -oE 'finished: .*' <<<"$out" || true)
    done
    [ "$found" = 1 ] || _log_ok "Nothing to remove."
}

avail_bytes() {
    df -B1 --output=source,avail "$@" 2>/dev/null |
        awk 'NR>1 && !seen[$1]++ {sum+=$2} END {print sum+0}'
}

# What needs root, run as `sysclean --root` (pkexec or sudo). It finds what to
# remove by itself: nothing it deletes comes from the caller.
root_steps() {
    _log_info "Checking for orphaned packages..."
    local -a orphans
    mapfile -t orphans < <(pacman -Qdtq || true)
    if [ "${#orphans[@]}" -gt 0 ]; then
        echo "Removing: ${orphans[*]}"
        pacman -Rns --noconfirm "${orphans[@]}"
    else
        _log_ok "No orphaned packages."
    fi

    _log_info "Cleaning cached pacman packages..."
    if command -v paccache >/dev/null 2>&1; then
        prune_paccache paccache
    fi

    _log_info "Cleaning orphaned kernel modules..."
    local running_kernel dir ver removed_modules=0
    running_kernel=$(uname -r)
    for dir in /usr/lib/modules/*/; do
        dir="${dir%/}"
        [ -L "$dir" ] && continue
        ver="${dir##*/}"
        if [ "$ver" = "$running_kernel" ]; then
            echo "  Keeping $ver (running kernel)"
            continue
        fi
        if [ -e "$dir/modules.dep" ]; then
            pacman -Qo "$dir/modules.dep" &>/dev/null && continue
        fi
        pacman -Qo "$dir" &>/dev/null && continue
        echo "Removing orphaned modules directory: $dir"
        rm -rf -- "${dir:?module dir unset}"
        removed_modules=1
    done
    [ "$removed_modules" = 1 ] || _log_ok "No orphaned modules."

    _log_info "Vacuuming systemd coredumps..."
    if [ -d /var/lib/systemd/coredump ]; then
        rm -rf -- /var/lib/systemd/coredump/*
        _log_ok "Coredumps removed."
    else
        _log_ok "No coredumps."
    fi

    _log_info "Vacuuming journal..."
    journalctl --vacuum-size=200M --vacuum-time=2weeks --quiet
    _log_ok "Journal trimmed to 200M / 2 weeks."
}

if [ "$ROOT" = 1 ]; then
    if [ "$(id -u)" != 0 ]; then
        _log_error "--root is how sysclean runs its root steps; run plain 'sysclean'."
        exit 2
    fi
    root_steps
    exit 0
fi

CLEAN_MOUNTS=()
for m in / /home /boot; do
    [ -e "$m" ] && CLEAN_MOUNTS+=("$m")
done
AVAIL_BEFORE=$(avail_bytes "${CLEAN_MOUNTS[@]}")

failed_services=0

if [ "$AUTO" = 1 ]; then
    _log_info "Checking for orphaned packages..."
    orphan_list=$(paru -Qdtq || true)
    if [ -n "$orphan_list" ]; then
        echo "Orphans found (leaving them: removal needs sudo):"
        echo "$orphan_list"
    else
        _log_ok "No orphaned packages."
    fi
    for step in "Cleaning cached pacman packages..." "Cleaning orphaned kernel modules..." \
        "Vacuuming systemd coredumps..." "Vacuuming journal..."; do
        _log_info "$step"
        skip_sudo
    done
else
    # All root steps run in one `sysclean --root`, so there is one prompt.
    "$(as_root)" "$SELF" --root || _log_warn "Root steps did not finish (exit $?); cleaning the rest."
fi

_log_info "Cleaning Paru AUR cache..."
if [ -d "$HOME/.cache/paru" ]; then
    rm -rf "$HOME/.cache/paru/clone/"* "$HOME/.cache/paru/diff/"* 2>/dev/null || true
    if [ -d "$HOME/.cache/paru/pkg" ]; then
        prune_paccache paccache -- -c "$HOME/.cache/paru/pkg"
    else
        _log_ok "Cleared."
    fi
else
    _log_ok "No Paru cache."
fi

if command -v flatpak >/dev/null 2>&1; then
    _log_info "Cleaning Flatpak leftovers..."
    if [ "$AUTO" = 1 ]; then
        flatpak uninstall --user --unused -y 2>/dev/null || true
    else
        flatpak uninstall --unused -y 2>/dev/null || true
    fi
fi

_log_info "Cleaning miscellaneous caches..."
rm -rf "$HOME/.cache/thumbnails/"* /tmp/paru/* 2>/dev/null || true
_log_ok "Thumbnails and temporary build files cleared."

_log_info "Emptying trash..."
if [ "$AUTO" = 1 ]; then
    echo "  (skipped in --auto: deletes user data)"
else
    run_if gio gio trash --empty
    _log_ok "Trash emptied."
fi

_log_info "Cleaning Python & Node caches..."
run_if uv uv cache prune
run_if pip pip cache purge
run_if bun bun pm cache rm
run_if npm npm cache clean --force
_log_ok "Caches pruned."

_log_info "Pruning container engines..."
if [ "$AUTO" = 1 ]; then
    echo "  (skipped in --auto: deletes images)"
else
    # Images, stopped containers and build cache come back with a pull or a
    # build. Volumes hold data and do not: they stay.
    run_if podman podman system prune -a --force
    run_if docker docker system prune -a -f
    run_if docker docker builder prune -f
    _log_ok "Unused images, stopped containers and build cache removed (volumes kept)."
fi

_log_info "Checking for failed systemd services..."
failed_sys=$(systemctl --failed --no-legend --no-pager 2>/dev/null || true)
failed_user=$(systemctl --user --failed --no-legend --no-pager 2>/dev/null || true)

if [ -n "$failed_sys" ]; then
    _log_warn "Failed system services:"
    echo "$failed_sys"
    failed_services=1
fi
if [ -n "$failed_user" ]; then
    _log_warn "Failed user services:"
    echo "$failed_user"
    failed_services=1
fi
if [ "$failed_services" = 0 ]; then
    _log_ok "No failed services."
    _log_info "System is clean."
else
    _log_info "Cleaned, but some services have failed (see above)."
fi

AVAIL_AFTER=$(avail_bytes "${CLEAN_MOUNTS[@]}")
FREED_BYTES=$((AVAIL_AFTER - AVAIL_BEFORE))
if [ "$FREED_BYTES" -lt 0 ]; then FREED_BYTES=0; fi
_log_total "$(numfmt --to=iec-i --suffix=B -- "$FREED_BYTES")"

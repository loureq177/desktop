#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

# Next to the script, not under $HOME: the --root run gets root's environment.
# Through ~/.local/bin, next to which stow links the library.
SELF="$(cd "$(dirname "$0")" && pwd)/${0##*/}"
source "${SELF%/*}/../lib/dotfiles/common.sh"

AUTO=0
ROOT=0
case "${1:-}" in
--auto) AUTO=1 ;;
--root) ROOT=1 ;;
esac

# Keeps two versions of each package and drops uninstalled ones; prints what was removed
# ("3 packages (124 MiB)"), or nothing.
prune_paccache() {
    local -a cmd=() extra=()
    local arg sep=0 mode out n=0 bytes=0 count size
    for arg in "$@"; do
        if [ "$arg" = -- ]; then
            sep=1
        elif [ "$sep" = 0 ]; then
            cmd+=("$arg")
        else
            extra+=("$arg")
        fi
    done
    for mode in "-r -k 2" "-r -u -k 0"; do
        # shellcheck disable=SC2086
        out=$("${cmd[@]}" $mode "${extra[@]}" 2>&1) || true
        # "finished: 3 packages removed (disk space saved: 124.4 MiB)"
        while read -r count size; do
            n=$((n + count))
            bytes=$((bytes + $(numfmt --from=iec-i <<<"${size// /}" 2>/dev/null || echo 0)))
        done < <(sed -nE 's/.*finished: ([0-9]+) packages? removed \(disk space saved: ([0-9.]+) ([KMGT]?i?)B\).*/\1 \2\3/p' <<<"$out")
    done
    ((n == 0)) || printf '%d packages (%s)' "$n" "$(numfmt --to=iec-i --suffix=B "$bytes")"
}

avail_bytes() {
    df -B1 --output=source,avail "$@" 2>/dev/null |
        awk 'NR>1 && !seen[$1]++ {sum+=$2} END {print sum+0}'
}

# The root steps (`sysclean --root` under sudo), finding what to remove by themselves;
# their last line is the step's summary.
root_steps() {
    local -a said=() orphans
    mapfile -t orphans < <(pacman -Qdtq || true)
    if [ "${#orphans[@]}" -gt 0 ]; then
        echo "Removing orphans: ${orphans[*]}"
        pacman -Rns --noconfirm "${orphans[@]}"
        said+=("${#orphans[@]} orphans")
    fi

    local cache
    if command -v paccache >/dev/null 2>&1; then
        cache=$(prune_paccache paccache)
        [ -z "$cache" ] || said+=("cache $cache")
    fi

    local running_kernel dir ver
    running_kernel=$(uname -r)
    for dir in /usr/lib/modules/*/; do
        dir="${dir%/}"
        [ -L "$dir" ] && continue
        ver="${dir##*/}"
        [ "$ver" = "$running_kernel" ] && continue
        if [ -e "$dir/modules.dep" ]; then
            pacman -Qo "$dir/modules.dep" &>/dev/null && continue
        fi
        pacman -Qo "$dir" &>/dev/null && continue
        echo "Removing orphaned modules directory: $dir"
        rm -rf -- "${dir:?module dir unset}"
        said+=("modules of $ver")
    done

    local dumps=(/var/lib/systemd/coredump/*)
    if ((${#dumps[@]})); then
        rm -rf -- "${dumps[@]}"
        said+=("${#dumps[@]} coredumps")
    fi

    local freed
    freed=$(journalctl --vacuum-size=200M --vacuum-time=2weeks 2>&1 | sed -nE 's/.*freed ([0-9.]+[KMGT]?) .*/\1/p' | tail -n 1)
    [[ -z "$freed" || "$freed" == 0B ]] || said+=("journal ${freed}B")

    if ((${#said[@]})); then
        _log_ok "Removed $(_join ", " "${said[@]}")"
    else
        _log_ok "Nothing to remove"
    fi
}

if [ "$ROOT" = 1 ]; then
    if [ "$(id -u)" != 0 ]; then
        _log_error "--root is how sysclean runs its root steps; run plain 'sysclean'."
        exit 2
    fi
    root_steps
    exit 0
fi

source "${SELF%/*}/../lib/dotfiles/tasks.sh"

# The root steps, in one `sysclean --root`: one password, asked before the
# steps start (they have no terminal to ask from).
clean_root() {
    if [ "$AUTO" = 1 ]; then
        local -a orphans
        mapfile -t orphans < <(pacman -Qdtq || true)
        if ((${#orphans[@]})); then
            printf '%s\n' "${orphans[@]}"
            _log_warn "Skipped (needs sudo); ${#orphans[@]} orphans: ${orphans[*]}"
        else
            _log_ok "Skipped (needs sudo)"
        fi
        return 0
    fi
    sudo -n "$SELF" --root
}

clean_paru() {
    if [ -d "$HOME/.cache/paru" ]; then
        rm -rf "$HOME/.cache/paru/clone/"* "$HOME/.cache/paru/diff/"* 2>/dev/null || true
        local pkgs=""
        [ -d "$HOME/.cache/paru/pkg" ] && pkgs=$(prune_paccache paccache -- -c "$HOME/.cache/paru/pkg")
        _log_ok "Build files cleared${pkgs:+, $pkgs}"
    else
        _log_ok "No Paru cache"
    fi
}

clean_flatpak() {
    local unused
    if [ "$AUTO" = 1 ]; then
        unused=$(flatpak uninstall --user --unused -y 2>&1 || true)
    else
        unused=$(flatpak uninstall --unused -y --noninteractive 2>&1 || true)
    fi
    printf '%s\n' "$unused"
    local removed
    removed=$(grep -cE '^ *[0-9]+\. ' <<<"$unused" || true)

    # Uninstalling an app leaves its ~/.var/app data behind. It can hold
    # saves, so it is only listed.
    local apps app dir
    local -a leftovers=()
    apps=$(flatpak list --app --columns=application 2>/dev/null) || return 0
    declare -A installed=()
    while IFS= read -r app; do
        [ -n "$app" ] && installed[$app]=1
    done <<<"$apps"
    for dir in "$HOME/.var/app/"*/; do
        dir="${dir%/}"
        [ -n "${installed[${dir##*/}]:-}" ] && continue
        leftovers+=("${dir/#$HOME/\~} ($(du -sh -- "$dir" 2>/dev/null | cut -f1))")
    done
    local runtimes="No unused runtimes"
    ((removed == 0)) || runtimes="$removed unused runtimes removed"
    if ((${#leftovers[@]})); then
        _log_warn "$runtimes; data of uninstalled apps left (remove by hand): $(_join ", " "${leftovers[@]}")"
    else
        _log_ok "$runtimes"
    fi
}

clean_misc() {
    # debuginfod_client: gdb's debug symbols. Its own expiry runs only with gdb.
    rm -rf "$HOME/.cache/thumbnails/"* "$HOME/.cache/debuginfod_client/"* /tmp/paru/* 2>/dev/null || true
    _log_ok "Thumbnails, debug symbols, build files"
}

clean_trash() {
    if [ "$AUTO" = 1 ]; then
        _log_ok "Skipped (--auto: it is your data)"
    else
        local n
        n=$(gio list trash:// 2>/dev/null | wc -l || echo 0)
        run_if gio gio trash --empty
        if ((n)); then _log_ok "Emptied ($n items)"; else _log_ok "Already empty"; fi
    fi
}

clean_dev_caches() {
    run_if uv uv cache prune
    run_if pip pip cache purge
    run_if bun bun pm cache rm
    run_if npm npm cache clean --force
    run_if pnpm pnpm store prune
    local -a tools=() t
    for t in uv pip bun npm pnpm; do
        command -v "$t" >/dev/null 2>&1 && tools+=("$t")
    done
    _log_ok "Pruned $(_join ", " "${tools[@]}")"
}

clean_containers() {
    if [ "$AUTO" = 1 ]; then
        _log_ok "Skipped (--auto: images take long to get back)"
    else
        # Images, stopped containers and build cache come back with a pull or a
        # build. Volumes hold data and do not: they stay.
        run_if podman podman system prune -a --force
        run_if docker docker system prune -a -f
        run_if docker docker builder prune -f
        _log_ok "Unused images and build cache (volumes kept)"
    fi
}

RUN_START=${EPOCHREALTIME/./}
CLEAN_MOUNTS=()
for m in / /home /boot; do
    [ -e "$m" ] && CLEAN_MOUNTS+=("$m")
done
AVAIL_BEFORE=$(avail_bytes "${CLEAN_MOUNTS[@]}")

if [ "$AUTO" = 1 ] || sudo -v; then
    task "System" clean_root
else
    _log_warn "No sudo: the root steps are skipped; cleaning the rest."
fi
task "Paru cache" clean_paru
command -v flatpak >/dev/null 2>&1 && task "Flatpak" clean_flatpak
task "Temporary files" clean_misc
task "Trash" clean_trash
task "Dev caches" clean_dev_caches
task "Containers" clean_containers
run_tasks "Cleaning up"

# Failed units are reset once shown, so the next run lists only new failures;
# --auto keeps them for a run someone reads.
attention=()
failed_sys=$(systemctl --failed --plain --no-legend --no-pager 2>/dev/null | awk '{print $1}' || true)
failed_user=$(systemctl --user --failed --plain --no-legend --no-pager 2>/dev/null | awk '{print $1}' || true)
if [ -n "$failed_sys$failed_user" ]; then
    for u in $failed_sys; do
        attention+=("$u failed: journalctl -b -u $u")
    done
    for u in $failed_user; do
        attention+=("$u failed: journalctl -b --user -u $u")
    done
    if [ "$AUTO" = 0 ]; then
        # shellcheck disable=SC2086
        [ -z "$failed_sys" ] || sudo systemctl reset-failed -- $failed_sys || true
        # shellcheck disable=SC2086
        [ -z "$failed_user" ] || systemctl --user reset-failed -- $failed_user || true
    fi
fi
if ((${#attention[@]})); then
    _log_info "Needs you"
    for a in "${attention[@]}"; do
        _log_warn "$a"
    done
fi

AVAIL_AFTER=$(avail_bytes "${CLEAN_MOUNTS[@]}")
FREED_BYTES=$((AVAIL_AFTER - AVAIL_BEFORE))
if [ "$FREED_BYTES" -lt 0 ]; then FREED_BYTES=0; fi
_log_total "$(numfmt --to=iec-i --suffix=B -- "$FREED_BYTES")" "$(_task_time $((${EPOCHREALTIME/./} - RUN_START)))"

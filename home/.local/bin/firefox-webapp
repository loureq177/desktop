#!/usr/bin/env bash
set -euo pipefail

APP_NAME="${1:-}"
APP_URL="${2:-}"
shift 2 || true

if [ -z "$APP_NAME" ] || [ -z "$APP_URL" ]; then
  echo "Usage: firefox-webapp <app-name> <app-url> [args...]" >&2
  exit 1
fi

if ! command -v firefox >/dev/null 2>&1; then
  echo "firefox-webapp: firefox not found in PATH" >&2
  exit 127
fi

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
PROFILE_DIR="$DATA_DIR/firefox-webapps"

mkdir -p "$PROFILE_DIR/chrome"

provision_if_changed() {
    local dest="$1"
    local tmp
    tmp=$(mktemp "$(dirname "$dest")/.provision.XXXXXX")
    cat >"$tmp"
    if ! cmp -s "$tmp" "$dest" 2>/dev/null; then
        mv -f "$tmp" "$dest"
    else
        rm -f "$tmp"
    fi
}

provision_if_changed "$PROFILE_DIR/chrome/userChrome.css" << 'EOF'
/* Clean standalone PWA app window */
#TabsToolbar,
#nav-bar,
#PersonalToolbar,
#toolbar-menubar,
#sidebar-box,
#sidebar-main {
    visibility: collapse !important;
}
EOF

provision_if_changed "$PROFILE_DIR/user.js" << 'EOF'
// Shared webapps profile settings
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);

// Window & Chrome
user_pref("browser.tabs.inTitlebar", 0);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.newtabpage.enabled", false);
user_pref("browser.aboutConfig.showWarning", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.rights.3.shown", true);
user_pref("browser.zoom.full", true);
user_pref("toolkit.zoomManager.zoomValues", ".3,.5,.67,.8,.9,1,1.1,1.2,1.33,1.5,1.7,2,2.4,3,4");

// Fast Rendering & Instant Paint
user_pref("nglayout.initialpaint.delay", 0);
user_pref("content.notify.interval", 100000);
user_pref("browser.startup.preXulSkeletonUI", false);

// Process & Memory Optimization
user_pref("dom.ipc.processCount", 2);
user_pref("media.webspeech.synth.enabled", false);
user_pref("accessibility.force_disabled", 1);

// Hardware Acceleration & Wayland
user_pref("gfx.webrender.all", true);
user_pref("layers.acceleration.force-enabled", true);
user_pref("widget.use-aspect-ratio", 1);

// Session & Disk I/O Optimization
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.max_resumed_crashes", 0);
user_pref("browser.sessionstore.interval", 3600000);

// App Features & Permissions
user_pref("dom.webnotifications.enabled", true);
user_pref("media.navigator.permission.disabled", false);

// Disable Telemetry & Background Bloat
user_pref("toolkit.telemetry.enabled", false);
user_pref("toolkit.telemetry.unified", false);
user_pref("experiments.enabled", false);
user_pref("experiments.supported", false);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("app.shield.optoutstudies.enabled", false);
user_pref("app.normandy.enabled", false);
EOF

if command -v sqlite3 >/dev/null 2>&1; then
    sqlite3 "$PROFILE_DIR/content-prefs.sqlite" << 'SQL' >/dev/null 2>&1 || true
CREATE TABLE IF NOT EXISTS groups (id INTEGER PRIMARY KEY, name TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS settings (id INTEGER PRIMARY KEY, name TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS prefs (id INTEGER PRIMARY KEY, groupID INTEGER REFERENCES groups(id), settingID INTEGER NOT NULL REFERENCES settings(id), value BLOB, timestamp INTEGER NOT NULL DEFAULT 0);
-- Neither name column is UNIQUE in Firefox's schema, so INSERT OR IGNORE
-- never ignores anything: guard with NOT EXISTS, and look the setting up by
-- name instead of assuming it got id 1.
INSERT INTO settings (name) SELECT 'browser.content.full-zoom'
WHERE NOT EXISTS (SELECT 1 FROM settings WHERE name = 'browser.content.full-zoom');
-- Collapse duplicate group rows left behind by older versions of this script.
DELETE FROM prefs WHERE groupID IN (SELECT id FROM groups WHERE id NOT IN (SELECT MIN(id) FROM groups GROUP BY name));
DELETE FROM groups WHERE id NOT IN (SELECT MIN(id) FROM groups GROUP BY name);
DELETE FROM prefs WHERE groupID IS NULL
  AND settingID IN (SELECT id FROM settings WHERE name = 'browser.content.full-zoom');
INSERT INTO prefs (groupID, settingID, value, timestamp)
SELECT NULL, MIN(id), 1.1, strftime('%s', 'now') FROM settings WHERE name = 'browser.content.full-zoom';
SQL

    if [[ "$APP_URL" =~ ^https?://([^/:]+) ]]; then
        domain="${BASH_REMATCH[1]}"
        domain="${domain//\'/\'\'}"
        sqlite3 "$PROFILE_DIR/content-prefs.sqlite" << SQL >/dev/null 2>&1 || true
INSERT INTO groups (name) SELECT '$domain'
WHERE NOT EXISTS (SELECT 1 FROM groups WHERE name = '$domain');
INSERT INTO prefs (groupID, settingID, value, timestamp)
SELECT g.id, s.id, 1.1, strftime('%s', 'now')
FROM groups g, settings s
WHERE g.name = '$domain' AND s.name = 'browser.content.full-zoom'
  AND NOT EXISTS (SELECT 1 FROM prefs p WHERE p.groupID = g.id AND p.settingID = s.id);
SQL
    fi
fi

exec env MOZ_APP_REMOTINGNAME="webapps" \
  firefox \
  --profile "$PROFILE_DIR" \
  --class="webapps" \
  --name="$APP_NAME" \
  --new-window "$APP_URL" "$@"

* {
    bg0: #0d1117;
    bg1: #161b22;
    bg2: #21262d;
    fg0: #c9d1d9;
    fg1: #8b949e;
    accent: #58a6ff;
    accent-alt: #3fb950;
    urgent: #f85149;
    border-color: #30363d;

    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
    spacing: 0;
    font: "JetBrainsMono Nerd Font Mono 13";
}

window {
    background-color: rgba(13, 17, 23, 0.95);
    border: 2px;
    border-color: @border-color;
    border-radius: 16px;
    width: 680px;
    location: center;
    anchor: center;
    yoffset: -150;
    fullscreen: false;
}

inputbar {
    padding: 16px 20px;
    background-color: rgba(22, 27, 34, 0.6);
    children: [prompt, entry];
    border: 0 0 1px 0;
    border-color: @border-color;
}

prompt {
    text-color: @accent;
    padding: 8px 12px 8px 0;
    font: "JetBrainsMono Nerd Font Mono Bold 14";
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg1;
    text-color: @fg0;
    font: "JetBrainsMono Nerd Font Mono Bold 14";
    padding: 8px 12px;
    background-color: @bg2;
    border-radius: 8px;
}

listview {
    padding: 12px 16px;
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: true;
    spacing: 4px;
}

element {
    padding: 10px 14px;
    border-radius: 8px;
    background-color: transparent;
}

element selected {
    background-color: rgba(56, 139, 253, 0.15);
    text-color: @accent;
    border: 1px;
    border-color: rgba(88, 166, 255, 0.4);
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font Mono 13";
}

element-icon {
    size: 1.8em;
    padding: 0 14px 0 0;
}

scrollbar {
    width: 4px;
    handle-color: @accent;
    handle-width: 4px;
    border: 0;
    padding: 0;
    margin: 0 0 0 4px;
}

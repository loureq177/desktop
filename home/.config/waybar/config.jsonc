{
  "layer": "top",
  "height": 30,
  "spacing": 8,
  "margin-top": 4,
  "margin-left": 20,
  "margin-right": 20,
  "margin-bottom": 4,

  "modules-left": [
    "hyprland/workspaces",
    "memory",
    "custom/dgpu",
    "custom/powersave",
  ],

  "modules-center": ["clock"],

  "modules-right": [
    "custom/record",
    "custom/notification",
    "privacy",
    "custom/caffeine",
    "bluetooth",
    "network",
    "battery",
  ],

  "privacy": {
    "icon-spacing": 3,
    "icon-size": 16,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24,
      },
    ],
  },

  "custom/record": {
    "exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\":\"●\",\"class\":\"recording\",\"tooltip\":\"Recording screen\\nClick to stop\"}' || echo '{\"text\":\"\",\"class\":\"idle\"}'",
    "return-type": "json",
    "interval": "once",
    "signal": 2,
    "on-click": "~/.config/hypr/scripts/record-screen.sh",
  },

  "custom/caffeine": {
    "exec": "~/.config/hypr/scripts/caffeine-toggle.sh --status",
    "on-click": "~/.config/hypr/scripts/caffeine-toggle.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 1,
  },

  "bluetooth": {
    "format": "<span size='120%'></span>",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}",
    "on-click": "hyprctl eval \"hl.dsp.workspace.toggle_special('bluetui')\"",
  },

  "network": {
    "format-wifi": "<span size='120%'>󰖩</span>",
    "format-ethernet": "<span size='120%'>󰈀</span>",
    "format-disconnected": "<span size='120%'>󰖪</span>",
    "tooltip-format": "{essid}\nIP: {ipaddr}\nSignal: {signalStrength}%",
    "on-click": "hyprctl eval \"hl.dsp.workspace.toggle_special('impala')\"",
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
  },

  "memory": {
    "format": "<span size='120%'>󰍛</span> {}%",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "Used: {used}/{total}\nAvail: {avail}",
    "on-click": "hyprctl eval \"hl.dsp.workspace.toggle_special('btop')\"",
  },

  "custom/dgpu": {
    "format": "<span size='120%'>{}</span>",
    "exec": "~/.config/waybar/scripts/nvidia-status.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
  },

  "battery": {
    "interval": 60,
    "format": "<span size='120%'>{icon}</span> {capacity}",
    "format-charging": "<span size='120%'>{icon}</span> {capacity}",
    "format-plugged": "<span size='120%'>{icon}</span> {capacity}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "{capacity}%\nRemaining time: {time}",
    "states": {
      "warning": 30,
      "critical": 10,
    },
    "on-click": "hyprctl eval \"hl.dsp.workspace.toggle_special('jolt')\"",
  },

  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d, %A}",
    "on-click": "hyprctl eval 'hl.dsp.workspace.toggle_special(\"calendar\")'",
  },

  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "none": "󰂜",
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true,
  },

  "custom/powersave": {
    "format": "<span size='120%'>{}</span>",
    "exec": "~/.config/hypr/scripts/power-save.sh --status",
    "on-click": "~/.config/hypr/scripts/power-save.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "tooltip": true,
  },
}

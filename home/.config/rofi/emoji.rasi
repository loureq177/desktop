@import "github-dark-default.rasi"

configuration {
    display-emoji: "󰞅 Emoji";
}

entry {
    placeholder: "Search emojis...";
}

listview {
    columns: 8;
    lines: 6;
    fixed-height: true;
    spacing: 8px;
    padding: 12px 16px;
}

element {
    padding: 11px 0px;
    border-radius: @element-radius;
    orientation: vertical;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "Noto Color Emoji 32, JetBrainsMono Nerd Font Mono 28";
}

element-icon {
    enabled: false;
}

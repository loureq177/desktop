configuration {
    terminal: "ghostty";
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun: " Apps";
    display-run: " Commands";
    display-window: " Windows";
    scroll-method: 1;
    disable-history: true;
    sort: true;
    sorting-method: "normal";
}
@theme "github-dark-default"

* {
    border-radius: 0px;
    element-radius: 0px;
    entry-radius: 0px;
    border-width: 2px;

    input-padding: 16px 20px;
    element-padding: 14px 10px;
    list-padding: 16px 20px;
    entry-padding: 8px 12px;

    font-main: "JetBrainsMono Nerd Font Mono 12";
    font-bold: "JetBrainsMono Nerd Font Mono Bold 13";

    bg0: #0d1117;
    bg1: #161b22;
    bg2: #21262d;
    fg0: #c9d1d9;
    fg1: #8b949e;
    accent: #58a6ff;
    accent-alt: #3fb950;
    urgent: #f85149;
    border-color: #30363d;

    bg-window: rgba(13, 17, 23, 0.95);
    bg-input: rgba(22, 27, 34, 0.6);
    selected-bg: rgba(88, 166, 255, 0.15);
    selected-border: rgba(88, 166, 255, 0.4);
}

@import "ui.rasi"

* {
    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
    spacing: 0;
    font: @font-main;
}

window {
    background-color: @bg-window;
    border: @border-width;
    border-color: @border-color;
    border-radius: @border-radius;
    width: 780px;
    location: center;
    anchor: center;
    yoffset: -60;
    fullscreen: false;
}

inputbar {
    padding: @input-padding;
    background-color: @bg-input;
    children: [prompt, entry];
    border: 0 0 1px 0;
    border-color: @border-color;
}

prompt {
    text-color: @accent;
    padding: 8px 12px 8px 0;
    font: @font-bold;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg1;
    text-color: @fg0;
    font: @font-bold;
    padding: @entry-padding;
    background-color: @bg2;
    border-radius: @entry-radius;
}

listview {
    padding: @list-padding;
    lines: 4;
    columns: 5;
    fixed-height: true;
    fixed-columns: true;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    flow: horizontal;
    spacing: 12px;
}

element {
    orientation: vertical;
    padding: @element-padding;
    border-radius: @element-radius;
    background-color: transparent;
    spacing: 8px;
}

element selected {
    background-color: @selected-bg;
    text-color: @accent;
    border: 1px;
    border-color: @selected-border;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    font: inherit;
}

element-icon {
    size: 48px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

scrollbar {
    width: 4px;
    handle-color: @accent;
    handle-width: 4px;
    border: 0;
    padding: 0;
    margin: 0 0 0 4px;
}

@import "ui.rasi"

* {
    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
    spacing: 0;
    font: @font-main;
}

window {
    background-color: rgba(13, 17, 23, 0.95);
    border: @border-width;
    border-color: @border-color;
    border-radius: @border-radius;
    width: 680px;
    location: center;
    anchor: center;
    yoffset: -150;
    fullscreen: false;
}

inputbar {
    padding: @input-padding;
    background-color: rgba(22, 27, 34, 0.6);
    children: [prompt, entry];
    border: 0 0 1px 0;
    border-color: @border-color;
}

prompt {
    text-color: @accent;
    padding: 8px 12px 8px 0;
    font: @font-bold;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg1;
    text-color: @fg0;
    font: @font-bold;
    padding: @entry-padding;
    background-color: @bg2;
    border-radius: @entry-radius;
}

listview {
    padding: @list-padding;
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: true;
    spacing: 4px;
}

element {
    padding: @element-padding;
    border-radius: @element-radius;
    background-color: transparent;
}

element selected {
    background-color: rgba(56, 139, 253, 0.15);
    text-color: @accent;
    border: 1px;
    border-color: rgba(88, 166, 255, 0.4);
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    font: inherit;
}

element-icon {
    size: 1.8em;
    padding: 0 14px 0 0;
}

scrollbar {
    width: 4px;
    handle-color: @accent;
    handle-width: 4px;
    border: 0;
    padding: 0;
    margin: 0 0 0 4px;
}

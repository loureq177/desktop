-- ~/.config/hypr/local.lua
-- Machine-specific configuration (GPU/DRM, monitors, device-specific binds/overrides).
-- This file is gitignored and stow-ignored. Copy to ~/.config/hypr/local.lua to use.

return {
	-- Hardware / GPU environment variables
	env = function()
		-- Example for hybrid graphics (AMD iGPU + NVIDIA dGPU on Lenovo Legion):
		-- Put the GPU driving the most latency-sensitive display first. For example,
		-- if an external monitor is physically wired to NVIDIA while the laptop
		-- panel is wired to AMD, prefer NVIDIA first to avoid cross-GPU copies on
		-- the external output (at the cost of more power use):
		-- hl.env("AQ_DRM_DEVICES", "/dev/dri/nvidia-dgpu:/dev/dri/amd-igpu")
		-- local vulkan_icd = "/usr/share/vulkan/icd.d/radeon_icd.json"
		-- hl.env("VK_DRIVER_FILES", vulkan_icd)
		-- hl.env("VK_ICD_FILENAMES", vulkan_icd)
		-- hl.env("LIBVA_DRIVER_NAME", "radeonsi")
	end,

	-- Monitor layout & refresh rates.
	-- NOTE (Oct 2026 post-mortem): do NOT hardcode the iiyama to
	-- `2560x1440@74`. The patched EDID's PREFERRED timing already IS 74Hz,
	-- so `preferred` resolves to 74Hz once the edid_override lands - and
	-- safely falls back to stock 60Hz during the hotplug race window.
	-- A hardcoded @74 before the override lands makes nvidia-modeset spin
	-- ("Error while waiting for GPU progress"), leak kmalloc-128 until OOM,
	-- and end in a DRM panic ("System is deadlocked on memory").
	-- If the override lands late (dGPU D3cold resume), `ensure-74hz`
	-- (autostarted from hyprland.lua) switches to the advertised 74Hz mode.
	-- iGPU-first (AQ_DRM_DEVICES below) is kept for battery life: note the
	-- external DP-1 is wired to NVIDIA, so each of its frames is copied
	-- AMD->NVIDIA. If frame drops persist after 74Hz locks in, the remaining
	-- lever is rendering on NVIDIA first (at the cost of idle power).
	monitors = function()
		-- Example: Laptop display + external monitor
		-- local laptop_output = "desc:BOE 0x0998"
		-- local external_output = "desc:iiyama Corporation PL2792Q 1152011401936"
		--
		-- hl.monitor({
		-- 	output = laptop_output,
		-- 	mode = "1920x1080@165",
		-- 	position = "320x1440",
		-- 	scale = 1,
		-- })
		-- hl.monitor({
		-- 	output = external_output,
		-- 	mode = "preferred", -- == 2560x1440@74 once the EDID override is active
		-- 	position = "0x0",
		-- 	scale = 1,
		-- })
	end,

	-- Set to true if you define custom Lid Switch handling in monitors()
	custom_lid_switch = false,
}

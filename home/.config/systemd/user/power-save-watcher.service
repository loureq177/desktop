[Unit]
Description=Sync power-save mode and Ghostty effects with the power source
PartOf=hyprland-session.target
After=hyprland-session.target
# Laptops only: a desktop has no power source to follow.
ConditionPathExistsGlob=/sys/class/power_supply/BAT*

[Service]
ExecStart=%h/.local/bin/power-save-watcher
Restart=on-failure
RestartSec=2

[Install]
WantedBy=hyprland-session.target

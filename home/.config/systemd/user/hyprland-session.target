[Unit]
Description=Hyprland compositor session
Documentation=https://wiki.hypr.land
BindsTo=graphical-session.target
# Session services hook themselves in with WantedBy= (install.sh enables them);
# the X11 socket is part of the session itself: hyprland.lua exports DISPLAY=:0.
Wants=graphical-session-pre.target xwayland-satellite.socket
After=graphical-session-pre.target
Before=graphical-session.target

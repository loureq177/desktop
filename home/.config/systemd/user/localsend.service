[Unit]
Description=LocalSend in the tray: files from the phone without opening it here
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
ExecStart=/usr/bin/localsend --hidden
# Closing its window quits it: back in the tray, hidden again.
Restart=always
RestartSec=2

[Install]
WantedBy=hyprland-session.target

[Unit]
Description=Real-time volume listener for QuickShell OSD and QuickSettings
PartOf=hyprland-session.target
After=hyprland-session.target pipewire.service wireplumber.service

[Service]
ExecStart=%h/.local/bin/volume-listener
Restart=always
RestartSec=1

[Install]
WantedBy=hyprland-session.target

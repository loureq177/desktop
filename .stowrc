--no-folding
--ignore=README\.md
--ignore=node_modules
--ignore=__pycache__
--ignore=\.pyc$
--ignore=\.venv
--ignore=\.zcompdump
--ignore=\.zsh_history
--ignore=\.zshrc\.local
--ignore=\.fzf\.zsh
--ignore=service\.json
--ignore=\.zwc$
--ignore=local\.lua
--ignore=config\.local
--ignore=backup\.conf
--ignore=\.ruff_cache
--ignore=(^|/)[.]env($|[.-].*)
--ignore=\.pub$
--ignore=(^|/)id_[^/]*
--ignore=known_hosts[^/]*


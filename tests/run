#!/usr/bin/env bash
# Runs the test suite.
#
#   tests/run                 everything
#   tests/run static          only tests/static.bats
#   tests/run -f 'hyprland'   only tests whose name matches the regex
#
# The tests read the repo and run nothing of it against the live session.
# Tests that need a tool which is not installed are skipped, not failed.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")" || exit 2

filter=()
bats_files=()
while (($#)); do
    case "$1" in
    -f | --filter)
        filter=(--filter "${2:?--filter needs a regex}")
        shift
        ;;
    -h | --help)
        sed -n '2,9s/^# \{0,1\}//p' "$(basename "${BASH_SOURCE[0]}")"
        exit 0
        ;;
    *)
        suite="${1#tests/}"
        suite="${suite%.bats}"
        if [[ ! -f "$suite.bats" ]]; then
            echo "tests/run: no such suite: $suite (have: $(printf '%s ' *.bats | sed 's/\.bats//g'))" >&2
            exit 2
        fi
        bats_files+=("$suite.bats")
        ;;
    esac
    shift
done
((${#bats_files[@]})) || bats_files=(*.bats)

if ! command -v bats >/dev/null; then
    echo "tests/run: bats is not installed (pacman -S bats / brew install bats-core)" >&2
    exit 2
fi

jobs=()
# Test files are independent; run them side by side when GNU parallel is there.
if command -v parallel >/dev/null && ((${#bats_files[@]} > 1)); then
    jobs=(--jobs "$(nproc 2>/dev/null || echo 4)" --no-parallelize-within-files)
fi

if bats "${jobs[@]}" "${filter[@]}" "${bats_files[@]}"; then
    echo "All tests passed."
else
    echo "FAILED: see the 'not ok' lines above." >&2
    exit 1
fi

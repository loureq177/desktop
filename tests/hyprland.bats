#!/usr/bin/env bats
# hyprland.lua: loads in Hyprland itself, and registers sane binds and autostart.

load helpers

setup() {
    export HOME="$BATS_TEST_TMPDIR/hypr-home"
    export XDG_RUNTIME_DIR="$BATS_TEST_TMPDIR/run"
    mkdir -p "$HOME/.config" "$HOME/.local" "$XDG_RUNTIME_DIR"
    cp -r "$REPO/archlinux/.config/hypr" "$HOME/.config/hypr"
    cp -r "$REPO/archlinux/.local/bin" "$HOME/.local/bin"
    # A fresh checkout has no machine-local overrides.
    rm -f "$HOME/.config/hypr/local.lua"
    RECORDS="$BATS_TEST_TMPDIR/records.tsv"
}

verify_config() {
    command -v Hyprland >/dev/null || skip "needs Hyprland"
    run timeout 30 Hyprland --verify-config --config "$HOME/.config/hypr/hyprland.lua"
    [[ "$output" == *"config ok"* ]] || fail "$output"
}

mock_run() {
    need lua
    lua "$BATS_TEST_DIRNAME/tools/hypr_mock.lua" >"$RECORDS"
}

# records KIND: the tab-separated fields after KIND.
records() { awk -F'\t' -v kind="$1" '$1 == kind { sub(/^[^\t]*\t/, ""); print }' "$RECORDS"; }

@test "hyprland accepts the config without machine-local overrides" {
    verify_config
}

@test "hyprland accepts the config with the example local.lua" {
    cp "$HOME/.config/hypr/local.lua.example" "$HOME/.config/hypr/local.lua"
    verify_config
}

@test "hyprland config survives a broken local.lua" {
    echo 'this is not lua {' >"$HOME/.config/hypr/local.lua"
    verify_config
}

@test "ui.lua provides every value hyprland.lua reads" {
    mock_run
    local missing
    missing="$(records UI | awk -F'\t' '$2 == "MISSING" { print "ui." $1 }')"
    [[ -z "$missing" ]] || fail "not generated by apply-ui:" "$missing"
    [[ "$(records UI | wc -l)" -gt 5 ]]
}

@test "no key combination is bound twice" {
    mock_run
    local dups
    dups="$(records BIND | cut -f1 | tr '[:lower:]' '[:upper:]' | tr -d ' ' | sort | uniq -d)"
    [[ -z "$dups" ]] || fail "bound more than once:" "$dups"
    [[ "$(records BIND | wc -l)" -gt 30 ]]
}

@test "every key bind has a description for the cheatsheet" {
    mock_run
    local undescribed
    undescribed="$(records BIND | awk -F'\t' '$1 !~ /^switch:/ && $2 == "" { print $1 }')"
    [[ -z "$undescribed" ]] || fail "no description:" "$undescribed"
}

@test "commands on key binds and at startup run programs that exist" {
    mock_run
    local cmd prog bad=0
    while IFS= read -r cmd; do
        prog="${cmd%% *}"
        case "$prog" in
        "~/.local/bin/"*)
            [[ -x "$HOME/.local/bin/${prog##*/}" ]] || { echo "missing script: $cmd" >&2; bad=1; }
            ;;
        */*) ;; # absolute system path, not ours to check
        *)
            # Installed here is a soft check; the package-list test covers the rest.
            command -v "$prog" >/dev/null || echo "note: '$prog' is not installed on this machine" >&3
            ;;
        esac
    done < <({ records BIND | cut -f4; records EXEC; } | grep -v '^$' | sort -u)
    [[ "$bad" -eq 0 ]]
}

@test "script key binds call the scripts with arguments they accept" {
    mock_run
    # A script that rejects its arguments exits 2 (usage); run each bind's
    # command in the sandbox with every external program stubbed out.
    sandbox_setup
    local tool
    for tool in qs wpctl canberra-gtk-play brightnessctl hyprctl slurp grim wl-copy notify-send hyprpicker pw-record; do
        stub "$tool"
    done
    stub wpctl 'echo "Volume: 0.40"'
    stub slurp 'exit 1'
    stub hyprpicker 'true'
    mkdir -p "$HOME/Pictures/Wallpapers" "$HOME/.local/share/whisper"
    : >"$HOME/Pictures/Wallpapers/a.png"
    echo model >"$HOME/.local/share/whisper/ggml-base.bin"

    local cmd bad=0 count=0
    while IFS= read -r cmd; do
        [[ "$cmd" == "~/.local/bin/"* ]] || continue
        count=$((count + 1))
        # shellcheck disable=SC2086
        sut $BIN/${cmd#"~/.local/bin/"}
        if [[ "$status" -ne 0 ]]; then
            echo "bind '$cmd' exits $status: $output" >&2
            bad=1
        fi
    done < <(records BIND | cut -f4 | grep -v '^$' | sort -u)
    if [[ -f "$XDG_RUNTIME_DIR/dictation.pid" ]]; then kill "$(<"$XDG_RUNTIME_DIR/dictation.pid")" 2>/dev/null || true; fi
    [[ "$count" -ge 5 ]] || fail "expected script binds, found $count"
    [[ "$bad" -eq 0 ]]
}

@test "the shell starts first, then the session target and the wallpaper" {
    mock_run
    [[ "$(records EXEC | head -n 1)" == "~/.local/bin/quickshell-session" ]] || fail "$(records EXEC)"
    records EXEC | grep -qF "systemctl --user restart hyprland-session.target"
    records EXEC | grep -qxF "~/.local/bin/wallpaper init"
}

@test "local.lua can add its own startup commands" {
    printf 'return { autostart = { "my-machine-only --flag" } }\n' >"$HOME/.config/hypr/local.lua"
    mock_run
    records EXEC | grep -qxF "my-machine-only --flag" || fail "$(records EXEC)"
    records EXEC | grep -qxF "~/.local/bin/wallpaper init"
}

@test "GTK settings at startup come from ui.lua" {
    mock_run
    local cursor
    cursor="$(lua -e "print(dofile('$HOME/.config/hypr/ui.lua').theme.cursor)")"
    records EXEC | grep -qxF "gsettings set org.gnome.desktop.interface cursor-theme '$cursor'" || fail "$(records EXEC)"
}

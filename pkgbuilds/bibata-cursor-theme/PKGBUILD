# Bibata from its author's releases.

pkgname=bibata-cursor-theme
pkgver=2.0.7
pkgrel=1
pkgdesc="Material based cursor theme"
arch=('any')
url="https://github.com/ful1e5/Bibata_Cursor"
license=('GPL-3.0-or-later')
conflicts=('bibata-cursor-git' 'bibata-cursor-theme-bin')
options=('!strip')
source=("$pkgname-$pkgver.tar.xz::$url/releases/download/v$pkgver/Bibata.tar.xz")
sha256sums=('172e33c4ae415278384dcecc7d1a9b7a024266bc944bc751fd86532be1cc6251')

# The newest release (sysupdate asks).
_latest() {
    curl -fsSI --max-time 15 -o /dev/null -w '%{redirect_url}' "$url/releases/latest" | sed -nE 's#.*/tag/v?##p'
}

package() {
    install -d "$pkgdir/usr/share/icons"
    cp -r Bibata-* "$pkgdir/usr/share/icons"
}

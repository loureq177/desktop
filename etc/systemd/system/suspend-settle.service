# The kernel moves to VT 63 as sleep begins and back on waking, as nvidia.ko requires: the panel
# can freeze on the frame it leaves, so the lock screen gets time to reach it, and VT 63 no cursor.
[Unit]
Description=Ready the screen for sleep: lock screen on the panel, no cursor on VT 63
Before=nvidia-suspend.service systemd-suspend.service

[Service]
Type=oneshot
ExecStart=/usr/bin/sh -c 'printf "\\033[?25l" > /dev/tty63'
ExecStart=/usr/bin/sleep 0.8

[Install]
WantedBy=systemd-suspend.service
